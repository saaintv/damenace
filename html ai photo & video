<!-- ========================= -->
<!-- MENACE AI LAB INTERFACE  -->
<!-- ADD THIS BELOW GALLERY   -->
<!-- ========================= -->

<section class="ai-lab">

    <h1 class="section-title">MENACE AI LAB</h1>

    <p class="ai-subtext">
        Generate dark visuals, campaign concepts, AI artwork, and cinematic videos.
    </p>

    <div class="ai-container">

        <!-- LEFT PANEL -->

        <div class="ai-controls">

            <label>Prompt</label>

            <textarea id="prompt"
            placeholder="Describe your vision...
Ex: A black woman with dreads standing in front of broken mirrors in a red grunge world"></textarea>

            <label>Generation Type</label>

            <select id="generationType">
                <option>AI Image</option>
                <option>AI Video</option>
            </select>

            <label>Style</label>

            <select id="styleType">
                <option>Grunge</option>
                <option>Cyberpunk</option>
                <option>Streetwear</option>
                <option>Y2K</option>
                <option>Dark Fantasy</option>
            </select>

            <button onclick="generateAI()">
                GENERATE
            </button>

        </div>

        <!-- RIGHT PANEL -->

        <div class="ai-preview">

            <div class="preview-box" id="previewBox">

                <h2>AI OUTPUT</h2>

                <p>
                    Your generated image or video preview appears here.
                </p>

            </div>

        </div>

    </div>

</section>

<style>

/* ========================= */
/* MENACE AI LAB             */
/* ========================= */

.ai-lab{
    padding:120px 8%;
    background:#050505;
}

.ai-subtext{
    text-align:center;
    color:#9f9f9f;
    margin-top:-30px;
    margin-bottom:60px;
    letter-spacing:1px;
}

.ai-container{
    display:grid;
    grid-template-columns:420px 1fr;
    gap:40px;
}

/* CONTROLS */

.ai-controls{
    background:#111;
    border:1px solid #222;
    padding:30px;
    display:flex;
    flex-direction:column;
    gap:20px;
}

.ai-controls label{
    font-size:0.9rem;
    text-transform:uppercase;
    letter-spacing:2px;
    color:#bbb;
}

.ai-controls textarea{
    width:100%;
    height:180px;
    background:#0a0a0a;
    border:1px solid #222;
    color:white;
    padding:15px;
    resize:none;
    font-family:inherit;
}

.ai-controls select{
    background:#0a0a0a;
    border:1px solid #222;
    color:white;
    padding:15px;
}

.ai-controls button{
    padding:18px;
    background:#ff1e1e;
    border:none;
    color:white;
    font-weight:bold;
    letter-spacing:2px;
    cursor:pointer;
    transition:0.3s;
}

.ai-controls button:hover{
    background:#ff3c3c;
    transform:translateY(-2px);
}

/* PREVIEW */

.ai-preview{
    background:#0c0c0c;
    border:1px solid #222;
    min-height:600px;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    position:relative;
}

.preview-box{
    text-align:center;
    padding:40px;
}

.preview-box h2{
    font-family:'Anton',sans-serif;
    font-size:3rem;
    letter-spacing:3px;
    margin-bottom:20px;
}

.preview-box p{
    color:#999;
}

.generated-image{
    width:100%;
    height:100%;
    object-fit:cover;
}

.generated-video{
    width:100%;
    height:100%;
    object-fit:cover;
}

/* LOADING EFFECT */

.loading{
    animation:pulseAI 1s infinite;
}

@keyframes pulseAI{
    0%{opacity:0.5;}
    50%{opacity:1;}
    100%{opacity:0.5;}
}

/* MOBILE */

@media(max-width:1000px){

    .ai-container{
        grid-template-columns:1fr;
    }

}

</style>

<script>

/* ================================= */
/* MENACE AI GENERATOR INTERFACE     */
/* ================================= */

async function generateAI(){

    const prompt = document.getElementById("prompt").value;
    const generationType =
    document.getElementById("generationType").value;

    const styleType =
    document.getElementById("styleType").value;

    const previewBox =
    document.getElementById("previewBox");

    previewBox.innerHTML = `
        <div class="loading">
            <h2>GENERATING...</h2>
            <p>MENACE AI is creating your vision.</p>
        </div>
    `;

    /* ========================================= */
    /* CONNECT TO AI IMAGE / VIDEO API HERE      */
    /* ========================================= */

    /*
        EXAMPLE APIS:

        OpenAI Images API
        Runway ML
        Stability AI
        Pika Labs
        Leonardo AI

        Replace YOUR_API_KEY below
    */

    try{

        /* =============================== */
        /* IMAGE GENERATION EXAMPLE        */
        /* =============================== */

        if(generationType === "AI Image"){

            const response = await fetch(
            "https://api.openai.com/v1/images/generations",
            {
                method:"POST",

                headers:{
                    "Content-Type":"application/json",

                    "Authorization":
                    "Bearer YOUR_API_KEY"
                },

                body:JSON.stringify({

                    model:"gpt-image-1",

                    prompt:
                    `${styleType} style:
                    ${prompt}`,

                    size:"1024x1024"
                })
            });

            const data = await response.json();

            const imageURL =
            data.data[0].url;

            previewBox.innerHTML = `
                <img
                src="${imageURL}"
                class="generated-image"/>
            `;
        }

        /* =============================== */
        /* VIDEO GENERATION EXAMPLE        */
        /* =============================== */

        else{

            /*
            Replace with your AI video API.
            Example providers:

            RunwayML
            Pika
            Stable Video Diffusion
            */

            previewBox.innerHTML = `
                <video
                class="generated-video"
                controls autoplay loop>

                    <source
                    src="your-video-url.mp4"
                    type="video/mp4">

                </video>
            `;
        }

    }

    catch(error){

        previewBox.innerHTML = `
            <h2>ERROR</h2>
            <p>
                AI generation failed.
                Check your API connection.
            </p>
        `;

        console.log(error);
    }

}

</script>
