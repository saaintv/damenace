============================================================
GITHUB ACTIONS DEPLOYMENT
============================================================

.github/workflows/deploy.yml

------------------------------------------------------------

name: Deploy

on:
  push:
    branches:
      - main

jobs:

  build-and-deploy:

    runs-on: ubuntu-latest

    steps:

      - uses: actions/checkout@v3

      - name: Install

        run: npm install

      - name: Build

        run: npm run build

      - name: Deploy

        run: npm run deploy

