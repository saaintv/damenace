/* ================================================================ */
/* CART                                                              */
/* ================================================================ */
let cart=[];
function openCart(){document.getElementById('cartDrawer').classList.add('open');document.getElementById('cartBackdrop').classList.add('open');renderCart();}
function closeCart(){document.getElementById('cartDrawer').classList.remove('open');document.getElementById('cartBackdrop').classList.remove('open');}

function addToCart(productId,size,colorHex,colorName,qty=1){
  const p=products.find(x=>x.id===productId);if(!p)return;
  const key=`${productId}-${size}-${colorHex}`;
  const existing=cart.find(i=>i.key===key);
  if(existing){existing.qty+=qty;}
  else{cart.push({key,productId,name:p.name,collection:p.collection,price:p.price,size,colorHex,colorName,qty,img:p.images?.[0]||''});}
  renderCart();
  showToast('🛍️',p.name+' added to cart');
  openCart();
}

function updateCartQty(key,delta){
  const item=cart.find(i=>i.key===key);if(!item)return;
  item.qty+=delta;if(item.qty<=0)cart=cart.filter(i=>i.key!==key);
  renderCart();
}

function removeCartItem(key){cart=cart.filter(i=>i.key!==key);renderCart();}

function renderCart(){
  const el=document.getElementById('cartItemsEl');
  const total=cart.reduce((s,i)=>s+i.qty,0);
  document.getElementById('cartCount').textContent=total;
  document.getElementById('cartHeaderMeta').textContent=total+' item'+(total!==1?'s':'');

  if(!cart.length){
    el.innerHTML=`<div class="cart-empty"><span class="cart-empty-icon">🛍</span><div class="cart-empty-text">Your cart is empty</div></div>`;
    document.getElementById('cartSummary').innerHTML='';return;
  }

  el.innerHTML=cart.map(item=>`
    <div class="cart-item">
      <img class="cart-item-img" src="${item.img||''}" alt="${item.name}" onerror="this.style.display='none'">
      <div class="cart-item-body">
        <div class="cart-item-collection">${item.collection}</div>
        <div class="cart-item-name">${item.name}</div>
        <div class="cart-item-variant">
          <span class="cart-variant-color" style="background:${item.colorHex}"></span>
          ${item.colorName} · ${item.size}
        </div>
        <div class="cart-item-controls">
          <div class="cart-qty">
            <button class="cart-qty-btn" onclick="updateCartQty('${item.key}',-1)">−</button>
            <input class="cart-qty-num" type="number" value="${item.qty}" min="1" onchange="setCartQty('${item.key}',this.value)" readonly>
            <button class="cart-qty-btn" onclick="updateCartQty('${item.key}',1)">+</button>
          </div>
          <div class="cart-item-price">$${(item.price*item.qty).toFixed(2)}</div>
          <button class="cart-remove" onclick="removeCartItem('${item.key}')">✕</button>
        </div>
      </div>
    </div>`).join('');

  const subtotal=cart.reduce((s,i)=>s+i.price*i.qty,0);
  const discounted=promo.discount?subtotal*(1-promo.discount):subtotal;
  document.getElementById('cartSummary').innerHTML=`
    <div class="cart-summary-row"><span>SUBTOTAL</span><span>$${subtotal.toFixed(2)}</span></div>
    ${promo.discount?`<div class="cart-summary-row" style="color:var(--gold);"><span>PROMO (${promo.code})</span><span>−$${(subtotal*promo.discount).toFixed(2)}</span></div>`:''}
    <div class="cart-summary-row"><span>SHIPPING</span><span>${subtotal>150?'FREE':'$9.95'}</span></div>
    <div class="cart-summary-row total"><span>TOTAL</span><span>$${(discounted+(subtotal<=150?9.95:0)).toFixed(2)}</span></div>`;
}

function applyPromo(){
  const code=document.getElementById('promoInput').value.trim().toUpperCase();
  const codes={MENACE20:{discount:.2,label:'20% off'},FEAR10:{discount:.1,label:'10% off'},CHAOS:{discount:.15,label:'15% off'}};
  if(codes[code]){promo={code,discount:codes[code].discount};renderCart();showToast('🎉',codes[code].label+' applied!');}
  else showToast('❌','Invalid promo code');
}

/* ================================================================ */
/* PRODUCT MODAL                                                     */
/* ================================================================ */
let modalState={selectedColor:null,selectedSize:null,qty:1,product:null};

function openProductModal(id){
  const p=products.find(x=>x.id===id);if(!p)return;
  modalState={selectedColor:p.colors?.[0]||null,selectedSize:null,qty:1,product:p};
  document.getElementById('productModal').classList.add('open');
  renderProductModal(p);
}

function closeProductModal(){document.getElementById('productModal').classList.remove('open');}
document.getElementById('productModal').addEventListener('click',e=>{if(e.target===e.currentTarget)closeProductModal();});

function renderProductModal(p){
  const totalStock=getTotalStock(p);
  const sizeStock=(size)=>p.stock?.[size]||0;

  document.getElementById('modalGallery').innerHTML=`
    ${p.images?.length?`<img class="modal-main-img" id="modalMainImg" src="${p.images[0]}" alt="${p.name}">`
    :`<div class="modal-img-placeholder"><svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>`}
    ${p.images?.length>1?`<div class="modal-thumbs">${p.images.slice(0,4).map((img,i)=>`<img class="modal-thumb ${i===0?'active':''}" src="${img}" onclick="switchModalImg('${img}',this)">`).join('')}</div>`:''}`;

  const stockClass=totalStock===0?'stock-out':totalStock<=10?'stock-low':'stock-ok';
  const stockLabel=totalStock===0?'SOLD OUT':totalStock<=10?`ONLY ${totalStock} LEFT`:`${totalStock} IN STOCK`;

  document.getElementById('modalInfo').innerHTML=`
    <div class="modal-collection">${p.collection}</div>
    <div class="modal-name">${p.name}</div>
    <div class="modal-price-row">
      <span class="modal-price">$${p.price}</span>
      ${p.originalPrice?`<span class="modal-price-orig">$${p.originalPrice}</span><span class="modal-price-save">SAVE $${p.originalPrice-p.price}</span>`:''}
    </div>
    <div class="modal-desc">${p.description}</div>

    ${p.colors?.length?`
    <div class="selector-label">COLOR <span id="selectedColorLabel">${p.colors[0]?.name||''}</span></div>
    <div class="color-palette">${p.colors.map((c,i)=>`
      <div class="color-swatch ${i===0?'selected':''}" style="background:${c.hex}" onclick="selectModalColor(this,'${c.hex}','${c.name}')" title="${c.name}">
        <div class="color-swatch-tooltip">${c.name}</div>
      </div>`).join('')}</div>`:''}

    <div class="selector-label">SIZE <span id="sizeGuideLink" style="color:var(--red);cursor:pointer;" onclick="showToast('📏','XS=0-2  S=4-6  M=8-10  L=12-14  XL=16-18  2X=20-22')">SIZE GUIDE</span></div>
    <div class="size-grid">${(p.sizes||SIZES).map(sz=>{
      const stock=sizeStock(sz);
      const disabled=stock===0;
      return`<div class="size-chip ${disabled?'size-disabled':''}" onclick="${disabled?'':'selectModalSize(this,\''+sz+'\')'}" data-size="${sz}" data-stock="${stock}">
        ${sz}<br><span style="font-size:.5rem;font-weight:400;opacity:.5;">${disabled?'—':stock<=3?stock+'left':''}</span>
      </div>`;}).join('')}</div>

    <div class="qty-row">
      <div class="qty-ctrl">
        <button class="qty-btn" onclick="changeModalQty(-1)">−</button>
        <input class="qty-num" id="modalQtyNum" type="number" value="1" min="1" max="10" readonly>
        <button class="qty-btn" onclick="changeModalQty(1)">+</button>
      </div>
      <span class="stock-indicator ${stockClass}">${stockLabel}</span>
    </div>

    <button class="modal-add-btn" id="modalAddBtn" ${totalStock===0?'disabled':''} onclick="modalAddToCart()">
      ${totalStock===0?'SOLD OUT':'ADD TO CART'}
    </button>
    <button class="btn btn-ghost" style="width:100%;padding:12px;" onclick="toggleWishlist(${p.id},this)">
      ${wishlist.has(p.id)?'♥ SAVED':'♡ SAVE TO WISHLIST'}
    </button>

    <div class="modal-details-accordion">
      ${p.materials?`<div class="accordion-item">
        <button class="accordion-trigger" onclick="toggleAccordion(this)">MATERIALS <span class="arrow">▾</span></button>
        <div class="accordion-body"><div class="accordion-content">${p.materials}</div></div>
      </div>`:''}
      <div class="accordion-item">
        <button class="accordion-trigger" onclick="toggleAccordion(this)">SIZE & FIT <span class="arrow">▾</span></button>
        <div class="accordion-body"><div class="accordion-content">This piece runs true to size. For an oversized fit, size up. Model wears size M. Measurements available on request.</div></div>
      </div>
      <div class="accordion-item">
        <button class="accordion-trigger" onclick="toggleAccordion(this)">SHIPPING & RETURNS <span class="arrow">▾</span></button>
        <div class="accordion-body"><div class="accordion-content">Free shipping on orders over $150. Standard delivery 3–7 business days. Returns accepted within 30 days of delivery — unworn with original tags.</div></div>
      </div>
    </div>`;
}

function switchModalImg(src,el){
  document.getElementById('modalMainImg').src=src;
  document.querySelectorAll('.modal-thumb').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
}

function selectModalColor(el,hex,name){
  document.querySelectorAll('.color-swatch').forEach(s=>s.classList.remove('selected'));
  el.classList.add('selected');
  modalState.selectedColor={hex,name};
  document.getElementById('selectedColorLabel').textContent=name;
}

function selectModalSize(el,size){
  document.querySelectorAll('.size-chip:not(.size-disabled)').forEach(s=>s.classList.remove('size-selected'));
  el.classList.add('size-selected');
  modalState.selectedSize=size;
}

function changeModalQty(delta){
  modalState.qty=Math.max(1,Math.min(10,modalState.qty+delta));
  document.getElementById('modalQtyNum').value=modalState.qty;
}

function modalAddToCart(){
  const p=modalState.product;
  if(!modalState.selectedSize){showToast('⚠️','Please select a size');return;}
  const color=modalState.selectedColor||p.colors?.[0]||{hex:'#111',name:'Default'};
  addToCart(p.id,modalState.selectedSize,color.hex,color.name,modalState.qty);
  closeProductModal();
}

function toggleAccordion(btn){
  btn.classList.toggle('open');
  btn.nextElementSibling.classList.toggle('open');
}

function toggleWishlist(id,btn){
  if(wishlist.has(id)){wishlist.delete(id);btn.textContent='♡ SAVE TO WISHLIST';showToast('💔','Removed from wishlist');}
  else{wishlist.add(id);btn.textContent='♥ SAVED';showToast('❤️','Saved to wishlist');}
}

/* ================================================================ */
/* SHOP RENDER                                                       */
/* ================================================================ */
function getTotalStock(p){
  if(!p.stock)return 0;
  return Object.values(p.stock).reduce((s,v)=>s+(v||0),0);
}

function getCollections(){
  const cols=['ALL',...new Set(products.map(p=>p.collection))];
  return cols;
}

function sortedProducts(list){
  const sorted=[...list];
  if(sortOrder==='price-asc')sorted.sort((a,b)=>a.price-b.price);
  else if(sortOrder==='price-desc')sorted.sort((a,b)=>b.price-a.price);
  else if(sortOrder==='name-asc')sorted.sort((a,b)=>a.name.localeCompare(b.name));
  else if(sortOrder==='newest')sorted.sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
  return sorted;
}

function filteredProducts(){
  return activeCollection==='ALL'?products:products.filter(p=>p.collection===activeCollection);
}

function setView(v){
  viewMode=v;
  const grid=document.getElementById('productsGrid');
  grid.classList.toggle('list-view',v==='list');
  document.getElementById('gridViewBtn').classList.toggle('active',v==='grid');
  document.getElementById('listViewBtn').classList.toggle('active',v==='list');
}

function sortProducts(v){sortOrder=v;renderShop();}

function renderShop(){
  // Collection tabs
  const tabs=document.getElementById('shopCollectionTabs');
  tabs.innerHTML=getCollections().map(c=>`<div class="coll-tab ${c===activeCollection?'active':''}" onclick="setCollection('${c}')">${c}</div>`).join('');

  const list=sortedProducts(filteredProducts());
  document.getElementById('resultsCount').textContent=list.length+' item'+(list.length!==1?'s':'');

  const empty=document.getElementById('emptyState');
  const grid=document.getElementById('productsGrid');

  if(!list.length){empty.style.display='block';grid.innerHTML='';return;}
  empty.style.display='none';

  grid.innerHTML=list.map(p=>{
    const stock=getTotalStock(p);
    const stockClass=stock===0?'stock-out':stock<=10?'stock-low':'stock-ok';
    const stockLabel=stock===0?'SOLD OUT':stock<=10?'LOW STOCK':'IN STOCK';
    const badgeHTML=p.badge?`<div class="product-badge badge-${p.badge}">${p.badge.toUpperCase()}</div>`:'';
    const wishHTML=`<div class="product-wishlist ${wishlist.has(p.id)?'saved':''}" onclick="event.stopPropagation();quickWishlist(${p.id},this)">${wishlist.has(p.id)?'♥':'♡'}</div>`;
    const colorsHTML=p.colors?.length?`<div class="product-quick-colors">${p.colors.slice(0,5).map((c,i)=>`<div class="quick-color ${i===0?'active-qc':''}" style="background:${c.hex}" title="${c.name}" onclick="event.stopPropagation()"></div>`).join('')}</div>`:'';

    return`<div class="product-card" onclick="openProductModal(${p.id})">
      <div class="product-img-wrap">
        ${p.images?.length?`<img src="${p.images[0]}" alt="${p.name}" loading="lazy">`:'<div style="width:100%;height:380px;background:var(--ink3);display:flex;align-items:center;justify-content:center;color:var(--text4);font-size:.7rem;letter-spacing:2px;">NO IMAGE</div>'}
        ${badgeHTML}${wishHTML}${colorsHTML}
      </div>
      <div class="product-body">
        <div class="product-collection">${p.collection}</div>
        <div class="product-name">${p.name}</div>
        <div class="product-desc-short">${p.description?.substring(0,90)}${p.description?.length>90?'…':''}</div>
        <div class="product-price-row">
          <span class="product-price">$${p.price}</span>
          ${p.originalPrice?`<span class="product-price-original">$${p.originalPrice}</span><span class="product-price-save">SAVE $${p.originalPrice-p.price}</span>`:''}
        </div>
        <div class="product-meta-row">
          <span class="product-stock-pill ${stockClass}">${stockLabel}</span>
          <span style="font-size:.6rem;color:var(--text4);letter-spacing:1px;">${p.colors?.length||0} color${p.colors?.length!==1?'s':''}</span>
        </div>
        <button class="product-add-btn" ${stock===0?'disabled':''} onclick="event.stopPropagation();openProductModal(${p.id})">${stock===0?'SOLD OUT':'SELECT OPTIONS'}</button>
      </div>
    </div>`;
  }).join('');
}

function setCollection(c){activeCollection=c;renderShop();}

function quickWishlist(id,el){
  if(wishlist.has(id)){wishlist.delete(id);el.textContent='♡';el.classList.remove('saved');showToast('💔','Removed from wishlist');}
  else{wishlist.add(id);el.textContent='♥';el.classList.add('saved');showToast('❤️','Saved to wishlist');}
}

/* ================================================================ */
/* COLLECTIONS PAGE                                                  */
/* ================================================================ */
function renderCollections(){
  const cols=[...new Set(products.map(p=>p.collection))];
  document.getElementById('collectionsGrid').innerHTML=cols.map(c=>{
    const items=products.filter(p=>p.collection===c);
    const img=items.find(p=>p.images?.length)?.images[0]||'';
    return`<div style="position:relative;overflow:hidden;cursor:pointer;height:420px;border:1px solid var(--border);background:var(--ink3);" onclick="setCollection('${c}');showPage('shop')">
      ${img?`<img src="${img}" style="width:100%;height:100%;object-fit:cover;transition:.6s;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">`:''}
      <div style="position:absolute;inset:0;background:linear-gradient(transparent 40%,rgba(5,3,5,.9));pointer-events:none;"></div>
      <div style="position:absolute;bottom:0;left:0;right:0;padding:28px;">
        <div style="font-size:.62rem;letter-spacing:4px;color:var(--red);text-transform:uppercase;margin-bottom:6px;">${items.length} PIECES</div>
        <div style="font-family:'Anton',sans-serif;font-size:1.8rem;letter-spacing:3px;">${c}</div>
      </div>
    </div>`;
  }).join('');
}

/* ================================================================ */
/* INVENTORY MANAGER                                                 */
/* ================================================================ */
function renderInvStats(){
  const totalProducts=products.length;
  const totalStock=products.reduce((s,p)=>s+getTotalStock(p),0);
  const lowStock=products.filter(p=>getTotalStock(p)<=10&&getTotalStock(p)>0).length;
  const soldOut=products.filter(p=>getTotalStock(p)===0).length;
  const totalValue=products.reduce((s,p)=>s+p.price*getTotalStock(p),0);
  const collections=[...new Set(products.map(p=>p.collection))].length;
  document.getElementById('invStats').innerHTML=`
    <div class="inv-stat"><div class="inv-stat-label">Total Products</div><div class="inv-stat-value">${totalProducts}</div></div>
    <div class="inv-stat"><div class="inv-stat-label">Total Stock</div><div class="inv-stat-value gold">${totalStock}</div></div>
    <div class="inv-stat"><div class="inv-stat-label">Low Stock</div><div class="inv-stat-value" style="color:var(--gold2);">${lowStock}</div></div>
    <div class="inv-stat"><div class="inv-stat-label">Sold Out</div><div class="inv-stat-value red">${soldOut}</div></div>
    <div class="inv-stat"><div class="inv-stat-label">Inventory Value</div><div class="inv-stat-value green">$${totalValue.toLocaleString()}</div></div>
    <div class="inv-stat"><div class="inv-stat-label">Collections</div><div class="inv-stat-value">${collections}</div></div>`;
}

let invFilter='';
function filterInventory(v){invFilter=v.toLowerCase();renderInventory();}

function renderInventory(){
  const list=products.filter(p=>!invFilter||p.name.toLowerCase().includes(invFilter)||p.collection.toLowerCase().includes(invFilter));
  document.getElementById('invTableBody').innerHTML=list.map(p=>{
    const stock=getTotalStock(p);
    const stockClass=stock===0?'stock-out':stock<=10?'stock-low':'stock-ok';
    return`<tr>
      <td>${p.images?.length?`<img class="product-mini-thumb" src="${p.images[0]}" alt="${p.name}">`:'<div class="product-mini-thumb" style="display:flex;align-items:center;justify-content:center;color:var(--text4);font-size:.5rem;">IMG</div>'}</td>
      <td><strong style="font-size:.82rem;">${p.name}</strong><br><span style="font-size:.62rem;color:var(--text3);">${p.category||'—'}</span></td>
      <td style="font-size:.72rem;color:var(--red);">${p.collection}</td>
      <td><strong>$${p.price}</strong>${p.originalPrice?`<br><span style="font-size:.62rem;color:var(--text4);text-decoration:line-through;">$${p.originalPrice}</span>`:''}</td>
      <td><div class="size-tags">${(p.sizes||[]).map(s=>`<span class="size-tag">${s}</span>`).join('')}</div></td>
      <td><div class="color-dots">${(p.colors||[]).map(c=>`<div class="color-dot" style="background:${c.hex}" title="${c.name}"></div>`).join('')}</div></td>
      <td><span class="product-stock-pill ${stockClass}">${stock}</span></td>
      <td><span style="font-size:.62rem;letter-spacing:1px;" class="${stockClass}">${stock===0?'SOLD OUT':stock<=10?'LOW':'IN STOCK'}</span></td>
      <td><div class="inv-actions">
        <button class="inv-action-btn" onclick="openEditProduct(${p.id})">EDIT</button>
        <button class="inv-action-btn" onclick="openProductModal(${p.id})">VIEW</button>
        <button class="inv-action-btn del" onclick="deleteProduct(${p.id})">DELETE</button>
      </div></td>
    </tr>`;
  }).join('');
}

function deleteProduct(id){
  if(!confirm('Delete this product?'))return;
  products=products.filter(p=>p.id!==id);
  renderInventory();renderInvStats();renderShop();
  showToast('🗑️','Product deleted');
}

/* ================================================================ */
/* ADD / EDIT PRODUCT FORM                                           */
/* ================================================================ */
function openAddProduct(){
  editingId=null;editFormColors=[];editFormImgs=[];
  document.getElementById('editModalTitle').textContent='ADD PRODUCT';
  document.getElementById('ef-name').value='';
  document.getElementById('ef-collection').value='';
  document.getElementById('ef-price').value='';
  document.getElementById('ef-origprice').value='';
  document.getElementById('ef-desc').value='';
  document.getElementById('ef-materials').value='';
  document.getElementById('ef-badge').value='';
  document.getElementById('ef-color-list').innerHTML='';
  document.getElementById('ef-img-previews').innerHTML='';
  document.querySelectorAll('#ef-sizes input').forEach(cb=>cb.checked=cb.value==='S'||cb.value==='M'||cb.value==='L'||cb.value==='XL');
  renderStockGrid([]);
  document.getElementById('editModal').classList.add('open');
}

function openEditProduct(id){
  const p=products.find(x=>x.id===id);if(!p)return;
  editingId=id;editFormColors=[...(p.colors||[])];editFormImgs=[...(p.images||[])];
  document.getElementById('editModalTitle').textContent='EDIT PRODUCT';
  document.getElementById('ef-name').value=p.name;
  document.getElementById('ef-collection').value=p.collection;
  document.getElementById('ef-price').value=p.price;
  document.getElementById('ef-origprice').value=p.originalPrice||'';
  document.getElementById('ef-desc').value=p.description||'';
  document.getElementById('ef-materials').value=p.materials||'';
  document.getElementById('ef-badge').value=p.badge||'';
  document.getElementById('ef-category').value=p.category||'Tops';
  document.querySelectorAll('#ef-sizes input').forEach(cb=>cb.checked=(p.sizes||[]).includes(cb.value));
  renderColorList();renderStockGrid(p.sizes||SIZES,p.stock);
  document.getElementById('ef-img-previews').innerHTML=editFormImgs.map(url=>`<img class="img-upload-preview" src="${url}">`).join('');
  document.getElementById('editModal').classList.add('open');
}

function closeEditModal(){document.getElementById('editModal').classList.remove('open');}

function addColorToBuilder(){
  const hex=document.getElementById('ef-color-picker').value;
  const name=document.getElementById('ef-color-name').value.trim()||'Custom';
  editFormColors.push({hex,name});
  renderColorList();
  document.getElementById('ef-color-name').value='';
}

function renderColorList(){
  document.getElementById('ef-color-list').innerHTML=editFormColors.map((c,i)=>`
    <div class="color-builder-item">
      <div class="color-builder-swatch" style="background:${c.hex}"></div>
      <span class="color-builder-name">${c.name}</span>
      <button class="color-builder-remove" onclick="removeBuilderColor(${i})">✕</button>
    </div>`).join('');
}

function removeBuilderColor(i){editFormColors.splice(i,1);renderColorList();}

function renderStockGrid(sizes,stock={}){
  const activeSizes=sizes.length?sizes:SIZES;
  document.getElementById('ef-stock-grid').innerHTML=activeSizes.map(s=>`
    <div class="stock-size-input">
      <label>${s}</label>
      <input type="number" id="ef-stock-${s}" value="${stock[s]||0}" min="0" placeholder="0">
    </div>`).join('');
}

// Update stock grid when sizes checkboxes change
document.getElementById('ef-sizes').addEventListener('change',()=>{
  const checked=Array.from(document.querySelectorAll('#ef-sizes input:checked')).map(cb=>cb.value);
  const existing={};
  checked.forEach(s=>{const el=document.getElementById('ef-stock-'+s);existing[s]=el?parseInt(el.value)||0:0;});
  renderStockGrid(checked,existing);
});

function handleFormImgs(input){
  Array.from(input.files).forEach(f=>{
    const r=new FileReader();
    r.onload=e=>{editFormImgs.push(e.target.result);renderFormImgPreviews();};
    r.readAsDataURL(f);
  });
  input.value='';
}

function handleFormImgDrop(e){
  e.preventDefault();e.currentTarget.style.borderColor='';
  Array.from(e.dataTransfer.files).filter(f=>f.type.startsWith('image/')).forEach(f=>{
    const r=new FileReader();
    r.onload=ev=>{editFormImgs.push(ev.target.result);renderFormImgPreviews();};
    r.readAsDataURL(f);
  });
}

function renderFormImgPreviews(){
  document.getElementById('ef-img-previews').innerHTML=editFormImgs.map(url=>`<img class="img-upload-preview" src="${url}">`).join('');
}

function saveProduct(){
  const name=document.getElementById('ef-name').value.trim();
  const collection=document.getElementById('ef-collection').value.trim();
  const price=parseFloat(document.getElementById('ef-price').value);
  const desc=document.getElementById('ef-desc').value.trim();
  if(!name||!collection||!price||!desc){showToast('⚠️','Fill in Name, Collection, Price and Description');return;}

  const origPrice=parseFloat(document.getElementById('ef-origprice').value)||null;
  const sizes=Array.from(document.querySelectorAll('#ef-sizes input:checked')).map(cb=>cb.value);
  const stock={};sizes.forEach(s=>{stock[s]=parseInt(document.getElementById('ef-stock-'+s)?.value)||0;});
  const badge=document.getElementById('ef-badge').value;
  const category=document.getElementById('ef-category').value;
  const materials=document.getElementById('ef-materials').value.trim();

  if(!sizes.length){showToast('⚠️','Select at least one size');return;}

  const productData={name,collection,price,originalPrice:origPrice,description:desc,materials,category,sizes,colors:editFormColors,stock,badge,images:editFormImgs,createdAt:Date.now()};

  if(editingId){
    const idx=products.findIndex(p=>p.id===editingId);
    if(idx!==-1)products[idx]={...products[idx],...productData};
    showToast('✅','Product updated');
  } else {
    products.push({id:nextId++,...productData});
    showToast('✅',name+' added to catalog');
  }

  closeEditModal();renderInventory();renderInvStats();renderShop();
}

/* ================================================================ */
/* FILE IMPORT                                                        */
/* ================================================================ */
function handleInvDrop(e){
  e.preventDefault();document.getElementById('invImportZone').classList.remove('drag');
  const file=Array.from(e.dataTransfer.files).find(f=>f.name.endsWith('.json')||f.type==='application/json');
  if(file)readJSONFile(file);else showToast('⚠️','Please drop a .json file');
}

function handleInvFileImport(input){
  if(input.files[0])readJSONFile(input.files[0]);
  input.value='';
}

function readJSONFile(file){
  const r=new FileReader();
  r.onload=e=>{
    try{
      let data=JSON.parse(e.target.result);
      if(!Array.isArray(data))data=[data];
      let added=0,updated=0;
      data.forEach(item=>{
        if(!item.name||!item.collection)return;
        // Merge stock if only ONE SIZE provided
        if(item.stock===undefined)item.stock={};
        if(typeof item.stock==='number'){const n=item.stock;item.stock={};(item.sizes||SIZES).forEach(s=>item.stock[s]=n);}
        if(!item.sizes||!item.sizes.length)item.sizes=Object.keys(item.stock).length?Object.keys(item.stock):SIZES;
        if(!item.colors||!item.colors.length)item.colors=[{name:'Default',hex:'#1a1a1a'}];
        if(!item.images)item.images=[];
        const existing=products.find(p=>p.name.toLowerCase()===item.name.toLowerCase()&&p.collection.toLowerCase()===item.collection.toLowerCase());
        if(existing){Object.assign(existing,{...item,id:existing.id});updated++;}
        else{products.push({id:nextId++,...item,createdAt:Date.now()});added++;}
      });
      renderInventory();renderInvStats();renderShop();
      showToast('📦',`Imported: ${added} added, ${updated} updated`);
    }catch(err){showToast('❌','Invalid JSON — check format guide above');}
  };
  r.readAsText(file);
}

function exportInventoryJSON(){
  const data=products.map(p=>{const{id:_,...rest}=p;return rest;});
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='menace-inventory.json';a.click();
  showToast('⬇️','Inventory exported as JSON');
}

/* ================================================================ */
/* INIT                                                               */
/* ================================================================ */
renderShop();
</script>
