<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MENACE 2 SOCIETY — SHOP</title>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,900;1,300;1,400&display=swap" rel="stylesheet">
<style>
/* ================================================================ */
/* DESIGN TOKENS                                                     */
/* ================================================================ */
:root{
  --ink:#050305;--ink2:#0b060d;--ink3:#130b16;--ink4:#1a0f1e;
  --surface:#1e1224;--surface2:#261730;--surface3:#2e1d38;
  --red:#d4001a;--red2:#f01428;--red3:#ff2438;
  --crimson:#8b0000;--crimson2:#6b0010;
  --gold:#c8922a;--gold2:#e0a83a;--gold3:#f5c84a;
  --text:#f2eaf5;--text2:#c4b0cc;--text3:#8a728e;--text4:#4a3650;
  --border:rgba(212,0,26,.14);--border2:rgba(212,0,26,.26);--border3:rgba(212,0,26,.42);
  --success:#1a7a3a;--warn:#8a5a00;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;font-size:15px;}
body{background:var(--ink);color:var(--text);font-family:'Montserrat',sans-serif;overflow-x:hidden;cursor:none;}

/* CUSTOM CURSOR */
.cursor{position:fixed;width:10px;height:10px;background:var(--red2);border-radius:50%;pointer-events:none;z-index:99999;transform:translate(-50%,-50%);transition:transform .08s,background .2s;}
.cursor-ring{position:fixed;width:32px;height:32px;border:1px solid rgba(212,0,26,.5);border-radius:50%;pointer-events:none;z-index:99998;transform:translate(-50%,-50%);transition:transform .18s,width .2s,height .2s;}
body:hover .cursor{background:var(--red2);}

/* SCROLLBAR */
::-webkit-scrollbar{width:3px;}
::-webkit-scrollbar-track{background:var(--ink2);}
::-webkit-scrollbar-thumb{background:var(--red);border-radius:2px;}

/* GRAIN OVERLAY */
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:9990;opacity:.5;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='.04'/%3E%3C/svg%3E");}

/* ================================================================ */
/* NAVIGATION                                                        */
/* ================================================================ */
nav{position:fixed;top:0;left:0;right:0;z-index:1000;height:64px;
  display:flex;align-items:center;justify-content:space-between;padding:0 5%;
  background:rgba(5,3,5,.88);backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);}
.nav-logo{font-family:'Anton',sans-serif;font-size:1.6rem;letter-spacing:5px;color:var(--text);}
.nav-logo span{color:var(--red2);}
.nav-links{display:flex;gap:0;}
.nav-link{padding:0 18px;height:64px;display:flex;align-items:center;font-size:.7rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);cursor:pointer;transition:.2s;border-bottom:2px solid transparent;white-space:nowrap;}
.nav-link:hover{color:var(--text);border-bottom-color:var(--red);}
.nav-link.active{color:var(--text);border-bottom-color:var(--red);}
.nav-right{display:flex;align-items:center;gap:10px;}
.nav-icon-btn{width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text3);font-size:1rem;transition:.2s;border:1px solid transparent;border-radius:2px;}
.nav-icon-btn:hover{color:var(--text);border-color:var(--border);}
.cart-trigger{position:relative;}
.cart-count{position:absolute;top:-2px;right:-2px;background:var(--red);color:white;width:16px;height:16px;border-radius:50%;font-size:.55rem;font-weight:700;display:flex;align-items:center;justify-content:center;}

/* ================================================================ */
/* PAGE SYSTEM                                                       */
/* ================================================================ */
.page{display:none;padding-top:64px;min-height:100vh;}
.page.active{display:block;}

/* ================================================================ */
/* HERO                                                              */
/* ================================================================ */
.hero{height:calc(100vh - 64px);display:flex;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;}
.hero-bg{position:absolute;inset:0;background:linear-gradient(135deg,var(--ink) 0%,#1a0520 50%,var(--ink) 100%);}
.hero-orb{position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;}
.hero-orb-1{width:500px;height:500px;background:rgba(212,0,26,.12);top:-100px;right:-100px;animation:orbDrift1 12s ease-in-out infinite;}
.hero-orb-2{width:350px;height:350px;background:rgba(200,146,42,.08);bottom:-80px;left:-80px;animation:orbDrift2 15s ease-in-out infinite;}
@keyframes orbDrift1{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(-40px,30px) scale(1.15);}}
@keyframes orbDrift2{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(30px,-20px) scale(1.2);}}
.hero-content{position:relative;z-index:2;padding:20px;}
.hero-eyebrow{font-size:.65rem;letter-spacing:7px;color:var(--red2);text-transform:uppercase;display:block;margin-bottom:22px;animation:fadeUp .8s .2s both;}
.hero-h1{font-family:'Anton',sans-serif;font-size:clamp(4rem,11vw,10rem);line-height:.88;letter-spacing:3px;text-transform:uppercase;animation:fadeUp .8s .3s both;}
.hero-h1 .accent{color:var(--red2);display:block;}
.hero-sub{margin-top:24px;font-size:.78rem;letter-spacing:4px;color:var(--text3);text-transform:uppercase;animation:fadeUp .8s .5s both;}
.hero-btns{margin-top:44px;display:flex;justify-content:center;gap:14px;flex-wrap:wrap;animation:fadeUp .8s .6s both;}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}

/* ================================================================ */
/* BUTTONS                                                           */
/* ================================================================ */
.btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 32px;font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:.25s;border:none;text-decoration:none;}
.btn-primary{background:var(--red);color:white;position:relative;overflow:hidden;}
.btn-primary::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 0%,rgba(255,255,255,.08) 50%,transparent 100%);transform:translateX(-100%);transition:.4s;}
.btn-primary:hover{background:var(--red2);}
.btn-primary:hover::before{transform:translateX(100%);}
.btn-ghost{background:transparent;color:var(--text);border:1px solid rgba(255,255,255,.18);}
.btn-ghost:hover{border-color:var(--red);color:var(--red2);}
.btn-gold{background:var(--gold);color:var(--ink);font-weight:900;}
.btn-gold:hover{background:var(--gold2);}
.btn-sm{padding:10px 20px;font-size:.65rem;letter-spacing:2px;}
.btn-xs{padding:7px 14px;font-size:.6rem;letter-spacing:1.5px;}

/* ================================================================ */
/* SECTION GLOBALS                                                   */
/* ================================================================ */
.section{padding:100px 5%;}
.section-alt{background:var(--ink2);}
.section-eyebrow{font-size:.62rem;letter-spacing:6px;color:var(--red);text-transform:uppercase;display:block;margin-bottom:10px;}
.section-title{font-family:'Anton',sans-serif;font-size:clamp(2.2rem,5vw,4rem);letter-spacing:4px;text-transform:uppercase;line-height:.95;margin-bottom:50px;}
.section-title span{color:var(--red2);}

/* ================================================================ */
/* SHOP TOOLBAR                                                      */
/* ================================================================ */
.shop-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:40px;flex-wrap:wrap;gap:16px;padding-bottom:22px;border-bottom:1px solid var(--border);}
.collection-tabs{display:flex;gap:0;overflow-x:auto;-ms-overflow-style:none;scrollbar-width:none;}
.collection-tabs::-webkit-scrollbar{display:none;}
.coll-tab{padding:10px 20px;font-size:.65rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text3);cursor:pointer;border-bottom:2px solid transparent;transition:.2s;white-space:nowrap;}
.coll-tab:hover{color:var(--text2);}
.coll-tab.active{color:var(--red2);border-bottom-color:var(--red);}
.shop-controls{display:flex;align-items:center;gap:10px;}
.sort-select{background:var(--ink3);border:1px solid var(--border);color:var(--text2);padding:9px 14px;font-family:'Montserrat',sans-serif;font-size:.68rem;letter-spacing:1px;cursor:pointer;}
.sort-select:focus{outline:none;border-color:var(--border3);}
.view-btns{display:flex;gap:4px;}
.view-btn{width:34px;height:34px;background:var(--ink3);border:1px solid var(--border);color:var(--text3);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.85rem;transition:.2s;}
.view-btn.active,.view-btn:hover{background:var(--red);border-color:var(--red);color:white;}
.results-count{font-size:.7rem;letter-spacing:2px;color:var(--text3);}

/* ================================================================ */
/* PRODUCT GRID                                                      */
/* ================================================================ */
.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2px;}
.products-grid.list-view{grid-template-columns:1fr;}

.product-card{background:var(--ink2);border:1px solid var(--border);overflow:hidden;cursor:pointer;transition:.3s;position:relative;display:flex;flex-direction:column;}
.product-card:hover{border-color:var(--border3);transform:translateY(-3px);z-index:2;}
.products-grid.list-view .product-card{flex-direction:row;max-height:220px;}

.product-img-wrap{position:relative;overflow:hidden;flex-shrink:0;}
.product-img-wrap img{width:100%;height:380px;object-fit:cover;display:block;transition:.6s;}
.products-grid.list-view .product-img-wrap img{width:180px;height:220px;}
.product-card:hover .product-img-wrap img{transform:scale(1.04);}

.product-badge{position:absolute;top:12px;left:12px;padding:3px 10px;font-size:.58rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;}
.badge-new{background:var(--gold);color:var(--ink);}
.badge-low{background:var(--warn);color:white;border:1px solid rgba(200,146,42,.4);}
.badge-sold{background:rgba(0,0,0,.7);color:var(--text3);border:1px solid rgba(255,255,255,.1);}
.badge-sale{background:var(--red);color:white;}

.product-quick-colors{position:absolute;bottom:12px;left:12px;display:flex;gap:5px;opacity:0;transform:translateY(6px);transition:.25s;}
.product-card:hover .product-quick-colors{opacity:1;transform:translateY(0);}
.quick-color{width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.3);cursor:pointer;transition:.15s;}
.quick-color:hover{transform:scale(1.3);border-color:white;}
.quick-color.active-qc{border-color:white;transform:scale(1.2);}

.product-wishlist{position:absolute;top:12px;right:12px;width:34px;height:34px;background:rgba(5,3,5,.7);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;transition:.2s;font-size:.9rem;backdrop-filter:blur(4px);}
.product-card:hover .product-wishlist{opacity:1;}
.product-wishlist.saved{opacity:1;color:var(--red2);border-color:var(--red);}

.product-body{padding:20px 22px 22px;flex:1;display:flex;flex-direction:column;gap:6px;}
.products-grid.list-view .product-body{padding:22px 26px;}
.product-collection{font-size:.6rem;letter-spacing:3px;color:var(--red);text-transform:uppercase;}
.product-name{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:2px;line-height:1.1;color:var(--text);}
.product-desc-short{font-size:.72rem;color:var(--text3);line-height:1.6;flex:1;}
.product-price-row{display:flex;align-items:baseline;gap:10px;margin-top:4px;}
.product-price{font-family:'Anton',sans-serif;font-size:1.3rem;color:var(--text);}
.product-price-original{font-size:.85rem;color:var(--text4);text-decoration:line-through;}
.product-price-save{font-size:.62rem;font-weight:700;color:var(--gold);letter-spacing:1px;}

.product-meta-row{display:flex;align-items:center;justify-content:space-between;margin-top:8px;}
.product-stock-pill{padding:2px 8px;font-size:.58rem;letter-spacing:2px;font-weight:700;border-radius:1px;}
.stock-ok{background:rgba(26,122,58,.15);color:#3adf7a;border:1px solid rgba(26,122,58,.3);}
.stock-low{background:rgba(138,90,0,.15);color:#f0b93a;border:1px solid rgba(138,90,0,.3);}
.stock-out{background:rgba(100,20,20,.15);color:#d44;border:1px solid rgba(150,30,30,.3);}

.product-add-btn{padding:11px;background:var(--red);border:none;color:white;font-family:'Montserrat',sans-serif;font-size:.65rem;font-weight:700;letter-spacing:2px;cursor:pointer;transition:.25s;text-transform:uppercase;margin-top:10px;width:100%;}
.product-add-btn:hover{background:var(--red2);}
.product-add-btn:disabled{background:var(--ink3);color:var(--text4);cursor:not-allowed;}

/* ================================================================ */
/* PRODUCT DETAIL MODAL                                             */
/* ================================================================ */
.modal-backdrop{position:fixed;inset:0;background:rgba(5,3,5,.92);z-index:2000;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(6px);}
.modal-backdrop.open{display:flex;}

.product-modal{background:var(--ink2);border:1px solid var(--border2);max-width:980px;width:100%;max-height:90vh;overflow-y:auto;position:relative;display:grid;grid-template-columns:1fr 1fr;}
.product-modal::-webkit-scrollbar{width:2px;}
.product-modal-close{position:absolute;top:16px;right:16px;width:36px;height:36px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:white;font-size:1rem;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center;transition:.2s;}
.product-modal-close:hover{background:var(--red);border-color:var(--red);}

.modal-gallery{position:relative;overflow:hidden;}
.modal-main-img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;}
.modal-img-placeholder{width:100%;aspect-ratio:3/4;background:var(--ink3);display:flex;align-items:center;justify-content:center;}
.modal-img-placeholder svg{opacity:.1;}
.modal-thumbs{position:absolute;bottom:14px;left:14px;display:flex;gap:6px;}
.modal-thumb{width:44px;height:52px;object-fit:cover;opacity:.55;cursor:pointer;transition:.2s;border:1px solid transparent;}
.modal-thumb.active,.modal-thumb:hover{opacity:1;border-color:var(--red);}

.modal-info{padding:36px 38px;display:flex;flex-direction:column;gap:0;overflow-y:auto;}
.modal-info::-webkit-scrollbar{width:2px;}
.modal-collection{font-size:.62rem;letter-spacing:4px;color:var(--red);text-transform:uppercase;margin-bottom:6px;}
.modal-name{font-family:'Anton',sans-serif;font-size:2.2rem;letter-spacing:3px;line-height:1;margin-bottom:8px;}
.modal-desc{font-size:.82rem;color:var(--text2);line-height:1.75;margin-bottom:22px;padding-bottom:22px;border-bottom:1px solid var(--border);}
.modal-price-row{display:flex;align-items:baseline;gap:12px;margin-bottom:22px;}
.modal-price{font-family:'Anton',sans-serif;font-size:2.4rem;color:var(--text);}
.modal-price-orig{font-size:1rem;color:var(--text4);text-decoration:line-through;}
.modal-price-save{font-size:.7rem;font-weight:700;color:var(--gold);}

/* COLOR SELECTOR */
.selector-label{font-size:.62rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:10px;display:flex;justify-content:space-between;}
.selector-label span{color:var(--text2);font-weight:600;}
.color-palette{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px;}
.color-swatch{width:34px;height:34px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:.2s;position:relative;flex-shrink:0;}
.color-swatch:hover{transform:scale(1.15);}
.color-swatch.selected{border-color:white;box-shadow:0 0 0 1px var(--red);}
.color-swatch-tooltip{position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:var(--ink);border:1px solid var(--border);padding:3px 8px;font-size:.58rem;letter-spacing:1px;white-space:nowrap;opacity:0;pointer-events:none;transition:.15s;}
.color-swatch:hover .color-swatch-tooltip{opacity:1;}

/* SIZE SELECTOR */
.size-grid{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:22px;}
.size-chip{width:52px;height:38px;display:flex;align-items:center;justify-content:center;background:var(--ink3);border:1px solid var(--border);color:var(--text2);font-size:.7rem;font-weight:700;letter-spacing:1px;cursor:pointer;transition:.2s;}
.size-chip:hover:not(.size-disabled){border-color:var(--border3);color:var(--text);}
.size-chip.size-selected{background:var(--red);border-color:var(--red);color:white;}
.size-chip.size-disabled{opacity:.28;cursor:not-allowed;text-decoration:line-through;}
.size-guide-link{font-size:.62rem;color:var(--red);letter-spacing:1px;cursor:pointer;text-decoration:underline;text-underline-offset:3px;margin-bottom:22px;display:inline-block;}

/* QTY ROW */
.qty-row{display:flex;align-items:center;gap:12px;margin-bottom:22px;}
.qty-ctrl{display:flex;align-items:center;border:1px solid var(--border2);}
.qty-btn{width:38px;height:42px;background:var(--ink3);border:none;color:var(--text);font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.2s;}
.qty-btn:hover{background:var(--red);}
.qty-num{width:46px;height:42px;background:var(--ink2);border:none;border-left:1px solid var(--border);border-right:1px solid var(--border);color:var(--text);font-family:'Anton',sans-serif;font-size:1rem;text-align:center;letter-spacing:2px;}
.qty-num:focus{outline:none;}
.stock-indicator{font-size:.65rem;letter-spacing:2px;font-weight:600;}

.modal-add-btn{padding:16px;background:var(--red);border:none;color:white;font-family:'Montserrat',sans-serif;font-size:.75rem;font-weight:700;letter-spacing:3px;cursor:pointer;transition:.25s;text-transform:uppercase;width:100%;margin-bottom:10px;position:relative;overflow:hidden;}
.modal-add-btn::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(255,255,255,.08),transparent);transform:translateX(-100%);transition:.4s;}
.modal-add-btn:hover{background:var(--red2);}
.modal-add-btn:hover::before{transform:translateX(100%);}
.modal-add-btn:disabled{background:var(--ink3);color:var(--text4);cursor:not-allowed;}

.modal-details-accordion{margin-top:16px;border-top:1px solid var(--border);}
.accordion-item{border-bottom:1px solid var(--border);}
.accordion-trigger{width:100%;background:none;border:none;color:var(--text2);padding:14px 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;transition:.2s;}
.accordion-trigger:hover{color:var(--text);}
.accordion-trigger .arrow{transition:.25s;font-size:.7rem;}
.accordion-trigger.open .arrow{transform:rotate(180deg);}
.accordion-body{max-height:0;overflow:hidden;transition:max-height .35s ease;}
.accordion-body.open{max-height:300px;}
.accordion-content{padding:0 0 16px;font-size:.78rem;color:var(--text3);line-height:1.75;}
.material-tag{display:inline-block;padding:2px 8px;background:var(--ink3);border:1px solid var(--border);font-size:.6rem;letter-spacing:1px;margin:3px 4px 3px 0;}

/* ================================================================ */
/* CART DRAWER                                                       */
/* ================================================================ */
.cart-drawer{position:fixed;right:-500px;top:0;width:460px;height:100vh;background:var(--ink2);border-left:1px solid var(--border2);z-index:1500;transition:.4s cubic-bezier(.25,.46,.45,.94);display:flex;flex-direction:column;}
.cart-drawer.open{right:0;}
.cart-backdrop{position:fixed;inset:0;background:rgba(5,3,5,.75);z-index:1499;display:none;}
.cart-backdrop.open{display:block;}

.cart-header{padding:22px 24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0;}
.cart-header h3{font-family:'Anton',sans-serif;font-size:1.2rem;letter-spacing:4px;color:var(--text);}
.cart-header-meta{font-size:.65rem;letter-spacing:2px;color:var(--text3);}
.cart-close{background:none;border:1px solid var(--border);color:var(--text3);width:34px;height:34px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;transition:.2s;}
.cart-close:hover{background:var(--red);border-color:var(--red);color:white;}

.cart-items{flex:1;overflow-y:auto;padding:18px 24px;}
.cart-items::-webkit-scrollbar{width:2px;}
.cart-items::-webkit-scrollbar-thumb{background:var(--border2);}
.cart-empty{text-align:center;padding:60px 20px;color:var(--text4);}
.cart-empty-icon{font-size:3rem;display:block;margin-bottom:12px;opacity:.3;}
.cart-empty-text{font-size:.75rem;letter-spacing:2px;text-transform:uppercase;}

.cart-item{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--border);}
.cart-item-img{width:74px;height:88px;object-fit:cover;flex-shrink:0;background:var(--ink3);}
.cart-item-body{flex:1;min-width:0;}
.cart-item-collection{font-size:.58rem;letter-spacing:2px;color:var(--red);text-transform:uppercase;margin-bottom:2px;}
.cart-item-name{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:2px;margin-bottom:4px;line-height:1.1;}
.cart-item-variant{font-size:.65rem;color:var(--text3);letter-spacing:1px;margin-bottom:8px;display:flex;align-items:center;gap:8px;}
.cart-variant-color{width:12px;height:12px;border-radius:50%;border:1px solid rgba(255,255,255,.2);flex-shrink:0;}
.cart-item-controls{display:flex;align-items:center;justify-content:space-between;}
.cart-qty{display:flex;align-items:center;gap:0;border:1px solid var(--border);}
.cart-qty-btn{width:28px;height:28px;background:var(--ink3);border:none;color:var(--text);font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;}
.cart-qty-btn:hover{background:var(--red);}
.cart-qty-num{width:34px;height:28px;background:var(--ink2);border:none;border-left:1px solid var(--border);border-right:1px solid var(--border);color:var(--text);font-family:'Anton',sans-serif;font-size:.85rem;text-align:center;letter-spacing:1px;}
.cart-item-price{font-family:'Anton',sans-serif;font-size:1.1rem;color:var(--text);}
.cart-remove{background:none;border:none;color:var(--text4);font-size:.85rem;cursor:pointer;transition:.2s;padding:4px;}
.cart-remove:hover{color:var(--red2);}

.cart-footer{padding:20px 24px;border-top:1px solid var(--border);flex-shrink:0;background:var(--ink);}
.cart-summary{display:flex;flex-direction:column;gap:6px;margin-bottom:18px;}
.cart-summary-row{display:flex;justify-content:space-between;font-size:.72rem;color:var(--text3);}
.cart-summary-row.total{color:var(--text);font-family:'Anton',sans-serif;font-size:1.1rem;letter-spacing:2px;margin-top:6px;padding-top:10px;border-top:1px solid var(--border);}
.promo-row{display:flex;gap:8px;margin-bottom:14px;}
.promo-input{flex:1;background:var(--ink2);border:1px solid var(--border);color:var(--text);padding:10px 14px;font-family:'Montserrat',sans-serif;font-size:.72rem;letter-spacing:1px;}
.promo-input:focus{outline:none;border-color:var(--border3);}
.promo-input::placeholder{color:var(--text4);}

/* ================================================================ */
/* INVENTORY MANAGER                                                 */
/* ================================================================ */
.inv-page{padding:100px 5% 60px;}
.inv-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;flex-wrap:wrap;gap:12px;}
.inv-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:32px;}
.inv-stat{background:var(--ink3);border:1px solid var(--border);padding:18px 20px;}
.inv-stat-label{font-size:.6rem;letter-spacing:3px;color:var(--text3);text-transform:uppercase;margin-bottom:6px;}
.inv-stat-value{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;}
.inv-stat-value.red{color:var(--red2);}
.inv-stat-value.gold{color:var(--gold2);}
.inv-stat-value.green{color:#4adf8a;}

.import-zone{border:1.5px dashed rgba(212,0,26,.25);padding:32px;text-align:center;cursor:pointer;transition:.3s;margin-bottom:24px;background:var(--ink2);}
.import-zone:hover,.import-zone.drag{border-color:var(--red2);background:rgba(212,0,26,.05);}
.import-zone-icon{font-size:2.4rem;display:block;margin-bottom:10px;}
.import-zone-title{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:3px;margin-bottom:6px;}
.import-zone-sub{font-size:.7rem;color:var(--text3);line-height:1.6;}
.import-zone-sub code{background:var(--ink3);padding:2px 8px;font-family:monospace;font-size:.68rem;color:var(--gold);border:1px solid var(--border);}

.format-preview{background:var(--ink3);border:1px solid var(--border);padding:18px 22px;margin-bottom:24px;font-family:monospace;font-size:.72rem;color:var(--text3);line-height:1.8;overflow-x:auto;}
.format-preview .key{color:var(--gold);}
.format-preview .val{color:var(--text);}
.format-preview .comment{color:var(--text4);}

.inv-table-wrap{overflow-x:auto;}
.inv-table{width:100%;border-collapse:collapse;font-size:.75rem;}
.inv-table th{text-align:left;padding:10px 14px;border-bottom:1px solid var(--border);font-size:.6rem;letter-spacing:2px;text-transform:uppercase;color:var(--text4);white-space:nowrap;}
.inv-table td{padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.03);vertical-align:middle;}
.inv-table tr:hover td{background:rgba(212,0,26,.04);}
.inv-table .product-mini-thumb{width:38px;height:46px;object-fit:cover;border:1px solid var(--border);background:var(--ink3);}
.inv-actions{display:flex;gap:6px;}
.inv-action-btn{padding:5px 10px;background:none;border:1px solid var(--border);color:var(--text3);font-size:.6rem;letter-spacing:1px;cursor:pointer;transition:.15s;font-family:'Montserrat',sans-serif;}
.inv-action-btn:hover{border-color:var(--red);color:var(--red2);}
.inv-action-btn.del:hover{border-color:#d44;color:#d44;}
.color-dots{display:flex;gap:4px;flex-wrap:wrap;}
.color-dot{width:14px;height:14px;border-radius:50%;border:1px solid rgba(255,255,255,.15);}
.size-tags{display:flex;gap:3px;flex-wrap:wrap;}
.size-tag{padding:1px 6px;background:var(--ink);border:1px solid var(--border);font-size:.58rem;letter-spacing:1px;}

/* ================================================================ */
/* ADD/EDIT PRODUCT MODAL                                            */
/* ================================================================ */
.edit-modal-overlay{position:fixed;inset:0;background:rgba(5,3,5,.94);z-index:3000;display:none;align-items:flex-start;justify-content:center;padding:20px;overflow-y:auto;backdrop-filter:blur(8px);}
.edit-modal-overlay.open{display:flex;}
.edit-modal{background:var(--ink2);border:1px solid var(--border2);width:100%;max-width:780px;margin:auto;position:relative;}
.edit-modal-header{padding:24px 28px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.edit-modal-header h3{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:4px;color:var(--red2);}
.edit-modal-body{padding:28px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.form-group{display:flex;flex-direction:column;gap:7px;}
.form-group.full{grid-column:1/-1;}
.form-label{font-size:.62rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);}
.form-input,.form-textarea,.form-select{background:var(--ink3);border:1px solid var(--border);color:var(--text);padding:11px 14px;font-family:'Montserrat',sans-serif;font-size:.82rem;width:100%;transition:.2s;}
.form-input:focus,.form-textarea:focus,.form-select:focus{outline:none;border-color:var(--border3);background:var(--ink2);}
.form-input::placeholder,.form-textarea::placeholder{color:var(--text4);}
.form-textarea{resize:vertical;min-height:90px;line-height:1.6;}
.form-select{cursor:pointer;}

/* SIZE CHECKBOXES */
.size-checkboxes{display:flex;gap:8px;flex-wrap:wrap;}
.size-check-label{display:flex;align-items:center;gap:6px;cursor:pointer;}
.size-check-label input{display:none;}
.size-check-pill{width:46px;height:34px;display:flex;align-items:center;justify-content:center;background:var(--ink3);border:1px solid var(--border);color:var(--text3);font-size:.68rem;font-weight:700;letter-spacing:1px;transition:.2s;}
.size-check-label input:checked + .size-check-pill{background:var(--red);border-color:var(--red);color:white;}
.size-check-pill:hover{border-color:var(--border3);}

/* COLOR BUILDER */
.color-builder{display:flex;flex-direction:column;gap:12px;}
.color-builder-add{display:flex;gap:8px;align-items:center;}
.color-builder-add input[type=text]{flex:1;background:var(--ink3);border:1px solid var(--border);color:var(--text);padding:10px 14px;font-family:'Montserrat',sans-serif;font-size:.78rem;}
.color-builder-add input[type=text]:focus{outline:none;border-color:var(--border3);}
.color-builder-add input[type=color]{width:44px;height:38px;background:var(--ink3);border:1px solid var(--border);padding:3px;cursor:pointer;}
.color-builder-list{display:flex;gap:8px;flex-wrap:wrap;}
.color-builder-item{display:flex;align-items:center;gap:6px;background:var(--ink3);border:1px solid var(--border);padding:5px 10px 5px 6px;}
.color-builder-swatch{width:22px;height:22px;border-radius:50%;border:1px solid rgba(255,255,255,.2);}
.color-builder-name{font-size:.68rem;letter-spacing:1px;color:var(--text2);}
.color-builder-remove{background:none;border:none;color:var(--text4);cursor:pointer;font-size:.75rem;transition:.15s;margin-left:2px;}
.color-builder-remove:hover{color:var(--red2);}

/* IMAGE UPLOAD IN FORM */
.img-upload-area{border:1.5px dashed var(--border);padding:22px;text-align:center;cursor:pointer;transition:.3s;background:var(--ink3);}
.img-upload-area:hover{border-color:var(--red);background:rgba(212,0,26,.05);}
.img-upload-previews{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
.img-upload-preview{width:72px;height:86px;object-fit:cover;border:1px solid var(--border);position:relative;}

/* STOCK EDITOR */
.stock-size-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.stock-size-input{display:flex;flex-direction:column;gap:4px;}
.stock-size-input label{font-size:.6rem;letter-spacing:2px;color:var(--text3);text-align:center;}
.stock-size-input input{background:var(--ink3);border:1px solid var(--border);color:var(--text);padding:8px;font-family:'Anton',sans-serif;font-size:.9rem;text-align:center;width:100%;}

/* ================================================================ */
/* TOAST                                                             */
/* ================================================================ */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(12px);background:var(--ink2);border:1px solid var(--border2);border-left:3px solid var(--red);padding:12px 22px;font-size:.75rem;letter-spacing:2px;z-index:9999;opacity:0;transition:.32s;white-space:nowrap;max-width:90vw;display:flex;align-items:center;gap:10px;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
.toast-icon{font-size:1rem;}

/* ================================================================ */
/* RESPONSIVE                                                        */
/* ================================================================ */
@media(max-width:960px){
  .product-modal{grid-template-columns:1fr;}
  .form-grid{grid-template-columns:1fr;}
  .inv-stats{grid-template-columns:repeat(2,1fr);}
}
@media(max-width:640px){
  .nav-links{display:none;}
  .cart-drawer{width:100%;}
  .hero-h1{font-size:3.5rem;}
  .inv-stats{grid-template-columns:1fr 1fr;}
  .products-grid{grid-template-columns:repeat(2,1fr);}
}
</style>
</head>
<body>

<!-- CURSOR -->
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<!-- CART BACKDROP -->
<div class="cart-backdrop" id="cartBackdrop" onclick="closeCart()"></div>

<!-- NAV -->
<nav>
  <div class="nav-logo">MENACE<span>2</span>SOCIETY</div>
  <div class="nav-links">
    <div class="nav-link active" onclick="showPage('shop')">Shop</div>
    <div class="nav-link" onclick="showPage('collections')">Collections</div>
    <div class="nav-link" onclick="showPage('inventory')">Inventory</div>
    <div class="nav-link" onclick="showPage('lookbook')">Lookbook</div>
  </div>
  <div class="nav-right">
    <div class="nav-icon-btn" onclick="showPage('inventory')" title="Manage Inventory">⚙</div>
    <div class="nav-icon-btn cart-trigger" onclick="openCart()" title="Cart">
      🛍
      <span class="cart-count" id="cartCount">0</span>
    </div>
  </div>
</nav>

<!-- CART DRAWER -->
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-header">
    <div>
      <h3>YOUR CART</h3>
      <div class="cart-header-meta" id="cartHeaderMeta">0 items</div>
    </div>
    <button class="cart-close" onclick="closeCart()">✕</button>
  </div>
  <div class="cart-items" id="cartItemsEl"></div>
  <div class="cart-footer">
    <div class="cart-summary" id="cartSummary"></div>
    <div class="promo-row">
      <input class="promo-input" id="promoInput" placeholder="PROMO CODE">
      <button class="btn btn-ghost btn-sm" onclick="applyPromo()">APPLY</button>
    </div>
    <button class="btn btn-primary" style="width:100%;padding:16px;" onclick="showToast('✅','Redirecting to checkout — connect Stripe to process')">CHECKOUT →</button>
    <button class="btn btn-ghost" style="width:100%;padding:12px;margin-top:8px;" onclick="closeCart()">CONTINUE SHOPPING</button>
  </div>
</div>

<!-- PRODUCT DETAIL MODAL -->
<div class="modal-backdrop" id="productModal">
  <div class="product-modal" id="productModalContent">
    <button class="product-modal-close" onclick="closeProductModal()">✕</button>
    <div class="modal-gallery" id="modalGallery"></div>
    <div class="modal-info" id="modalInfo"></div>
  </div>
</div>

<!-- ADD/EDIT PRODUCT MODAL -->
<div class="edit-modal-overlay" id="editModal">
  <div class="edit-modal">
    <div class="edit-modal-header">
      <h3 id="editModalTitle">ADD PRODUCT</h3>
      <button class="cart-close" onclick="closeEditModal()">✕</button>
    </div>
    <div class="edit-modal-body">
      <div class="form-grid">
        <div class="form-group"><label class="form-label">Product Name *</label><input class="form-input" id="ef-name" placeholder="e.g. Chaos Denim Jacket"></div>
        <div class="form-group"><label class="form-label">Collection Name *</label><input class="form-input" id="ef-collection" placeholder="e.g. ORIGINS VOL.1"></div>
        <div class="form-group"><label class="form-label">Price ($) *</label><input class="form-input" type="number" id="ef-price" placeholder="e.g. 120"></div>
        <div class="form-group"><label class="form-label">Original Price (sale)</label><input class="form-input" type="number" id="ef-origprice" placeholder="Leave blank if no sale"></div>
        <div class="form-group"><label class="form-label">Category</label>
          <select class="form-select" id="ef-category">
            <option>Tops</option><option>Bottoms</option><option>Outerwear</option><option>Hoodies</option><option>Accessories</option><option>Footwear</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Badge</label>
          <select class="form-select" id="ef-badge">
            <option value="">None</option><option value="new">NEW</option><option value="sale">SALE</option><option value="low">LOW STOCK</option>
          </select>
        </div>
        <div class="form-group full"><label class="form-label">Description *</label><textarea class="form-textarea" id="ef-desc" placeholder="Full product description — materials, fit, vibe..."></textarea></div>
        <div class="form-group full"><label class="form-label">Materials / Details</label><textarea class="form-textarea" id="ef-materials" placeholder="e.g. 100% heavyweight cotton, washed finish..." style="min-height:60px;"></textarea></div>
        <div class="form-group full">
          <label class="form-label">Available Sizes</label>
          <div class="size-checkboxes" id="ef-sizes">
            <label class="size-check-label"><input type="checkbox" value="XS"><span class="size-check-pill">XS</span></label>
            <label class="size-check-label"><input type="checkbox" value="S" checked><span class="size-check-pill">S</span></label>
            <label class="size-check-label"><input type="checkbox" value="M" checked><span class="size-check-pill">M</span></label>
            <label class="size-check-label"><input type="checkbox" value="L" checked><span class="size-check-pill">L</span></label>
            <label class="size-check-label"><input type="checkbox" value="XL" checked><span class="size-check-pill">XL</span></label>
            <label class="size-check-label"><input type="checkbox" value="2X"><span class="size-check-pill">2X</span></label>
          </div>
        </div>
        <div class="form-group full">
          <label class="form-label">Color Palette</label>
          <div class="color-builder">
            <div class="color-builder-add">
              <input type="color" id="ef-color-picker" value="#1a1a1a">
              <input type="text" id="ef-color-name" placeholder="Color name (e.g. Void Black)">
              <button class="btn btn-sm btn-ghost" onclick="addColorToBuilder()">+ ADD</button>
            </div>
            <div class="color-builder-list" id="ef-color-list"></div>
          </div>
        </div>
        <div class="form-group full">
          <label class="form-label">Stock by Size</label>
          <div class="stock-size-grid" id="ef-stock-grid"></div>
        </div>
        <div class="form-group full">
          <label class="form-label">Product Images</label>
          <div class="img-upload-area" onclick="document.getElementById('ef-img-input').click()" ondragover="event.preventDefault();this.style.borderColor='var(--red)'" ondragleave="this.style.borderColor=''" ondrop="handleFormImgDrop(event)">
            <div style="font-size:1.5rem;margin-bottom:6px;">📸</div>
            <div style="font-size:.72rem;color:var(--text3);">Click or drop images · Multiple supported · First image = cover</div>
          </div>
          <input type="file" id="ef-img-input" multiple accept="image/*" style="display:none" onchange="handleFormImgs(this)">
          <div class="img-upload-previews" id="ef-img-previews"></div>
        </div>
      </div>
      <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
        <button class="btn btn-primary" style="flex:1;padding:14px;" onclick="saveProduct()">SAVE PRODUCT</button>
        <button class="btn btn-ghost" style="padding:14px 22px;" onclick="closeEditModal()">CANCEL</button>
      </div>
    </div>
  </div>
</div>

<!-- ================================================================ -->
<!-- SHOP PAGE                                                         -->
<!-- ================================================================ -->
<div class="page active" id="page-shop">
  <div class="hero">
    <div class="hero-bg"></div>
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-content">
      <span class="hero-eyebrow">Est. 2026 · Houston, TX</span>
      <h1 class="hero-h1">MOST<br><span class="accent">WANTED</span><br>PIECES</h1>
      <p class="hero-sub">Streetwear forged for the misunderstood</p>
      <div class="hero-btns">
        <button class="btn btn-primary" onclick="document.getElementById('shop-grid-section').scrollIntoView({behavior:'smooth'})">SHOP THE DROP</button>
        <button class="btn btn-ghost" onclick="showPage('collections')">VIEW COLLECTIONS</button>
      </div>
    </div>
  </div>

  <div class="section" id="shop-grid-section">
    <div class="shop-toolbar">
      <div style="display:flex;flex-direction:column;gap:4px;">
        <span class="section-eyebrow">The Archive</span>
        <div class="collection-tabs" id="shopCollectionTabs"></div>
      </div>
      <div class="shop-controls">
        <span class="results-count" id="resultsCount">— items</span>
        <select class="sort-select" onchange="sortProducts(this.value)">
          <option value="default">Sort: Default</option>
          <option value="price-asc">Price: Low–High</option>
          <option value="price-desc">Price: High–Low</option>
          <option value="name-asc">Name: A–Z</option>
          <option value="newest">Newest First</option>
        </select>
        <div class="view-btns">
          <div class="view-btn active" id="gridViewBtn" onclick="setView('grid')" title="Grid">⊞</div>
          <div class="view-btn" id="listViewBtn" onclick="setView('list')" title="List">≡</div>
        </div>
      </div>
    </div>
    <div class="products-grid" id="productsGrid"></div>
    <div style="text-align:center;margin-top:50px;display:none;" id="emptyState">
      <p style="font-size:.78rem;letter-spacing:3px;color:var(--text4);text-transform:uppercase;">No products in this collection yet.</p>
      <button class="btn btn-ghost btn-sm" style="margin-top:16px;" onclick="showPage('inventory')">ADD PRODUCTS →</button>
    </div>
  </div>
</div>

<!-- ================================================================ -->
<!-- COLLECTIONS PAGE                                                  -->
<!-- ================================================================ -->
<div class="page" id="page-collections">
  <div class="section">
    <span class="section-eyebrow">The Catalog</span>
    <h1 class="section-title">ALL <span>COLLECTIONS</span></h1>
    <div id="collectionsGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:3px;"></div>
  </div>
</div>

<!-- ================================================================ -->
<!-- INVENTORY PAGE                                                    -->
<!-- ================================================================ -->
<div class="page" id="page-inventory">
  <div class="inv-page">
    <span class="section-eyebrow">Backend</span>
    <h1 class="section-title" style="margin-bottom:28px;">INVENTORY <span>MANAGER</span></h1>

    <div class="inv-stats" id="invStats"></div>

    <!-- FILE IMPORT ZONE -->
    <div class="import-zone" id="invImportZone"
      onclick="document.getElementById('invFileInput').click()"
      ondragover="event.preventDefault();this.classList.add('drag')"
      ondragleave="this.classList.remove('drag')"
      ondrop="handleInvDrop(event)">
      <span class="import-zone-icon">📦</span>
      <div class="import-zone-title">IMPORT PRODUCTS VIA JSON FILE</div>
      <div class="import-zone-sub">
        Drop a <code>.json</code> file or click to browse · Supports bulk import<br>
        Required fields: <code>name</code> <code>collection</code> <code>price</code> <code>description</code>
      </div>
    </div>
    <input type="file" id="invFileInput" accept=".json,application/json" style="display:none" onchange="handleInvFileImport(this)">

    <!-- FORMAT GUIDE -->
    <div style="margin-bottom:24px;">
      <div style="font-size:.6rem;letter-spacing:3px;color:var(--text3);text-transform:uppercase;margin-bottom:8px;">JSON FORMAT GUIDE</div>
      <div class="format-preview">
<span class="comment">// Single product or array of products</span>
[{
  <span class="key">"name"</span>: <span class="val">"Chaos Denim Jacket"</span>,
  <span class="key">"collection"</span>: <span class="val">"ORIGINS VOL.1"</span>,
  <span class="key">"price"</span>: <span class="val">120</span>,
  <span class="key">"originalPrice"</span>: <span class="val">150</span>,  <span class="comment">// optional — shows sale</span>
  <span class="key">"description"</span>: <span class="val">"Heavyweight washed denim..."</span>,
  <span class="key">"materials"</span>: <span class="val">"100% cotton, acid wash"</span>,
  <span class="key">"category"</span>: <span class="val">"Outerwear"</span>,
  <span class="key">"sizes"</span>: <span class="val">["XS","S","M","L","XL","2X"]</span>,
  <span class="key">"colors"</span>: [{ <span class="key">"name"</span>: <span class="val">"Void Black"</span>, <span class="key">"hex"</span>: <span class="val">"#1a1a1a"</span> }],
  <span class="key">"stock"</span>: { <span class="val">"XS"</span>: 5, <span class="val">"S"</span>: 12, <span class="val">"M"</span>: 8, <span class="val">"L"</span>: 3, <span class="val">"XL"</span>: 0, <span class="val">"2X"</span>: 6 },
  <span class="key">"badge"</span>: <span class="val">"new"</span>  <span class="comment">// "new" | "sale" | "low" | ""</span>
}]</div>
    </div>

    <div class="inv-toolbar">
      <div style="display:flex;gap:10px;align-items:center;">
        <input style="background:var(--ink3);border:1px solid var(--border);color:var(--text);padding:10px 14px;font-family:'Montserrat',sans-serif;font-size:.72rem;width:240px;" placeholder="Search inventory..." oninput="filterInventory(this.value)" id="invSearch">
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <button class="btn btn-ghost btn-sm" onclick="exportInventoryJSON()">⬇ EXPORT JSON</button>
        <button class="btn btn-primary btn-sm" onclick="openAddProduct()">+ ADD PRODUCT</button>
      </div>
    </div>

    <div class="inv-table-wrap">
      <table class="inv-table">
