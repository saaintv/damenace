STEP 6 — ADD SIGNUP SYSTEM
============================================================

ADD TO:
script.js

------------------------------------------------------------

import {

  createUserWithEmailAndPassword

}

from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

function signUp(){

  const email =
  document.getElementById("email")
  .value;

  const password =
  document.getElementById("password")
  .value;

  createUserWithEmailAndPassword(

    auth,
    email,
    password

  )

  .then((userCredential)=>{

    alert("Account Created");

  })

  .catch((error)=>{

    alert(error.message);

  });
}

