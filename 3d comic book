<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MENACE 3D COMIC READER</title>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Bangers&family=Permanent+Marker&family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<style>
:root{
  --bg:#08030a;--dark:#0e0612;--surface:#160d1c;--surface2:#1e1126;
  --red:#e8001e;--red2:#ff1e38;--gold:#d4922a;--gold2:#f0b93a;
  --text:#f5eef8;--muted:#8a7a90;--border:rgba(232,0,30,.18);
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;overflow:hidden;background:var(--bg);}
body{font-family:'Montserrat',sans-serif;color:var(--text);}

/* GRAIN OVERLAY */
body::after{content:'';position:fixed;inset:0;pointer-events:none;z-index:9999;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.88' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.035'/%3E%3C/svg%3E");
  opacity:.6;}

/* CANVAS */
#threeCanvas{position:fixed;inset:0;width:100%;height:100%;display:block;cursor:grab;}
#threeCanvas:active{cursor:grabbing;}

/* HUD OVERLAY */
.hud{position:fixed;inset:0;pointer-events:none;z-index:100;}

/* TOP BAR */
.top-bar{position:fixed;top:0;left:0;right:0;height:58px;background:linear-gradient(180deg,rgba(8,3,10,.95),transparent);display:flex;align-items:center;justify-content:space-between;padding:0 28px;z-index:200;pointer-events:all;}
.brand{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:5px;color:white;}
.brand span{color:var(--red);}
.top-title{font-family:'Bangers',sans-serif;font-size:1.4rem;letter-spacing:4px;color:var(--gold);text-align:center;text-shadow:0 0 20px rgba(212,146,42,.4);}
.top-actions{display:flex;gap:8px;}
.top-btn{padding:8px 16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:var(--text);font-size:.72rem;letter-spacing:2px;cursor:pointer;transition:.2s;font-family:'Montserrat',sans-serif;text-transform:uppercase;pointer-events:all;}
.top-btn:hover{background:rgba(232,0,30,.2);border-color:var(--red);}
.top-btn.primary{background:var(--red);border-color:var(--red2);color:white;}
.top-btn.primary:hover{background:var(--red2);}

/* BOTTOM CONTROLS */
.bottom-controls{position:fixed;bottom:0;left:0;right:0;height:72px;background:linear-gradient(0deg,rgba(8,3,10,.98),transparent);display:flex;align-items:center;justify-content:center;gap:18px;padding:0 28px;z-index:200;pointer-events:all;}
.ctrl-btn{width:46px;height:46px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:white;font-size:1.1rem;cursor:pointer;transition:.25s;display:flex;align-items:center;justify-content:center;border-radius:50%;}
.ctrl-btn:hover{background:rgba(232,0,30,.25);border-color:var(--red);transform:scale(1.08);}
.ctrl-btn:disabled{opacity:.25;cursor:not-allowed;transform:none;}
.page-display{font-family:'Bangers',sans-serif;font-size:1.3rem;letter-spacing:3px;color:var(--gold);min-width:120px;text-align:center;}
.progress-track{flex:1;max-width:340px;height:3px;background:rgba(255,255,255,.08);border-radius:2px;position:relative;cursor:pointer;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--red),var(--gold));border-radius:2px;transition:width .3s ease;}
.progress-thumb{position:absolute;top:50%;width:10px;height:10px;background:white;border-radius:50%;transform:translate(-50%,-50%);transition:left .3s ease;border:2px solid var(--red);}

/* LEFT SIDEBAR — IMPORT PANEL */
.import-panel{position:fixed;left:0;top:58px;bottom:72px;width:280px;background:rgba(14,6,18,.96);border-right:1px solid var(--border);transform:translateX(-100%);transition:.4s cubic-bezier(.25,.46,.45,.94);z-index:150;display:flex;flex-direction:column;pointer-events:all;backdrop-filter:blur(12px);}
.import-panel.open{transform:translateX(0);}
.panel-header{padding:18px 20px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.panel-header h3{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:3px;color:var(--red);}
.panel-close{background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;transition:.2s;}
.panel-close:hover{color:white;}
.drop-zone{margin:14px;border:1.5px dashed rgba(232,0,30,.3);padding:22px 16px;text-align:center;cursor:pointer;transition:.3s;border-radius:3px;}
.drop-zone:hover,.drop-zone.drag-over{border-color:var(--red);background:rgba(232,0,30,.06);}
.drop-icon{font-size:2rem;margin-bottom:8px;display:block;}
.drop-label{font-size:.75rem;letter-spacing:1px;color:var(--muted);line-height:1.5;}
.drop-label strong{color:var(--text);display:block;margin-bottom:3px;}
.pages-list{flex:1;overflow-y:auto;padding:0 14px 14px;}
.pages-list::-webkit-scrollbar{width:2px;}
.pages-list::-webkit-scrollbar-thumb{background:var(--border);}
.pages-list-header{display:flex;justify-content:space-between;align-items:center;padding:8px 2px;margin-bottom:8px;}
.pages-list-header span{font-size:.65rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;}
.pages-list-header button{background:none;border:1px solid rgba(232,0,30,.3);color:var(--red);font-size:.6rem;letter-spacing:1px;padding:3px 8px;cursor:pointer;transition:.2s;font-family:'Montserrat',sans-serif;}
.pages-list-header button:hover{background:rgba(232,0,30,.15);}
.page-item{display:flex;align-items:center;gap:9px;padding:8px 10px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.04);margin-bottom:5px;cursor:pointer;transition:.15s;border-radius:2px;}
.page-item:hover{background:rgba(232,0,30,.08);border-color:rgba(232,0,30,.2);}
.page-item.active{background:rgba(232,0,30,.12);border-color:rgba(232,0,30,.4);}
.page-thumb-mini{width:28px;height:36px;background:#1a0d22;border:1px solid rgba(255,255,255,.06);flex-shrink:0;overflow:hidden;border-radius:1px;}
.page-thumb-mini img{width:100%;height:100%;object-fit:cover;}
.page-item-info{flex:1;min-width:0;}
.page-item-num{font-size:.72rem;font-weight:700;letter-spacing:1px;}
.page-item-name{font-size:.62rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.remove-page{background:none;border:none;color:rgba(255,255,255,.15);font-size:.85rem;cursor:pointer;transition:.2s;flex-shrink:0;}
.remove-page:hover{color:var(--red);}
.panel-footer{padding:14px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px;}
.panel-footer input{width:100%;background:#0e0612;border:1px solid var(--border);color:white;padding:9px 12px;font-family:'Montserrat',sans-serif;font-size:.78rem;letter-spacing:1px;}
.panel-footer input:focus{outline:none;border-color:var(--red);}
.panel-footer input::placeholder{color:var(--muted);}

/* RIGHT SIDEBAR — TABLE OF CONTENTS */
.toc-panel{position:fixed;right:0;top:58px;bottom:72px;width:240px;background:rgba(14,6,18,.96);border-left:1px solid var(--border);transform:translateX(100%);transition:.4s cubic-bezier(.25,.46,.45,.94);z-index:150;display:flex;flex-direction:column;pointer-events:all;backdrop-filter:blur(12px);}
.toc-panel.open{transform:translateX(0);}
.toc-list{flex:1;overflow-y:auto;padding:14px;}
.toc-list::-webkit-scrollbar{width:2px;}
.toc-list::-webkit-scrollbar-thumb{background:var(--border);}
.toc-item{padding:10px 12px;border-left:2px solid transparent;cursor:pointer;transition:.15s;margin-bottom:4px;}
.toc-item:hover{border-left-color:rgba(232,0,30,.5);background:rgba(232,0,30,.05);}
.toc-item.active{border-left-color:var(--red);}
.toc-pg{font-size:.62rem;color:var(--red);letter-spacing:2px;text-transform:uppercase;margin-bottom:2px;}
.toc-name{font-size:.78rem;font-weight:600;}

/* CENTER INFO OVERLAY */
.center-info{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;z-index:50;transition:opacity .5s;}
.center-info.hidden{opacity:0;}
.center-title{font-family:'Bangers',sans-serif;font-size:clamp(2.5rem,5vw,4.5rem);letter-spacing:6px;line-height:1;margin-bottom:12px;text-shadow:0 0 30px rgba(232,0,30,.5);}
.center-sub{font-size:.78rem;letter-spacing:4px;color:var(--gold);text-transform:uppercase;}
.center-hint{margin-top:22px;font-size:.68rem;letter-spacing:3px;color:rgba(255,255,255,.3);text-transform:uppercase;animation:hintPulse 2s infinite;}
@keyframes hintPulse{0%,100%{opacity:.3;}50%{opacity:.8;}}

/* TOAST */
.toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(20px);background:rgba(14,6,18,.95);border:1px solid var(--border);padding:11px 20px;font-size:.75rem;letter-spacing:2px;opacity:0;transition:.35s;z-index:300;white-space:nowrap;border-left:2px solid var(--red);}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* LOADING SCREEN */
.loading-screen{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:500;transition:opacity .8s;}
.loading-screen.done{opacity:0;pointer-events:none;}
.loading-logo{font-family:'Anton',sans-serif;font-size:3.5rem;letter-spacing:8px;margin-bottom:8px;}
.loading-logo span{color:var(--red);}
.loading-sub{font-size:.7rem;letter-spacing:5px;color:var(--muted);margin-bottom:40px;text-transform:uppercase;}
.loading-bar-wrap{width:240px;height:2px;background:rgba(255,255,255,.06);}
.loading-bar{height:100%;background:linear-gradient(90deg,var(--red),var(--gold));width:0%;transition:width .1s linear;}
.loading-label{margin-top:12px;font-size:.6rem;letter-spacing:3px;color:var(--muted);text-transform:uppercase;}

/* PAGE TURN PARTICLES */
.particle-canvas{position:fixed;inset:0;pointer-events:none;z-index:90;}

/* KEYBOARD HINTS */
.key-hints{position:fixed;bottom:82px;right:18px;display:flex;flex-direction:column;gap:4px;opacity:.3;pointer-events:none;z-index:100;}
.key-hint{display:flex;align-items:center;gap:6px;font-size:.58rem;letter-spacing:1px;color:var(--muted);}
.key{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);padding:2px 6px;border-radius:3px;font-size:.55rem;}

/* MOBILE */
@media(max-width:640px){.top-title{display:none;}.key-hints{display:none;}.bottom-controls{gap:10px;}.progress-track{max-width:160px;}}
</style>
</head>
<body>

<!-- LOADING -->
<div class="loading-screen" id="loadingScreen">
  <div class="loading-logo">MENACE<span>2</span>SOCIETY</div>
  <div class="loading-sub">3D Comic Universe</div>
  <div class="loading-bar-wrap"><div class="loading-bar" id="loadingBar"></div></div>
  <div class="loading-label" id="loadingLabel">Initializing 3D Engine...</div>
</div>

<!-- PARTICLE CANVAS -->
<canvas class="particle-canvas" id="particleCanvas"></canvas>

<!-- THREE.JS CANVAS -->
<canvas id="threeCanvas"></canvas>

<!-- TOP BAR -->
<div class="top-bar">
  <div class="brand">M<span>2</span>S</div>
  <div class="top-title" id="topTitle">MENACE ORIGINS</div>
  <div class="top-actions">
    <button class="top-btn" onclick="togglePanel('import')">⬆ IMPORT</button>
    <button class="top-btn" onclick="togglePanel('toc')">☰ CHAPTERS</button>
    <button class="top-btn primary" onclick="toggleAutoFlip()">▶ AUTO-READ</button>
  </div>
</div>

<!-- IMPORT PANEL -->
<div class="import-panel" id="importPanel">
  <div class="panel-header">
    <h3>IMPORT PAGES</h3>
    <button class="panel-close" onclick="togglePanel('import')">✕</button>
  </div>
  <div class="drop-zone" id="dropZone"
    onclick="document.getElementById('fileInput').click()"
    ondragover="event.preventDefault();this.classList.add('drag-over')"
    ondragleave="this.classList.remove('drag-over')"
    ondrop="handleDrop(event)">
    <span class="drop-icon">📂</span>
    <div class="drop-label">
      <strong>Drop comic pages here</strong>
      JPG, PNG, WEBP, GIF supported<br>Multiple files at once
    </div>
  </div>
  <input type="file" id="fileInput" multiple accept="image/*" style="display:none" onchange="handleFiles(this)">
  <div class="pages-list">
    <div class="pages-list-header">
      <span id="pageCountLabel">0 Pages</span>
      <button onclick="clearAllPages()">CLEAR ALL</button>
    </div>
    <div id="pagesList"></div>
  </div>
  <div class="panel-footer">
    <input id="bookTitleInput" placeholder="Comic title..." value="MENACE ORIGINS" oninput="updateTitle(this.value)">
    <button class="top-btn primary" style="pointer-events:all;width:100%;padding:11px;" onclick="loadDemoPages()">LOAD DEMO PAGES</button>
  </div>
</div>

<!-- TOC PANEL -->
<div class="toc-panel" id="tocPanel">
  <div class="panel-header">
    <h3>CHAPTERS</h3>
    <button class="panel-close" onclick="togglePanel('toc')">✕</button>
  </div>
  <div class="toc-list" id="tocList"></div>
</div>

<!-- BOTTOM CONTROLS -->
<div class="bottom-controls">
  <button class="ctrl-btn" onclick="goToPage(0)" title="First Page">⏮</button>
  <button class="ctrl-btn" id="prevBtn" onclick="flipPrev()">◀</button>
  <div class="page-display" id="pageDisplay">COVER</div>
  <div class="progress-track" id="progressTrack" onclick="seekProgress(event)">
    <div class="progress-fill" id="progressFill" style="width:0%"></div>
    <div class="progress-thumb" id="progressThumb" style="left:0%"></div>
  </div>
  <button class="ctrl-btn" id="nextBtn" onclick="flipNext()">▶</button>
  <button class="ctrl-btn" onclick="goToPage(pages.length-1)" title="Last Page">⏭</button>
  <button class="ctrl-btn" onclick="toggle3DView()" title="Toggle View">🔄</button>
</div>

<!-- KEYBOARD HINTS -->
<div class="key-hints">
  <div class="key-hint"><span class="key">←</span> Prev page</div>
  <div class="key-hint"><span class="key">→</span> Next page</div>
  <div class="key-hint"><span class="key">Space</span> Auto-read</div>
  <div class="key-hint"><span class="key">Drag</span> Rotate book</div>
</div>

<!-- CENTER INFO -->
<div class="center-info" id="centerInfo">
  <div class="center-title" id="centerTitle">MENACE<br>ORIGINS</div>
  <div class="center-sub">A 3D Comic Experience</div>
  <div class="center-hint">← → to flip pages · Drag to rotate · Import your story above</div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
/* ============================================================ */
/* LOADING SEQUENCE                                              */
/* ============================================================ */
let loadPct=0;
const loadSteps=['Initializing 3D Engine...','Building book geometry...','Configuring materials...','Setting up lighting...','Loading shaders...','Ready.'];
let loadStep=0;
const loadInterval=setInterval(()=>{
  loadPct+=Math.random()*18+4;
  if(loadPct>100)loadPct=100;
  document.getElementById('loadingBar').style.width=loadPct+'%';
  if(loadStep<loadSteps.length-1&&loadPct>(loadStep+1)*16){loadStep++;document.getElementById('loadingLabel').textContent=loadSteps[loadStep];}
  if(loadPct>=100){clearInterval(loadInterval);setTimeout(()=>{document.getElementById('loadingScreen').classList.add('done');},500);}
},120);

/* ============================================================ */
/* TOAST                                                          */
/* ============================================================ */
let toastT;
function showToast(msg){
  const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');
  clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2800);
}

/* ============================================================ */
/* PAGE DATA                                                      */
/* ============================================================ */
let pages=[];
let currentPageIdx=0;
let bookTitle='MENACE ORIGINS';
let autoFlipInterval=null;
let autoFlipping=false;

/* Demo pages — generated colored placeholder canvases */
function createDemoCanvas(pageNum,total){
  const c=document.createElement('canvas');c.width=800;c.height=1100;
  const ctx=c.getContext('2d');
  // Background
  const hue=Math.floor((pageNum/total)*40+340)%360;
  ctx.fillStyle=`hsl(${hue},80%,5%)`;ctx.fillRect(0,0,800,1100);
  // Panel grid
  const panels=pageNum===0?1:4;
  const panelLayouts=[
    [[0,0,800,1100]],
    [[20,20,370,510],[410,20,370,510],[20,550,370,510],[410,550,370,510]],
    [[20,20,760,340],[20,380,370,690],[410,380,370,690]],
    [[20,20,370,690],[410,20,370,690],[20,730,760,340]],
    [[20,20,760,220],[20,260,370,800],[410,260,370,390],[410,670,370,390]],
  ];
  const layout=pageNum===0?panelLayouts[0]:panelLayouts[(pageNum-1)%4+1];
  layout.forEach((panel,i)=>{
    const [x,y,w,h]=panel;
    // Panel bg
    const grad=ctx.createLinearGradient(x,y,x+w,y+h);
    grad.addColorStop(0,`hsl(${(hue+i*20)%360},70%,8%)`);
    grad.addColorStop(1,`hsl(${(hue+i*20+40)%360},80%,12%)`);
    ctx.fillStyle=grad;ctx.fillRect(x,y,w,h);
    // Panel border
    ctx.strokeStyle=`hsl(${hue},60%,35%)`;ctx.lineWidth=3;ctx.strokeRect(x+4,y+4,w-8,h-8);
    // Red accent line
    ctx.strokeStyle='#e8001e';ctx.lineWidth=1.5;ctx.strokeRect(x+8,y+8,w-16,h-16);
    // Panel number (decorative)
    ctx.font=`bold ${Math.min(w,h)*0.4}px Anton, sans-serif`;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillStyle=`hsla(${hue},50%,20%,0.6)`;
    ctx.fillText(pageNum===0?bookTitle.substring(0,1):i+1,x+w/2,y+h/2);
    // Decorative lines
    for(let l=0;l<3;l++){
      ctx.strokeStyle=`hsla(0,80%,50%,${0.05+l*0.03})`;ctx.lineWidth=1;
      ctx.beginPath();ctx.moveTo(x+20+l*8,y+h-40-l*5);ctx.lineTo(x+w-20-l*8,y+h-40-l*5);ctx.stroke();
    }
  });
  // Cover special treatment
  if(pageNum===0){
    ctx.font='bold 80px Anton, sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillStyle='rgba(232,0,30,0.15)';ctx.fillText(bookTitle,400,400);
    ctx.font='bold 68px Anton, sans-serif';ctx.fillStyle='#f5eef8';ctx.fillText(bookTitle,400,398);
    ctx.font='500 24px Montserrat, sans-serif';ctx.fillStyle='#d4922a';ctx.fillText('MENACE 2 SOCIETY',400,490);
    ctx.font='400 18px Montserrat, sans-serif';ctx.fillStyle='rgba(255,255,255,0.4)';ctx.fillText('A GRUNGE COMIC UNIVERSE',400,530);
    // Red bar
    ctx.fillStyle='#e8001e';ctx.fillRect(0,580,800,4);
  }
  // Page number
  ctx.font='500 16px Montserrat, sans-serif';ctx.textAlign='right';ctx.textBaseline='bottom';
  ctx.fillStyle='rgba(255,255,255,0.25)';ctx.fillText(pageNum===0?'COVER':'PG '+(pageNum),780,1085);
  return c.toDataURL('image/jpeg',.92);
}

function loadDemoPages(){
  pages=[];
  const count=12;
  for(let i=0;i<count;i++){
    const dataURL=createDemoCanvas(i,count);
    pages.push({id:i,url:dataURL,name:i===0?'COVER':i===count-1?'BACK COVER':'PAGE '+i,chapter:i===0?'Cover':i<5?'Chapter I: Origins':i<9?'Chapter II: The Fall':'Chapter III: Rise'});
  }
  updatePagesList();
  buildBookTextures();
  goToPage(0);
  togglePanel('import');
  showToast('✅  12 demo pages loaded — enjoy the story!');
}

function handleFiles(input){
  const files=Array.from(input.files);
  if(!files.length)return;
  files.sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true}));
  let loaded=0;
  files.forEach((file,i)=>{
    const reader=new FileReader();
    reader.onload=e=>{
      pages.push({id:Date.now()+i,url:e.target.result,name:file.name.replace(/\.[^.]+$/,''),chapter:'Chapter '+(Math.floor((pages.length)/5)+1)});
      loaded++;
      if(loaded===files.length){
        pages.sort((a,b)=>(a.name||'').localeCompare(b.name||'',undefined,{numeric:true}));
        updatePagesList();buildBookTextures();goToPage(0);
        showToast(`✅  ${files.length} page(s) imported`);
      }
    };
    reader.readAsDataURL(file);
  });
  input.value='';
}

function handleDrop(e){
  e.preventDefault();document.getElementById('dropZone').classList.remove('drag-over');
  const files=Array.from(e.dataTransfer.files).filter(f=>f.type.startsWith('image/'));
  if(!files.length){showToast('⚠  Only image files are supported');return;}
  const fakeInput={files};handleFiles(fakeInput);
}

function clearAllPages(){
  pages=[];updatePagesList();clearBookTextures();showToast('🗑  All pages cleared');
}

function removePage(id){
  pages=pages.filter(p=>p.id!==id);
  updatePagesList();buildBookTextures();
  if(currentPageIdx>=pages.length)currentPageIdx=Math.max(0,pages.length-1);
  goToPage(currentPageIdx);
  showToast('🗑  Page removed');
}

function updateTitle(v){bookTitle=v;document.getElementById('topTitle').textContent=v;document.getElementById('centerTitle').textContent=v;}

/* ============================================================ */
/* UI STATE                                                       */
/* ============================================================ */
let openPanel=null;
function togglePanel(name){
  const panels={import:'importPanel',toc:'tocPanel'};
  if(openPanel===name){document.getElementById(panels[name]).classList.remove('open');openPanel=null;}
  else{
    Object.values(panels).forEach(p=>document.getElementById(p).classList.remove('open'));
    document.getElementById(panels[name]).classList.add('open');openPanel=name;
    if(name==='toc')updateTOC();
  }
}

function updatePagesList(){
  const list=document.getElementById('pagesList');
  document.getElementById('pageCountLabel').textContent=pages.length+' Page'+(pages.length!==1?'s':'');
  list.innerHTML=pages.map((p,i)=>`
    <div class="page-item ${i===currentPageIdx?'active':''}" onclick="goToPage(${i})">
      <div class="page-thumb-mini"><img src="${p.url}" alt="${p.name}"></div>
      <div class="page-item-info">
        <div class="page-item-num">${i===0?'COVER':i===pages.length-1&&pages.length>1?'BACK':'PG '+(i)}</div>
        <div class="page-item-name">${p.name||'Page '+(i+1)}</div>
      </div>
      <button class="remove-page" onclick="event.stopPropagation();removePage(${p.id})">✕</button>
    </div>`).join('');
}

function updateTOC(){
  const list=document.getElementById('tocList');
  const chapters={};
  pages.forEach((p,i)=>{const ch=p.chapter||'Main';if(!chapters[ch])chapters[ch]=[];chapters[ch].push({...p,idx:i});});
  list.innerHTML=Object.entries(chapters).map(([ch,ps])=>`
    <div style="margin-bottom:16px;">
      <div style="font-size:.6rem;letter-spacing:3px;color:var(--red);text-transform:uppercase;margin-bottom:6px;padding:0 4px;">${ch}</div>
      ${ps.map(p=>`<div class="toc-item ${p.idx===currentPageIdx?'active':''}" onclick="goToPage(${p.idx});togglePanel('toc')">
        <div class="toc-pg">${p.idx===0?'COVER':p.idx===pages.length-1?'END':'PG '+(p.idx)}</div>
        <div class="toc-name">${p.name||'Page '+(p.idx+1)}</div>
      </div>`).join('')}
    </div>`).join('');
}

function updateHUD(){
  const total=pages.length;const idx=currentPageIdx;
  const pct=total>1?idx/(total-1)*100:0;
  document.getElementById('progressFill').style.width=pct+'%';
  document.getElementById('progressThumb').style.left=pct+'%';
  document.getElementById('pageDisplay').textContent=idx===0?'COVER':idx===total-1&&total>1?'END':'PG '+(idx)+' / '+(total-1);
  document.getElementById('prevBtn').disabled=idx===0;
  document.getElementById('nextBtn').disabled=idx===total-1;
  document.querySelectorAll('.page-item').forEach((el,i)=>{el.classList.toggle('active',i===idx);});
  const infoEl=document.getElementById('centerInfo');
  if(idx===0&&total>0)infoEl.classList.remove('hidden');else infoEl.classList.add('hidden');
}

function seekProgress(e){
  if(!pages.length)return;
  const rect=e.currentTarget.getBoundingClientRect();
  const pct=(e.clientX-rect.left)/rect.width;
  const idx=Math.round(pct*(pages.length-1));
  goToPage(idx);
}

function toggleAutoFlip(){
  autoFlipping=!autoFlipping;
  const btn=document.querySelector('.top-btn.primary');
  if(autoFlipping){
    btn.textContent='⏸ PAUSE';
    autoFlipInterval=setInterval(()=>{if(currentPageIdx<pages.length-1)flipNext();else{toggleAutoFlip();}},3500);
    showToast('▶  Auto-reading — relax and enjoy');
  } else {
    btn.textContent='▶ AUTO-READ';
    clearInterval(autoFlipInterval);
  }
}

/* ============================================================ */
/* THREE.JS BOOK                                                  */
/* ============================================================ */
const canvas=document.getElementById('threeCanvas');
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(45,innerWidth/innerHeight,.1,100);
camera.position.set(0,0,5);
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true,preserveDrawingBuffer:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.1;

/* SCENE FOG & AMBIENT */
scene.fog=new THREE.FogExp2(0x08030a,.08);

/* LIGHTS */
const ambLight=new THREE.AmbientLight(0x200818,.8);scene.add(ambLight);
const keyLight=new THREE.DirectionalLight(0xfff8f0,2.5);keyLight.position.set(3,5,4);keyLight.castShadow=true;keyLight.shadow.mapSize.set(2048,2048);scene.add(keyLight);
const rimLight=new THREE.DirectionalLight(0xe8001e,.8);rimLight.position.set(-4,2,-3);scene.add(rimLight);
const fillLight=new THREE.DirectionalLight(0x2a0a3a,.5);fillLight.position.set(0,-3,2);scene.add(fillLight);
const spotLight=new THREE.SpotLight(0xfff5e0,3,20,Math.PI/6,.4);spotLight.position.set(0,6,4);spotLight.castShadow=true;scene.add(spotLight);

/* ENVIRONMENT — PARTICLES */
const starsGeo=new THREE.BufferGeometry();
const starCount=800;const starPos=new Float32Array(starCount*3);
for(let i=0;i<starCount*3;i++)starPos[i]=(Math.random()-.5)*60;
starsGeo.setAttribute('position',new THREE.BufferAttribute(starPos,3));
const starsMat=new THREE.PointsMaterial({color:0x8040a0,size:.05,transparent:true,opacity:.5});
const stars=new THREE.Points(starsGeo,starsMat);
scene.add(stars);

/* FLOOR REFLECTION */
const floorGeo=new THREE.PlaneGeometry(20,20);
const floorMat=new THREE.MeshStandardMaterial({color:0x0a0412,roughness:.95,metalness:.05});
const floor=new THREE.Mesh(floorGeo,floorMat);
floor.rotation.x=-Math.PI/2;floor.position.y=-2.2;floor.receiveShadow=true;
scene.add(floor);

/* BOOK GROUP */
const bookGroup=new THREE.Group();
scene.add(bookGroup);

/* BOOK GEOMETRY CONSTANTS */
const BOOK_W=1.5,BOOK_H=2.1,BOOK_D=0.12;
const PAGE_W=BOOK_W-.04,PAGE_H=BOOK_H-.06;

/* TEXTURES CACHE */
let pageTextures=[];
const textureLoader=new THREE.TextureLoader();
const defaultTex=(()=>{const c=document.createElement('canvas');c.width=512;c.height=700;const ctx=c.getContext('2d');ctx.fillStyle='#110818';ctx.fillRect(0,0,512,700);ctx.font='bold 72px Anton, sans-serif';ctx.textAlign='center';ctx.fillStyle='rgba(232,0,30,0.2)';ctx.fillText('M2S',256,380);return new THREE.CanvasTexture(c);})();

async function buildBookTextures(){
  pageTextures=[];
  for(let i=0;i<pages.length;i++){
    try{
      const tex=await new Promise((res,rej)=>{const t=new THREE.TextureLoader();t.load(pages[i].url,res,undefined,rej);});
      tex.flipY=true;
      pageTextures.push(tex);
    }catch(e){pageTextures.push(defaultTex);}
  }
  rebuildBook();
}

function clearBookTextures(){pageTextures=[];rebuildBook();}

/* BOOK MESHES */
let coverMesh=null,backMesh=null,spineMesh=null,pageMeshes=[];
let currentFlipMesh=null,flipTween=null;
let flipProgress=0,isFlipping=false,flipForward=true;

function rebuildBook(){
  // Clear
  while(bookGroup.children.length)bookGroup.remove(bookGroup.children[0]);
  pageMeshes=[];coverMesh=null;backMesh=null;spineMesh=null;currentFlipMesh=null;

  const hasPgs=pages.length>0;

  // SPINE
  const spineGeo=new THREE.BoxGeometry(BOOK_D,BOOK_H,.04);
  const spineMat=new THREE.MeshStandardMaterial({color:0x1a0510,roughness:.7,metalness:.15});
  spineMesh=new THREE.Mesh(spineGeo,spineMat);
  spineMesh.position.x=-BOOK_W/2;
  bookGroup.add(spineMesh);

  // BACK COVER
  const backGeo=new THREE.BoxGeometry(BOOK_W,BOOK_H,BOOK_D/2);
  const backMat=new THREE.MeshStandardMaterial({color:0x120a18,roughness:.75,metalness:.1});
  backMesh=new THREE.Mesh(backGeo,backMat);
  backMesh.position.set(0,0,-BOOK_D);
  backMesh.castShadow=true;backMesh.receiveShadow=true;
  bookGroup.add(backMesh);

  // PAGE STACK (static visual bulk)
  const stackGeo=new THREE.BoxGeometry(PAGE_W,PAGE_H,BOOK_D*.7);
  const stackMat=new THREE.MeshStandardMaterial({color:0xf0e8f0,roughness:.95,metalness:0});
  const stack=new THREE.Mesh(stackGeo,stackMat);
  stack.position.set(0,0,-BOOK_D*.2);
  bookGroup.add(stack);

  // FRONT COVER
  const coverTex=hasPgs&&pageTextures[0]?pageTextures[0]:defaultTex;
  const coverGeo=new THREE.BoxGeometry(BOOK_W,BOOK_H,BOOK_D*.4);
  const coverMats=[
    new THREE.MeshStandardMaterial({color:0x1a0414,roughness:.6,metalness:.2}),// right
    new THREE.MeshStandardMaterial({color:0x1a0414,roughness:.6,metalness:.2}),// left
    new THREE.MeshStandardMaterial({color:0x120810,roughness:.8}),// top
    new THREE.MeshStandardMaterial({color:0x120810,roughness:.8}),// bottom
    new THREE.MeshStandardMaterial({map:coverTex,roughness:.55,metalness:.05}),// front
    new THREE.MeshStandardMaterial({color:0x0e0610,roughness:.7}),// back
  ];
  coverMesh=new THREE.Mesh(coverGeo,coverMats);
  coverMesh.position.set(0,0,BOOK_D*.15);
  coverMesh.castShadow=true;
  bookGroup.add(coverMesh);

  // COVER EMBOSS LINES
  for(let i=0;i<3;i++){
    const lineGeo=new THREE.BoxGeometry(BOOK_W*.7-.1*i,0.004,.001);
    const lineMat=new THREE.MeshStandardMaterial({color:0xe8001e,roughness:.3,metalness:.8,emissive:0xe8001e,emissiveIntensity:.3});
    const line=new THREE.Mesh(lineGeo,lineMat);
    line.position.set(0,.7-i*.18,BOOK_D*.16+.002);
    bookGroup.add(line);
  }

  updateCurrentPage();
}

/* FLIPPING PAGE MESH */
function buildFlipPage(fromIdx,toIdx,forward){
  // Remove old flip mesh
  if(currentFlipMesh){bookGroup.remove(currentFlipMesh);currentFlipMesh=null;}

  const fromTex=(fromIdx>=0&&fromIdx<pageTextures.length)?pageTextures[fromIdx]:defaultTex;
  const toTex=(toIdx>=0&&toIdx<pageTextures.length)?pageTextures[toIdx]:defaultTex;

  const geo=new THREE.PlaneGeometry(PAGE_W,PAGE_H,32,1);
  const mat=[
    new THREE.MeshStandardMaterial({map:forward?fromTex:toTex,roughness:.6,side:THREE.FrontSide}),
    new THREE.MeshStandardMaterial({map:forward?toTex:fromTex,roughness:.6,side:THREE.BackSide,color:0xf5f0f5}),
  ];
  // Use a group with two planes for double-sided
  const group=new THREE.Group();
  const frontPlane=new THREE.Mesh(new THREE.PlaneGeometry(PAGE_W,PAGE_H,24,1),new THREE.MeshStandardMaterial({map:forward?fromTex:toTex,roughness:.6,metalness:.02,transparent:false}));
  const backPlane=new THREE.Mesh(new THREE.PlaneGeometry(PAGE_W,PAGE_H,24,1),new THREE.MeshStandardMaterial({map:forward?toTex:fromTex,roughness:.6,metalness:.02,color:0xf5f0f5}));
  backPlane.rotation.y=Math.PI;
  group.add(frontPlane);group.add(backPlane);

  // Position pivot at left edge of page
  group.position.set(-PAGE_W/2,0,BOOK_D*.1);
  // Offset geometry so pivot is at left
  frontPlane.position.x=PAGE_W/2;
  backPlane.position.x=PAGE_W/2;

  group.castShadow=true;
  bookGroup.add(group);
  currentFlipMesh=group;
  return group;
}

function updateCurrentPage(){
  if(!coverMesh)return;
  const idx=currentPageIdx;
  // Update cover texture to show current page
  if(pageTextures[idx]&&coverMesh.material[4]){
    coverMesh.material[4].map=pageTextures[idx];
    coverMesh.material[4].needsUpdate=true;
  }
}

/* PAGE NAVIGATION WITH FLIP ANIMATION */
function goToPage(idx){
  if(!pages.length)return;
  idx=Math.max(0,Math.min(idx,pages.length-1));
  if(idx===currentPageIdx)return;
  const forward=idx>currentPageIdx;
  animateFlip(currentPageIdx,idx,forward,()=>{
    currentPageIdx=idx;
    updateCurrentPage();
    updateHUD();
    updatePagesList();
    spawnParticles(forward);
  });
}

function flipNext(){if(currentPageIdx<pages.length-1)goToPage(currentPageIdx+1);}
function flipPrev(){if(currentPageIdx>0)goToPage(currentPageIdx-1);}

/* FLIP ANIMATION */
let flipAnim={active:false,from:0,to:0,progress:0,forward:true,startTime:0,duration:700,onDone:null};

function animateFlip(fromIdx,toIdx,forward,onDone){
  if(flipAnim.active)return;
  buildFlipPage(fromIdx,toIdx,forward);
  flipAnim={active:true,from:fromIdx,to:toIdx,progress:0,forward,startTime:performance.now(),duration:680,onDone};
}

function easeInOut(t){return t<.5?4*t*t*t:(t-1)*(2*t-2)*(2*t-2)+1;}
function easeOutBack(t){const c1=1.70158,c3=c1+1;return 1+c3*Math.pow(t-1,3)+c1*Math.pow(t-1,2);}

/* ============================================================ */
/* PARTICLE SYSTEM                                               */
/* ============================================================ */
const pCanvas=document.getElementById('particleCanvas');
pCanvas.width=innerWidth;pCanvas.height=innerHeight;
const pCtx=pCanvas.getContext('2d');
let particles=[];

function spawnParticles(forward){
  const cx=innerWidth/2+(forward?100:-100);const cy=innerHeight/2;
  for(let i=0;i<18;i++){
    const angle=Math.random()*Math.PI*2;
    const speed=.5+Math.random()*2.5;
    particles.push({x:cx,y:cy,vx:Math.cos(angle)*speed*(forward?1:-1),vy:Math.sin(angle)*speed-.5,
      life:1,decay:.015+Math.random()*.02,size:2+Math.random()*4,
      color:Math.random()<.5?'#e8001e':'#d4922a'});
  }
}

function updateParticles(){
  pCtx.clearRect(0,0,pCanvas.width,pCanvas.height);
  particles=particles.filter(p=>{
    p.x+=p.vx;p.y+=p.vy;p.vy+=.04;p.life-=p.decay;
    if(p.life<=0)return false;
    pCtx.globalAlpha=p.life;pCtx.fillStyle=p.color;
    pCtx.beginPath();pCtx.arc(p.x,p.y,p.size*p.life,0,Math.PI*2);pCtx.fill();
    return true;
  });
  pCtx.globalAlpha=1;
}

/* ============================================================ */
/* MOUSE / TOUCH ORBIT                                           */
/* ============================================================ */
let orbitState={active:false,x:0,y:0,rotX:-.12,rotY:.15,targetX:-.12,targetY:.15,zoom:5,targetZoom:5};

canvas.addEventListener('mousedown',e=>{if(e.button===0){orbitState.active=true;orbitState.x=e.clientX;orbitState.y=e.clientY;}});
canvas.addEventListener('mouseup',()=>orbitState.active=false);
canvas.addEventListener('mouseleave',()=>orbitState.active=false);
canvas.addEventListener('mousemove',e=>{
  if(!orbitState.active)return;
  const dx=(e.clientX-orbitState.x)*.004,dy=(e.clientY-orbitState.y)*.004;
  orbitState.targetY+=dx;orbitState.targetX+=dy;
  orbitState.targetX=Math.max(-Math.PI/3,Math.min(Math.PI/3,orbitState.targetX));
  orbitState.x=e.clientX;orbitState.y=e.clientY;
});
canvas.addEventListener('wheel',e=>{
  orbitState.targetZoom+=e.deltaY*.005;
  orbitState.targetZoom=Math.max(2.5,Math.min(8,orbitState.targetZoom));
},{passive:true});
// Touch
let lastTouch={x:0,y:0,dist:0};
canvas.addEventListener('touchstart',e=>{const t=e.touches[0];orbitState.active=true;orbitState.x=lastTouch.x=t.clientX;orbitState.y=lastTouch.y=t.clientY;},{passive:true});
canvas.addEventListener('touchmove',e=>{
  if(e.touches.length===2){
    const dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY;
    const dist=Math.sqrt(dx*dx+dy*dy);
    orbitState.targetZoom-=(dist-lastTouch.dist)*.008;
    orbitState.targetZoom=Math.max(2.5,Math.min(8,orbitState.targetZoom));
    lastTouch.dist=dist;return;
  }
  const t=e.touches[0];
  const ddx=(t.clientX-lastTouch.x)*.004,ddy=(t.clientY-lastTouch.y)*.004;
  orbitState.targetY+=ddx;orbitState.targetX+=ddy;
  orbitState.targetX=Math.max(-Math.PI/3,Math.min(Math.PI/3,orbitState.targetX));
  lastTouch.x=t.clientX;lastTouch.y=t.clientY;
},{passive:true});
canvas.addEventListener('touchend',()=>orbitState.active=false,{passive:true});

/* KEYBOARD */
window.addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT')return;
  if(e.key==='ArrowRight'||e.key==='ArrowDown')flipNext();
  if(e.key==='ArrowLeft'||e.key==='ArrowUp')flipPrev();
  if(e.key===' '){e.preventDefault();toggleAutoFlip();}
  if(e.key==='Home')goToPage(0);
  if(e.key==='End')goToPage(pages.length-1);
});

/* ============================================================ */
/* 3D VIEW TOGGLE                                               */
/* ============================================================ */
let flatView=false;
function toggle3DView(){
  flatView=!flatView;
  if(flatView){
    orbitState.targetX=0;orbitState.targetY=0;orbitState.targetZoom=3.2;
    showToast('📄  Flat view — straight-on reading');
  } else {
    orbitState.targetX=-.12;orbitState.targetY=.15;
    showToast('📚  3D perspective mode');
  }
}

/* ============================================================ */
/* AMBIENT BOOK FLOAT                                            */
/* ============================================================ */
let floatTime=0;

/* ============================================================ */
/* MAIN RENDER LOOP                                              */
/* ============================================================ */
function render(now){
  requestAnimationFrame(render);

  // Orbit lerp
  orbitState.rotX+=(orbitState.targetX-orbitState.rotX)*.06;
  orbitState.rotY+=(orbitState.targetY-orbitState.rotY)*.06;
  orbitState.zoom+=(orbitState.targetZoom-orbitState.zoom)*.06;
  camera.position.x=Math.sin(orbitState.rotY)*orbitState.zoom*Math.cos(orbitState.rotX);
  camera.position.y=Math.sin(orbitState.rotX)*orbitState.zoom;
  camera.position.z=Math.cos(orbitState.rotY)*orbitState.zoom*Math.cos(orbitState.rotX);
  camera.lookAt(0,0,0);

  // Book float
  floatTime+=.012;
  if(bookGroup){
    bookGroup.position.y=Math.sin(floatTime)*.04;
    bookGroup.rotation.z=Math.sin(floatTime*.7)*.008;
  }

  // Stars drift
  stars.rotation.y+=.0002;stars.rotation.x+=.0001;

  // Flip animation
  if(flipAnim.active&&currentFlipMesh){
    const elapsed=now-flipAnim.startTime;
    const t=Math.min(elapsed/flipAnim.duration,1);
    const eased=easeInOut(t);
    // Rotate around Y axis: 0 → -PI (forward flip) or 0 → PI (backward flip)
    const targetRot=flipAnim.forward?-Math.PI:Math.PI;
    currentFlipMesh.rotation.y=targetRot*eased;

    // Page curl — deform vertices during flip
    const geo=currentFlipMesh.children[0]?.geometry;
    if(geo){
      const pos=geo.attributes.position;
      for(let i=0;i<pos.count;i++){
        const x=pos.getX(i);
        const normX=(x+PAGE_W/2)/PAGE_W; // 0..1 from left to right
        const curlAmt=Math.sin(eased*Math.PI)*0.12;
        const curlZ=Math.sin(normX*Math.PI)*curlAmt*(flipAnim.forward?1:-1);
        pos.setZ(i,curlZ);
      }
      pos.needsUpdate=true;geo.computeVertexNormals();
    }

    // Halfway — update cover texture
    if(t>=.5&&!flipAnim.halfDone){
      flipAnim.halfDone=true;
      updateCurrentPage();
    }

    if(t>=1){
      flipAnim.active=false;flipAnim.halfDone=false;
      bookGroup.remove(currentFlipMesh);currentFlipMesh=null;
      if(flipAnim.onDone)flipAnim.onDone();
    }
  }

  // Particles
  updateParticles();

  renderer.render(scene,camera);
}

/* ============================================================ */
/* RESIZE                                                        */
/* ============================================================ */
window.addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
  pCanvas.width=innerWidth;pCanvas.height=innerHeight;
});

/* ============================================================ */
/* INIT                                                           */
/* ============================================================ */
rebuildBook();
updateHUD();
requestAnimationFrame(render);

// Auto-load demo after load screen
setTimeout(()=>{
  loadDemoPages();
},1800);
</script>
