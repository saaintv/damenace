"use client";

import { useState }
from "react";

export default function MusicMenu(){

  const [open,setOpen] =
  useState(false);

  return(

    <>

      <button

      onClick={()=>
        setOpen(!open)
      }

      className="musicButton"

      >

      MUSIC

      </button>

      {

        open && (

          <div className="musicPanel">

            <h2>
              Music Menu
            </h2>

            <button>

              Login With Spotify

            </button>

            <button>

              Login With Apple Music

            </button>

            <div>

              Playlist Area

            </div>

            <div>

              Player Controls

            </div>

          </div>
        )
      }
    </>
  );
}

