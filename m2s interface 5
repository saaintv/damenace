function updateCartQty(key, d) { const i = cart.find(x => x.key === key); if (i) { i.qty += d; if (i.qty <= 0) cart = cart.filter(x => x.key !== key); } renderCart(); }
function removeCartItem(key) { cart = cart.filter(x => x.key !== key); renderCart(); }

function renderCart() {
  const total = cart.reduce((s, i) => s + i.qty, 0);
  document.getElementById('cartCount').textContent = total;
  document.getElementById('cartMeta').textContent = total + ' item' + (total !== 1 ? 's' : '');
  const el = document.getElementById('cartItems');
  if (!cart.length) { el.innerHTML = '<div class="cart-empty"><span class="cart-empty-icon">🛍</span><div class="cart-empty-text">CART IS EMPTY</div></div>'; document.getElementById('cartSummary').innerHTML = ''; return; }
  el.innerHTML = cart.map(item => `
    <div class="cart-item">
      <img class="cart-item-img" src="${item.img}" alt="${esc(item.name)}" onerror="this.style.display='none'">
      <div class="cart-item-body">
        <div class="cart-item-coll">${esc(item.collection)}</div>
        <div class="cart-item-name">${esc(item.name)}</div>
        <div class="cart-item-variant"><span class="cart-item-color-dot" style="background:${item.colorHex}"></span>${esc(item.colorName)} · ${esc(item.size)}</div>
        <div class="cart-item-row">
          <div class="cart-qty">
            <button class="cart-qty-btn" onclick="updateCartQty('${item.key}',-1)">−</button>
            <input class="cart-qty-num" value="${item.qty}" readonly>
            <button class="cart-qty-btn" onclick="updateCartQty('${item.key}',1)">+</button>
          </div>
          <span class="cart-item-price">$${(item.price * item.qty).toFixed(2)}</span>
          <button class="cart-rm" onclick="removeCartItem('${item.key}')">✕</button>
        </div>
      </div>
    </div>`).join('');
  const sub = cart.reduce((s, i) => s + i.price * i.qty, 0);
  const disc = promoDiscount ? sub * promoDiscount : 0;
  const ship = sub > 150 ? 0 : 9.95;
  const total2 = sub - disc + ship;
  document.getElementById('cartSummary').innerHTML = `
    <div class="cart-sum-row"><span>SUBTOTAL</span><span>$${sub.toFixed(2)}</span></div>
    ${disc ? `<div class="cart-sum-row" style="color:var(--gold-3);"><span>PROMO (${esc(promoCode)})</span><span>−$${disc.toFixed(2)}</span></div>` : ''}
    <div class="cart-sum-row"><span>SHIPPING</span><span>${ship === 0 ? 'FREE' : '$' + ship.toFixed(2)}</span></div>
    <div class="cart-sum-total"><span>TOTAL</span><span>$${total2.toFixed(2)}</span></div>`;
}

function applyPromo() {
  const code = document.getElementById('promoInput').value.trim().toUpperCase();
  const codes = { MENACE20: .2, FEAR10: .1, CHAOS15: .15 };
  if (codes[code]) { promoDiscount = codes[code]; promoCode = code; renderCart(); toast('🎉','Promo Applied',`${Math.round(codes[code]*100)}% discount applied`,'payment'); }
  else toast('❌','Invalid Code','That promo code is not valid','stock_warning');
}

