  const descs = mode === 'Character Sheet'
    ? [`Full body character sheet. ${base}. ${sfx}. Front view.`,`Side profile. ${base}. ${sfx}.`,`Action pose. ${base}. ${sfx}.`,`Close-up face. ${base}. ${sfx}.`]
    : [`Panel 1 establishing shot. ${base}. ${sfx}.`,`Panel 2 emotional close-up. ${base}. ${sfx}.`,`Panel 3 action moment. ${base}. ${sfx}.`,`Panel 4 cinematic finale. ${base}. ${sfx}.`];

  box.innerHTML = `<div class="panel-grid" id="comicPanelGrid" style="padding:16px;width:100%;">${descs.map((_,i) => `<div class="panel-cell" id="apanel${i}"><div class="spinner" style="width:28px;height:28px;"></div></div>`).join('')}</div>`;

  const urls = descs.map((d,i) => polURL(d, 1000 + i * 777));
  urls.forEach((url, i) => {
    const img = new Image();
    img.onload = () => {
      const el = document.getElementById('apanel' + i);
      if (el) el.innerHTML = `<img src="${url}"><div class="panel-label">PANEL ${i+1}</div>`;
    };
    img.onerror = () => { const el = document.getElementById('apanel' + i); if (el) el.textContent = `PANEL ${i+1} FAILED`; };
    img.src = url;
  });
}

function saveToReader() { toast('📖','Saved','Connect comic reader to save generated panels','announcement'); }

function generateStoryline() {
  const char    = document.getElementById('storyChar').value.trim() || 'DaMenace';
  const genre   = document.getElementById('storyGenre').value;
  const numArcs = parseInt(document.getElementById('storyArcs').value) || 3;
  const setting = document.getElementById('storySetting').value.trim() || 'Houston 2040';
  const theme   = document.getElementById('storyTheme').value.trim() || 'identity and survival';
  const box     = document.getElementById('storylinePreview');
  box.innerHTML = loadingHTML('BUILDING UNIVERSE...');
  setTimeout(() => {
    const arcDefs = [
      `${char} discovers their true nature in ${setting}. Everything unravels. ${theme} becomes the driving force as they face their darkest shadow.`,
      `Betrayal from within. ${char} loses everything. Former allies reveal their true agenda. ${genre} turns against them.`,
      `From the ruins, ${char} rebuilds. ${setting} becomes hunting ground. A new identity forged on ${theme}.`,
      `All forces unite against ${char}. Epic confrontation. ${genre} at its peak. Survival not guaranteed.`,
      `${char} transcends mortal limits. The final truth about ${theme} revealed. The cycle begins again.`,
      `A fractured mirror dimension opens. ${char} faces their alternate self — the version who chose differently.`,
      `All timelines converge. ${char} must unite enemies, ghosts, and allies for one final war.`,
    ].slice(0, numArcs);
    box.innerHTML = `<div style="padding:28px;width:100%;">
      <div style="font-family:var(--display);font-size:2.2rem;letter-spacing:4px;margin-bottom:4px;">${esc(char).toUpperCase()}</div>
      <div style="font-size:.62rem;letter-spacing:4px;color:var(--red);text-transform:uppercase;margin-bottom:28px;">${esc(genre)} · ${esc(setting)} · ${numArcs} ARC UNIVERSE</div>
      <div class="storyboard">${arcDefs.map((d,i) => {
        const titles = ['ORIGIN','THE FALL','CHAOS REBORN','THE RECKONING','ASCENSION','MIRROR WORLD','FINAL WAR'];
        return `<div class="story-block"><h3>ARC ${i+1}: ${titles[i]||'ARC '+( i+1)}</h3><p>${esc(d)}</p></div>`;
      }).join('')}</div>
    </div>`;
  }, 1200);
}

function exportStoryPDF() { toast('⬇️','Export','Integrate jsPDF for full PDF output','announcement'); }

function generateCharacter() {
  const name   = document.getElementById('charName').value.trim() || 'DaMenace';
  const faction= document.getElementById('charFaction').value.trim() || 'Unknown';
  const appear = document.getElementById('charAppearance').value.trim();
  const powers = document.getElementById('charPowers').value.trim();
  const lore   = document.getElementById('charLore').value.trim();
  const box    = document.getElementById('charPreview');
  box.innerHTML = loadingHTML('BUILDING CHARACTER...');
  setTimeout(() => {
    box.innerHTML = `<div style="padding:28px;width:100%;">
      <div style="font-family:var(--display);font-size:2.5rem;letter-spacing:5px;margin-bottom:4px;">${esc(name).toUpperCase()}</div>
      <div style="font-size:.6rem;letter-spacing:4px;color:var(--red);text-transform:uppercase;margin-bottom:20px;">FACTION: ${esc(faction).toUpperCase()}</div>
      ${appear ? `<div class="story-block"><h3>APPEARANCE</h3><p>${esc(appear)}</p></div>` : ''}
      ${powers ? `<div class="story-block"><h3>ABILITIES</h3><p>${esc(powers)}</p></div>` : ''}
      ${lore   ? `<div class="story-block"><h3>ORIGIN</h3><p>${esc(lore)}</p></div>` : ''}
      <img src="${polURL(`Full body character art of ${name}, ${appear||'dark mysterious figure'}, ${powers?'with powers: '+powers:''}, dark grunge cinematic style, comic book character sheet`)}" style="width:100%;margin-top:16px;" loading="lazy" onerror="this.style.display='none'">
