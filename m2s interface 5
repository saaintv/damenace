  restock:      { color: '#3060c0', icon: '♻️' },
  stock_warning:{ color: '#d08020', icon: '⚠️' },
  announcement: { color: '#9030c0', icon: '📣' },
  default:      { color: '#c8001a', icon: '🔔' },
};

let toastId = 0;
function toast(icon, title, message, type = 'default', duration = 5000) {
  const id = 'toast-' + (++toastId);
  const color = TYPE_CFG[type]?.color || TYPE_CFG.default.color;
  const el = document.createElement('div');
  el.className = 'toast'; el.id = id;
  el.style.setProperty('--tc', color);
  el.innerHTML = `
    <span class="toast-icon">${icon}</span>
    <div class="toast-body">
      <div class="toast-ttl">${esc(title)}</div>
      <div class="toast-txt">${esc(message)}</div>
    </div>
    <button class="toast-close" onclick="dismissToast('${id}')">✕</button>
    <div class="toast-bar" id="${id}-bar" style="width:100%;"></div>`;
  document.getElementById('toastStack').appendChild(el);
  requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('show')));
  // Progress bar
  const bar = document.getElementById(id + '-bar');
  const start = Date.now();
  const tick = () => { const pct = Math.max(0, 100 - ((Date.now() - start) / duration) * 100); if (bar) bar.style.width = pct + '%'; if (pct > 0) requestAnimationFrame(tick); };
  requestAnimationFrame(tick);
  setTimeout(() => dismissToast(id), duration);
  const toasts = document.querySelectorAll('.toast');
  if (toasts.length > 5) dismissToast(toasts[0].id);
}
function dismissToast(id) {
  const el = document.getElementById(id); if (!el) return;
  el.classList.add('exit'); setTimeout(() => el.remove(), 400);
}

