let drops = [
  { id: uid(), name: 'SUMMER COLLECTION 2026', date: new Date(Date.now() + 7 * 86400000).toISOString() },
  { id: uid(), name: 'MENACE ORIGINS DROP',    date: new Date(Date.now() + 21 * 86400000).toISOString() },
];
let activeDrop = null, countdownInterval = null;

function renderDrops() {
  const sel = document.getElementById('dropSelector');
  sel.innerHTML = '<option value="">— Select Drop —</option>' + drops.map(d => `<option value="${d.id}">${esc(d.name)}</option>`).join('');
  document.getElementById('dropsList').innerHTML = drops.map(d => {
    const isPast = new Date(d.date) <= new Date();
    return `<div class="drop-item">
      <div><div class="drop-item-name">${esc(d.name)}</div><div class="drop-item-date">${new Date(d.date).toLocaleString()}</div></div>
      <span class="drop-status ${isPast?'drop-live':'drop-upcoming'}">${isPast?'LIVE':'UPCOMING'}</span>
      <button onclick="removeDrop('${d.id}')" class="btn btn-ghost btn-xs">REMOVE</button>
    </div>`;
  }).join('');
  if (drops.length) selectDrop(drops[0].id);
}

function selectDrop(id) {
  const d = drops.find(x => x.id === id); if (!d) return;
  activeDrop = d;
  document.getElementById('dropActiveName').textContent = d.name;
  document.getElementById('dropActiveDate').textContent = new Date(d.date).toLocaleString();
  startCountdown();
}

function startCountdown() {
  clearInterval(countdownInterval);
  countdownInterval = setInterval(() => {
    if (!activeDrop) return;
    const diff = new Date(activeDrop.date) - Date.now();
    if (diff <= 0) { ['cdD','cdH','cdM','cdS'].forEach(id => document.getElementById(id).textContent = '00'); clearInterval(countdownInterval); return; }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('cdD').textContent = String(d).padStart(2,'0');
    document.getElementById('cdH').textContent = String(h).padStart(2,'0');
    document.getElementById('cdM').textContent = String(m).padStart(2,'0');
    document.getElementById('cdS').textContent = String(s).padStart(2,'0');
  }, 1000);
}

function removeDrop(id) { drops = drops.filter(d => d.id !== id); renderDrops(); }

function openScheduleModal() {
  const name = prompt('Drop name:'); if (!name) return;
  const dateStr = prompt('Drop date/time (YYYY-MM-DDTHH:MM):'); if (!dateStr) return;
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) { toast('❌','Invalid Date','Enter a valid date format','stock_warning'); return; }
  drops.push({ id: uid(), name: name.trim(), date: date.toISOString() });
  renderDrops();
  toast('⏰','Drop Scheduled', name + ' scheduled for ' + date.toLocaleString(), 'announcement');
  pushNotif('⏰ DROP SCHEDULED', name + ' — ' + date.toLocaleDateString(), 'announcement');
}

