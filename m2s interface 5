function renderNotifs() {
  const list = document.getElementById('notifList');
  const unread = notifications.filter(n => !n.read).length;
  const badge = document.getElementById('notifBadge');
  badge.textContent = unread > 99 ? '99+' : unread;
  badge.classList.toggle('show', unread > 0);
  if (!notifications.length) { list.innerHTML = '<div class="notif-empty">No notifications</div>'; return; }
  list.innerHTML = notifications.slice(0, 20).map(n => `
    <div class="notif-item ${n.read ? '' : 'unread'}" onclick="readNotif('${n.id}')">
      <div class="notif-icon" style="background:${TYPE_CFG[n.type]?.color || TYPE_CFG.default.color}22;border:1px solid ${TYPE_CFG[n.type]?.color || TYPE_CFG.default.color}33;">${TYPE_CFG[n.type]?.icon || '🔔'}</div>
