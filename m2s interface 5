<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MENACE 2 SOCIETY — UNIVERSE</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,900;1,300;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<style>
/* ═══════════════════════════════════════════════════════════════════
   DESIGN TOKENS — single source of truth for all styling
═══════════════════════════════════════════════════════════════════ */
:root {
  /* Core palette */
  --ink:        #030205;
  --ink-2:      #07040c;
  --ink-3:      #0e0915;
  --ink-4:      #16101f;
  --surface:    #1c1428;
  --surface-2:  #241c32;
  --surface-3:  #2c243c;

  /* Accent system */
  --red:        #c8001a;
  --red-2:      #e8001e;
  --red-3:      #ff1e38;
  --red-glow:   rgba(200,0,26,.16);
  --red-dim:    rgba(200,0,26,.07);

  /* Secondary accents */
  --gold:       #c07828;
  --gold-2:     #d89040;
  --gold-3:     #f0b060;
  --silver:     #8090a0;
  --silver-2:   #b0c0d0;

  /* Text hierarchy */
  --text:       #f0e8f5;
  --text-2:     #b8a8c8;
  --text-3:     #7860a0;
  --text-4:     #3c2c54;

  /* Borders */
  --b:          rgba(200,0,26,.12);
  --b-2:        rgba(200,0,26,.24);
  --b-3:        rgba(200,0,26,.44);

  /* Status */
  --ok:         #1aaa4a;
  --warn:       #d08020;
  --info:       #4a80e0;

  /* Radius */
  --r:          2px;

  /* Type scale */
  --display:    'Anton', sans-serif;
  --heading:    'Bebas Neue', sans-serif;
  --body:       'Montserrat', sans-serif;
  --mono:       'Space Mono', monospace;

  /* Transitions */
  --ease:       cubic-bezier(.25,.46,.45,.94);
  --spring:     cubic-bezier(.34,1.56,.64,1);
}

/* ═══════════════════════════════════════════════════════════════════
   RESET & BASE
═══════════════════════════════════════════════════════════════════ */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

html { font-size:15px; scroll-behavior:smooth; height:100%; }

body {
  background: var(--ink);
  color: var(--text);
  font-family: var(--body);
  overflow-x: hidden;
  min-height: 100vh;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* Atmospheric background */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 50% at 85% 5%, rgba(200,0,26,.06) 0%, transparent 60%),
    radial-gradient(ellipse 50% 70% at 5% 90%, rgba(192,120,40,.04) 0%, transparent 60%),
    radial-gradient(ellipse 40% 40% at 50% 50%, rgba(100,50,160,.03) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* Film grain texture */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  opacity: .38;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.88' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");
}

/* Scrollbar */
::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: var(--ink-2); }
::-webkit-scrollbar-thumb { background: var(--red); }

/* ═══════════════════════════════════════════════════════════════════
   BACKGROUND CANVAS
═══════════════════════════════════════════════════════════════════ */
#bg-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: .18;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════════
   NAVIGATION
═══════════════════════════════════════════════════════════════════ */
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 64px;
  z-index: 800;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5%;
  background: rgba(3,2,5,.85);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--b);
  transition: background .3s;
}

.nav-logo {
  font-family: var(--display);
  font-size: 1.5rem;
  letter-spacing: 5px;
  color: var(--text);
  cursor: pointer;
  flex-shrink: 0;
}
.nav-logo span { color: var(--red-2); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 0;
  list-style: none;
}

.nav-link {
  padding: 0 14px;
  height: 64px;
  display: flex;
  align-items: center;
  font-size: .66rem;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--text-3);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: color .2s, border-color .2s;
  white-space: nowrap;
}
.nav-link:hover { color: var(--text-2); }
.nav-link.active { color: var(--text); border-bottom-color: var(--red); }

.nav-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.nav-icon {
  width: 38px; height: 38px;
  display: flex; align-items: center; justify-content: center;
  background: none;
  border: 1px solid var(--b);
  color: var(--text-3);
  cursor: pointer;
  font-size: .95rem;
  transition: .2s;
  position: relative;
}
.nav-icon:hover { border-color: var(--b-2); color: var(--text-2); }

.notification-badge {
  position: absolute;
  top: -4px; right: -4px;
  background: var(--red);
  color: white;
  min-width: 16px; height: 16px;
  border-radius: 8px;
  font-size: .52rem;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  padding: 0 3px;
  border: 2px solid var(--ink);
  display: none;
}
.notification-badge.show { display: flex; }

.cart-btn {
  padding: 0 14px;
  height: 38px;
  background: none;
  border: 1px solid var(--b-2);
  color: var(--text);
  font-family: var(--body);
  font-size: .66rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: .2s;
  display: flex; align-items: center; gap: 7px;
}
.cart-btn:hover { border-color: var(--red); color: var(--red-2); }

.hamburger {
  display: none;
  flex-direction: column;
  gap: 4px;
  cursor: pointer;
  padding: 8px;
  background: none;
  border: none;
}
.hamburger span {
  width: 22px; height: 1.5px;
  background: var(--text-2);
  transition: .3s;
  display: block;
}

/* ═══════════════════════════════════════════════════════════════════
   PAGE SYSTEM
═══════════════════════════════════════════════════════════════════ */
.page { display: none; min-height: 100vh; position: relative; z-index: 1; }
.page.active { display: block; }

/* ═══════════════════════════════════════════════════════════════════
   UTILITY CLASSES
═══════════════════════════════════════════════════════════════════ */
.section { padding: 100px 5%; }
.section-sm { padding: 60px 5%; }
.section-alt { background: var(--ink-2); }

.eyebrow {
  font-size: .6rem;
  letter-spacing: 6px;
  color: var(--red-2);
  text-transform: uppercase;
  display: block;
  margin-bottom: 10px;
}

.display-title {
  font-family: var(--display);
  font-size: clamp(2.5rem,6vw,5rem);
  letter-spacing: 3px;
  text-transform: uppercase;
  line-height: .92;
  margin-bottom: 50px;
}
.display-title span { color: var(--red-2); }

.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
.grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
.grid-auto { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 18px; }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 13px 28px;
  font-family: var(--body);
  font-size: .68rem; font-weight: 700;
  letter-spacing: 2.5px; text-transform: uppercase;
  cursor: pointer;
  transition: .22s var(--ease);
  border: none; text-decoration: none;
}
.btn-primary { background: var(--red); color: white; }
.btn-primary:hover { background: var(--red-2); transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--text); border: 1px solid rgba(255,255,255,.16); }
.btn-ghost:hover { border-color: var(--red); color: var(--red-2); }
.btn-gold { background: var(--gold); color: var(--ink); font-weight: 900; }
.btn-gold:hover { background: var(--gold-2); }
.btn-sm { padding: 9px 18px; font-size: .6rem; letter-spacing: 1.5px; }
.btn-xs { padding: 6px 12px; font-size: .58rem; }

/* Fade-in animation */
.fade-up {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity .7s var(--ease), transform .7s var(--ease);
}
.fade-up.in { opacity: 1; transform: translateY(0); }

/* ═══════════════════════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════════════════════ */
.hero {
  height: 100vh;
  display: flex; align-items: center; justify-content: center;
  text-align: center;
  position: relative; overflow: hidden;
}

.hero-bg {
  position: absolute; inset: 0;
  background:
    linear-gradient(rgba(3,2,5,.5), rgba(3,2,5,.7)),
    url('https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1600&auto=format&fit=crop') center/cover;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
  animation: orbFloat 10s ease-in-out infinite;
}
.hero-orb-1 { width: 600px; height: 600px; background: rgba(200,0,26,.1); top: -15%; right: -10%; }
.hero-orb-2 { width: 400px; height: 400px; background: rgba(192,120,40,.06); bottom: -10%; left: -5%; animation-delay: -4s; }

@keyframes orbFloat {
  0%,100% { transform: translate(0,0) scale(1); }
  33%      { transform: translate(-20px,15px) scale(1.05); }
  66%      { transform: translate(15px,-10px) scale(.97); }
}

.hero-content {
  position: relative; z-index: 2;
  padding: 20px;
  animation: heroReveal 1.2s var(--ease) both;
}

@keyframes heroReveal {
  from { opacity: 0; transform: translateY(50px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero-kicker {
  font-family: var(--mono);
  font-size: .65rem;
  letter-spacing: 5px;
  color: var(--red-2);
  text-transform: uppercase;
  display: block;
  margin-bottom: 22px;
  animation: heroReveal 1.2s .15s var(--ease) both;
}

.hero-h1 {
  font-family: var(--display);
  font-size: clamp(4.5rem,12vw,11rem);
  line-height: .88;
  letter-spacing: 2px;
  text-transform: uppercase;
  animation: heroReveal 1.2s .2s var(--ease) both;
}
.hero-h1 .line-red { color: var(--red-2); display: block; }

.hero-sub {
  margin-top: 26px;
  font-size: .76rem;
  letter-spacing: 4px;
  color: var(--text-3);
  text-transform: uppercase;
  animation: heroReveal 1.2s .35s var(--ease) both;
}

.hero-btns {
  margin-top: 44px;
  display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;
  animation: heroReveal 1.2s .5s var(--ease) both;
}

.scroll-cue {
  position: absolute;
  bottom: 30px; left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  color: var(--text-4);
  font-size: .58rem; letter-spacing: 3px; text-transform: uppercase;
  animation: scrollBob 2.5s ease-in-out infinite;
}
.scroll-cue::before {
  content: '';
  width: 1px; height: 36px;
  background: linear-gradient(var(--red), transparent);
}
@keyframes scrollBob {
  0%,100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(8px); }
}

/* TICKER */
.ticker {
  background: var(--red);
  padding: 11px 0;
  overflow: hidden;
  white-space: nowrap;
  position: relative; z-index: 2;
}
.ticker-track {
  display: inline-flex;
  animation: tickerScroll 24s linear infinite;
}
.ticker-item {
  font-family: var(--display);
  font-size: .8rem;
  letter-spacing: 4px;
  margin: 0 24px;
  opacity: .9;
}
@keyframes tickerScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ═══════════════════════════════════════════════════════════════════
   SHOP / CATALOG
═══════════════════════════════════════════════════════════════════ */
.shop-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 36px;
  flex-wrap: wrap;
  gap: 16px;
  padding-bottom: 22px;
  border-bottom: 1px solid var(--b);
}

.collection-tabs {
  display: flex; gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.collection-tabs::-webkit-scrollbar { display: none; }

.coll-tab {
  padding: 8px 16px;
  font-size: .62rem; font-weight: 700; letter-spacing: 2px;
  text-transform: uppercase; color: var(--text-3);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: .18s; white-space: nowrap;
}
.coll-tab:hover { color: var(--text-2); }
.coll-tab.active { color: var(--red-2); border-bottom-color: var(--red); }

.sort-row { display: flex; align-items: center; gap: 10px; }

.sort-select {
  background: var(--surface);
  border: 1px solid var(--b);
  color: var(--text-2);
  padding: 8px 12px;
  font-family: var(--body); font-size: .68rem;
  cursor: pointer;
}
.sort-select:focus { outline: none; border-color: var(--b-2); }

.results-count { font-size: .65rem; letter-spacing: 2px; color: var(--text-3); }

/* Product card */
.product-card {
  background: var(--ink-3);
  border: 1px solid var(--b);
  overflow: hidden;
  cursor: pointer;
  transition: border-color .25s, transform .25s;
  position: relative;
  display: flex; flex-direction: column;
}
.product-card:hover { border-color: var(--b-2); transform: translateY(-4px); }

.product-img-wrap { position: relative; overflow: hidden; }
.product-img-wrap img {
  width: 100%; height: 340px;
  object-fit: cover;
  display: block;
  transition: transform .55s var(--ease);
}
.product-card:hover .product-img-wrap img { transform: scale(1.04); }

.product-badge {
  position: absolute;
  top: 12px; left: 12px;
  padding: 3px 9px;
  font-size: .56rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
}
.badge-new  { background: var(--gold);  color: var(--ink); }
.badge-low  { background: rgba(208,128,32,.85); color: white; }
.badge-sold { background: rgba(0,0,0,.7); color: var(--text-3); border: 1px solid var(--b); }

.product-colors {
  position: absolute;
  bottom: 12px; left: 12px;
  display: flex; gap: 5px;
  opacity: 0; transform: translateY(6px);
  transition: .2s;
}
.product-card:hover .product-colors { opacity: 1; transform: translateY(0); }

.color-dot {
  width: 16px; height: 16px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,.25);
  cursor: pointer;
  transition: .15s;
}
.color-dot:hover { transform: scale(1.3); border-color: white; }
.color-dot.selected { border-color: white; }

.product-body { padding: 18px 20px 22px; flex: 1; display: flex; flex-direction: column; gap: 5px; }
.product-collection { font-size: .58rem; letter-spacing: 3px; color: var(--red); text-transform: uppercase; }
.product-name { font-family: var(--heading); font-size: 1.3rem; letter-spacing: 2px; line-height: 1.1; }
.product-desc { font-size: .7rem; color: var(--text-3); line-height: 1.55; flex: 1; }
.product-price-row { display: flex; align-items: baseline; gap: 10px; margin-top: 4px; }
.product-price { font-family: var(--display); font-size: 1.25rem; }
.product-price-orig { font-size: .82rem; color: var(--text-4); text-decoration: line-through; }
.product-price-save { font-size: .6rem; font-weight: 700; color: var(--gold-3); letter-spacing: 1px; }
.product-stock { font-size: .58rem; letter-spacing: 2px; font-weight: 700; padding: 2px 7px; }
.stock-ok   { background: rgba(26,170,74,.12);  color: #44e88a; border: 1px solid rgba(26,170,74,.25); }
.stock-low  { background: rgba(208,128,32,.12); color: var(--gold-3); border: 1px solid rgba(208,128,32,.25); }
.stock-out  { background: rgba(200,0,26,.08); color: var(--red-3); border: 1px solid var(--b); }

.product-add {
  margin-top: 10px;
  padding: 11px;
  background: var(--red);
  border: none; color: white;
  font-family: var(--body); font-size: .62rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
  cursor: pointer; transition: .2s; width: 100%;
}
.product-add:hover { background: var(--red-2); }
.product-add:disabled { background: var(--surface-2); color: var(--text-4); cursor: not-allowed; }

/* ═══════════════════════════════════════════════════════════════════
   INVENTORY / ADMIN
═══════════════════════════════════════════════════════════════════ */
.admin-grid { display: grid; grid-template-columns: 260px 1fr; gap: 24px; align-items: start; }

.admin-sidebar { position: sticky; top: 84px; }

.admin-nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 12px 16px;
  font-size: .7rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--text-3); cursor: pointer;
  border-left: 2px solid transparent;
  transition: .15s;
}
.admin-nav-item:hover { color: var(--text-2); background: var(--red-dim); }
.admin-nav-item.active { color: var(--red-2); border-left-color: var(--red); background: var(--red-dim); }

.admin-panel { display: none; }
.admin-panel.active { display: block; }

/* Stats row */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px,1fr)); gap: 12px; margin-bottom: 28px; }
.stat-card { background: var(--surface); border: 1px solid var(--b); padding: 18px 20px; position: relative; overflow: hidden; }
.stat-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background: var(--c,var(--red)); }
.stat-label { font-size: .58rem; letter-spacing: 3px; text-transform: uppercase; color: var(--text-3); margin-bottom: 5px; }
.stat-value { font-family: var(--display); font-size: 2rem; letter-spacing: 2px; }
.stat-value.red   { color: var(--red-2); }
.stat-value.gold  { color: var(--gold-2); }
.stat-value.green { color: #44e88a; }

/* Table */
.data-table { width: 100%; border-collapse: collapse; font-size: .74rem; }
.data-table th { text-align: left; padding: 9px 14px; border-bottom: 1px solid var(--b); font-size: .58rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-4); white-space: nowrap; }
.data-table td { padding: 11px 14px; border-bottom: 1px solid rgba(255,255,255,.03); vertical-align: middle; }
.data-table tr:hover td { background: var(--red-dim); }

/* Upload zone */
.upload-zone {
  border: 1.5px dashed var(--b-2);
  padding: 36px 24px;
  text-align: center;
  cursor: pointer;
  transition: .25s;
  background: var(--surface);
}
.upload-zone:hover, .upload-zone.drag { border-color: var(--red-2); background: var(--red-dim); }
.upload-zone-icon { font-size: 2.4rem; display: block; margin-bottom: 10px; }
.upload-zone-title { font-family: var(--heading); font-size: 1.3rem; letter-spacing: 2px; margin-bottom: 6px; }
.upload-zone-sub { font-size: .7rem; color: var(--text-3); line-height: 1.6; }

/* Form elements */
.form-group { display: flex; flex-direction: column; gap: 6px; }
.form-label { font-size: .6rem; letter-spacing: 3px; text-transform: uppercase; color: var(--text-3); }
.form-input, .form-textarea, .form-select {
  background: var(--ink-3);
  border: 1px solid var(--b);
  color: var(--text);
  padding: 11px 14px;
  font-family: var(--body); font-size: .82rem;
  width: 100%;
  transition: border-color .2s;
}
.form-input:focus, .form-textarea:focus, .form-select:focus { outline: none; border-color: var(--b-2); }
.form-input::placeholder, .form-textarea::placeholder { color: var(--text-4); }
.form-textarea { resize: vertical; min-height: 90px; line-height: 1.6; }
.form-select { cursor: pointer; }

/* Size chips */
.size-row { display: flex; gap: 6px; flex-wrap: wrap; }
.size-chip {
  width: 44px; height: 34px;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface); border: 1px solid var(--b);
  font-size: .66rem; font-weight: 700; letter-spacing: 1px;
  cursor: pointer; transition: .15s; color: var(--text-3);
}
.size-chip:hover { border-color: var(--b-2); color: var(--text); }
.size-chip.active { background: var(--red); border-color: var(--red); color: white; }
.size-chip.unavail { opacity: .28; cursor: not-allowed; text-decoration: line-through; }

/* Color builder */
.color-builder { display: flex; flex-direction: column; gap: 10px; }
.color-builder-add { display: flex; gap: 8px; align-items: center; }
.color-picker { width: 40px; height: 36px; background: var(--surface); border: 1px solid var(--b); padding: 3px; cursor: pointer; }
.color-name-input { flex: 1; background: var(--ink-3); border: 1px solid var(--b); color: var(--text); padding: 9px 12px; font-family: var(--body); font-size: .78rem; }
.color-name-input:focus { outline: none; border-color: var(--b-2); }
.color-list { display: flex; gap: 7px; flex-wrap: wrap; }
.color-tag {
  display: flex; align-items: center; gap: 6px;
  background: var(--surface); border: 1px solid var(--b);
  padding: 5px 9px 5px 6px;
}
.color-swatch { width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgba(255,255,255,.18); flex-shrink: 0; }
.color-name  { font-size: .66rem; letter-spacing: 1px; color: var(--text-2); }
.color-rm    { background: none; border: none; color: var(--text-4); font-size: .75rem; cursor: pointer; transition: .15s; }
.color-rm:hover { color: var(--red-2); }

/* Image previews */
.img-preview-grid { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
.img-preview { width: 68px; height: 82px; object-fit: cover; border: 1px solid var(--b); }

/* ═══════════════════════════════════════════════════════════════════
   COUNTDOWN
═══════════════════════════════════════════════════════════════════ */
.countdown-display { display: flex; gap: 20px; flex-wrap: wrap; }
.countdown-unit { text-align: center; }
.countdown-num {
  font-family: var(--display);
  font-size: clamp(3rem,7vw,6rem);
  line-height: 1;
  color: white;
  background: var(--surface-2);
  border: 1px solid var(--b);
  padding: 16px 22px;
  min-width: 90px;
  display: block;
  position: relative;
  overflow: hidden;
}
.countdown-num::before {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(rgba(200,0,26,.05), transparent);
  pointer-events: none;
}
.countdown-unit-label { font-size: .6rem; letter-spacing: 4px; color: var(--red); text-transform: uppercase; margin-top: 8px; }

.drops-list { display: flex; flex-direction: column; gap: 8px; margin-top: 24px; }
.drop-item {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--surface); border: 1px solid var(--b);
  padding: 14px 18px; gap: 12px; flex-wrap: wrap;
}
.drop-item-name { font-weight: 600; font-size: .82rem; letter-spacing: 1px; }
.drop-item-date { font-size: .72rem; color: var(--text-3); font-family: var(--mono); }
.drop-status { padding: 2px 8px; font-size: .58rem; font-weight: 700; letter-spacing: 2px; }
.drop-live     { background: rgba(26,170,74,.12); color: #44e88a; border: 1px solid rgba(26,170,74,.25); }
.drop-upcoming { background: var(--red-dim); color: var(--red-2); border: 1px solid var(--b); }

/* ═══════════════════════════════════════════════════════════════════
   COMIC READER
═══════════════════════════════════════════════════════════════════ */
.reader-layout {
  display: grid;
  grid-template-columns: 240px 1fr 200px;
  gap: 20px;
  align-items: start;
}

.reader-sidebar {
  background: var(--ink-3);
  border: 1px solid var(--b);
  overflow: hidden;
}
.reader-sidebar-header {
  padding: 14px 16px;
  border-bottom: 1px solid var(--b);
  font-family: var(--display);
  font-size: .85rem;
  letter-spacing: 3px;
  color: var(--red-2);
}

.chapter-list { max-height: 500px; overflow-y: auto; }
.chapter-list::-webkit-scrollbar { width: 2px; }
.chapter-list::-webkit-scrollbar-thumb { background: var(--b-2); }
.chapter-item {
  padding: 11px 16px;
  cursor: pointer;
  border-left: 2px solid transparent;
  transition: .15s;
  font-size: .74rem;
  color: var(--text-3);
}
.chapter-item:hover { color: var(--text-2); background: var(--red-dim); }
.chapter-item.active { color: var(--red-2); border-left-color: var(--red); background: var(--red-dim); }

.reader-main {
  background: var(--ink-3);
  border: 1px solid var(--b);
  overflow: hidden;
}
.reader-top-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 18px;
  border-bottom: 1px solid var(--b);
}
.reader-title { font-family: var(--display); letter-spacing: 3px; font-size: .9rem; }
.reader-page-info { font-family: var(--mono); font-size: .68rem; color: var(--text-3); }

.reader-canvas {
  min-height: 520px;
  display: flex; align-items: center; justify-content: center;
  position: relative;
  background: var(--ink-2);
}
.reader-page-img { width: 100%; height: 100%; object-fit: contain; display: block; }
.reader-placeholder {
  text-align: center;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 14px; padding: 40px;
}
.reader-placeholder-num { font-family: var(--display); font-size: 8rem; color: rgba(200,0,26,.08); line-height: 1; }
.reader-placeholder-label { font-size: .65rem; letter-spacing: 3px; color: var(--text-4); text-transform: uppercase; }

.reader-nav {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px;
  border-top: 1px solid var(--b);
}
.reader-arrow {
  width: 38px; height: 38px;
  background: var(--surface); border: 1px solid var(--b);
  color: white; font-size: 1rem; cursor: pointer; transition: .2s;
  display: flex; align-items: center; justify-content: center;
}
.reader-arrow:hover { background: var(--red); border-color: var(--red); }

.page-thumbs { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; padding: 12px; max-height: 500px; overflow-y: auto; }
.page-thumb {
  aspect-ratio: .7;
  background: var(--surface);
  border: 1px solid var(--b);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: .15s;
  font-family: var(--display);
  font-size: .65rem; color: var(--text-4);
  position: relative; overflow: hidden;
}
.page-thumb:hover, .page-thumb.active { border-color: var(--red); color: var(--red-2); }
.page-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

/* ═══════════════════════════════════════════════════════════════════
   AI LAB
═══════════════════════════════════════════════════════════════════ */
.lab-tabs {
  display: flex; gap: 0;
  border-bottom: 1px solid var(--b);
  margin-bottom: 28px;
  overflow-x: auto;
  scrollbar-width: none;
}
.lab-tabs::-webkit-scrollbar { display: none; }
.lab-tab {
  padding: 11px 20px;
  font-size: .65rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
  color: var(--text-3); cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: .15s; white-space: nowrap;
}
.lab-tab:hover { color: var(--text-2); }
.lab-tab.active { color: var(--red-2); border-bottom-color: var(--red); }
.lab-tab-content { display: none; }
.lab-tab-content.active { display: block; }

.lab-grid { display: grid; grid-template-columns: 360px 1fr; gap: 24px; }
.lab-controls { background: var(--ink-3); border: 1px solid var(--b); padding: 26px; display: flex; flex-direction: column; gap: 16px; }
.lab-preview { background: var(--ink-2); border: 1px solid var(--b); min-height: 580px; display: flex; align-items: flex-start; justify-content: center; overflow: hidden; position: relative; }
.lab-preview-inner { width: 100%; padding: 32px; text-align: center; }
.lab-preview-title { font-family: var(--display); font-size: 3rem; letter-spacing: 4px; margin-bottom: 10px; }
.lab-preview-sub { color: var(--text-4); letter-spacing: 2px; font-size: .8rem; margin-bottom: 32px; }

.panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
.panel-cell {
  background: var(--surface-2);
  border: 2px solid rgba(255,255,255,.04);
  min-height: 230px;
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
  font-family: var(--display); font-size: .78rem;
  letter-spacing: 2px; color: var(--text-4);
}
.panel-cell img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
.panel-cell::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgba(200,0,26,.04), rgba(0,0,0,.2)); pointer-events: none; }
.panel-label { position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,.75); padding: 2px 8px; font-size: .56rem; letter-spacing: 2px; color: var(--red-2); z-index: 5; }

.storyboard { text-align: left; width: 100%; }
.story-block { border-left: 3px solid var(--red); padding: 14px 18px; margin-bottom: 16px; background: var(--surface-2); border-radius: 0 2px 2px 0; }
.story-block h3 { font-family: var(--display); letter-spacing: 2px; color: var(--red-2); margin-bottom: 7px; font-size: .95rem; }
.story-block p  { font-size: .8rem; color: var(--text-2); line-height: 1.65; }
.story-chars { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
.char-tag { padding: 2px 9px; background: var(--red-dim); border: 1px solid var(--b); font-size: .6rem; letter-spacing: 1px; color: var(--red-2); }

.spinner { width: 44px; height: 44px; border: 2px solid var(--surface-3); border-top-color: var(--red); border-radius: 50%; animation: spin .75s linear infinite; margin: 0 auto 18px; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ═══════════════════════════════════════════════════════════════════
   MEDIA LIBRARY
═══════════════════════════════════════════════════════════════════ */
.media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px,1fr)); gap: 12px; }
.media-item {
  background: var(--surface);
  border: 1px solid var(--b);
  aspect-ratio: 1;
  overflow: hidden;
  position: relative;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.media-item img, .media-item video { width: 100%; height: 100%; object-fit: cover; }
.media-item-overlay {
  position: absolute; inset: 0;
  background: rgba(0,0,0,0);
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: .2s;
}
.media-item:hover .media-item-overlay { background: rgba(0,0,0,.65); }
.media-act { opacity: 0; padding: 7px 12px; background: var(--red); border: none; color: white; font-size: .62rem; font-weight: 700; letter-spacing: 1px; cursor: pointer; transition: .15s; font-family: var(--body); }
.media-item:hover .media-act { opacity: 1; }
.media-type { position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,.8); padding: 2px 7px; font-size: .56rem; letter-spacing: 2px; color: var(--red-2); }

/* ═══════════════════════════════════════════════════════════════════
   LORE / UNIVERSE DATABASE
═══════════════════════════════════════════════════════════════════ */
.universe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: 16px; }
.universe-card {
  background: var(--surface);
  border: 1px solid var(--b);
  padding: 20px;
  cursor: pointer;
  transition: .2s;
  position: relative;
  overflow: hidden;
}
.universe-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--c,var(--red)); }
.universe-card:hover { border-color: var(--b-2); }
.uc-type { font-size: .58rem; letter-spacing: 3px; color: var(--text-3); text-transform: uppercase; margin-bottom: 8px; }
.uc-name { font-family: var(--heading); font-size: 1.4rem; letter-spacing: 2px; margin-bottom: 6px; }
.uc-meta { font-size: .7rem; color: var(--text-3); line-height: 1.5; }
.uc-tags { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 8px; }
.uc-tag { padding: 1px 7px; background: var(--ink-4); border: 1px solid var(--b); font-size: .58rem; color: var(--text-3); letter-spacing: 1px; }

/* ═══════════════════════════════════════════════════════════════════
   CART DRAWER
═══════════════════════════════════════════════════════════════════ */
.cart-drawer {
  position: fixed;
  right: -440px; top: 0; bottom: 0;
  width: 420px;
  background: var(--ink-2);
  border-left: 1px solid var(--b-2);
  z-index: 900;
  transition: right .38s var(--ease);
  display: flex; flex-direction: column;
}
.cart-drawer.open { right: 0; }
.cart-back { position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 899; display: none; }
.cart-back.open { display: block; }

.cart-head { padding: 20px 22px; border-bottom: 1px solid var(--b); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
.cart-head h3 { font-family: var(--display); font-size: 1.1rem; letter-spacing: 4px; }
.cart-head-meta { font-size: .62rem; letter-spacing: 2px; color: var(--text-3); }
.cart-x { background: none; border: 1px solid var(--b); color: var(--text-3); width: 32px; height: 32px; cursor: pointer; font-size: .9rem; transition: .15s; display: flex; align-items: center; justify-content: center; }
.cart-x:hover { background: var(--red); border-color: var(--red); color: white; }

.cart-items { flex: 1; overflow-y: auto; padding: 16px 22px; }
.cart-items::-webkit-scrollbar { width: 2px; }
.cart-items::-webkit-scrollbar-thumb { background: var(--b-2); }
.cart-empty { text-align: center; padding: 50px 20px; color: var(--text-4); }
.cart-empty-icon { font-size: 2.5rem; display: block; margin-bottom: 10px; opacity: .3; }
.cart-empty-text { font-size: .7rem; letter-spacing: 2px; text-transform: uppercase; }

.cart-item { display: flex; gap: 12px; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.04); }
.cart-item-img { width: 66px; height: 80px; object-fit: cover; flex-shrink: 0; background: var(--surface); }
.cart-item-body { flex: 1; min-width: 0; }
.cart-item-coll { font-size: .56rem; letter-spacing: 2px; color: var(--red); text-transform: uppercase; margin-bottom: 2px; }
.cart-item-name { font-family: var(--heading); font-size: 1rem; letter-spacing: 2px; line-height: 1.1; margin-bottom: 4px; }
.cart-item-variant { font-size: .62rem; color: var(--text-3); letter-spacing: 1px; display: flex; align-items: center; gap: 7px; margin-bottom: 8px; }
.cart-item-color-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; border: 1px solid rgba(255,255,255,.18); }
.cart-item-row { display: flex; align-items: center; justify-content: space-between; }
.cart-qty { display: flex; align-items: center; }
.cart-qty-btn { width: 26px; height: 26px; background: var(--surface-2); border: 1px solid var(--b); color: white; font-size: .85rem; cursor: pointer; transition: .15s; display: flex; align-items: center; justify-content: center; }
.cart-qty-btn:hover { background: var(--red); }
.cart-qty-num { width: 32px; height: 26px; background: var(--surface); border: none; border-top: 1px solid var(--b); border-bottom: 1px solid var(--b); color: var(--text); font-family: var(--display); font-size: .85rem; text-align: center; letter-spacing: 1px; }
.cart-item-price { font-family: var(--display); font-size: 1rem; }
.cart-rm { background: none; border: none; color: var(--text-4); font-size: .8rem; cursor: pointer; transition: .15s; padding: 4px; }
.cart-rm:hover { color: var(--red-2); }

.cart-foot { padding: 18px 22px; border-top: 1px solid var(--b); flex-shrink: 0; background: var(--ink); }
.cart-sum-row { display: flex; justify-content: space-between; font-size: .7rem; color: var(--text-3); margin-bottom: 5px; }
.cart-sum-total { display: flex; justify-content: space-between; font-family: var(--display); font-size: 1.1rem; letter-spacing: 2px; margin-top: 8px; padding-top: 10px; border-top: 1px solid var(--b); }
.promo-row { display: flex; gap: 8px; margin-bottom: 14px; }
.promo-input { flex: 1; background: var(--surface); border: 1px solid var(--b); color: var(--text); padding: 9px 12px; font-family: var(--body); font-size: .72rem; }
.promo-input:focus { outline: none; border-color: var(--b-2); }
.promo-input::placeholder { color: var(--text-4); }

/* ═══════════════════════════════════════════════════════════════════
   NOTIFICATION CENTER
═══════════════════════════════════════════════════════════════════ */
.notif-panel {
  position: fixed;
  top: 70px; right: 16px;
  width: 380px; max-height: 80vh;
  background: rgba(14,9,21,.94);
  border: 1px solid var(--b-2);
  backdrop-filter: blur(22px);
  z-index: 700;
  display: flex; flex-direction: column;
  transform: translateY(-14px) scale(.97);
  opacity: 0; pointer-events: none;
  transition: all .26s var(--ease);
  box-shadow: 0 20px 60px rgba(0,0,0,.6);
}
.notif-panel.open { transform: translateY(0) scale(1); opacity: 1; pointer-events: all; }
.notif-head { padding: 14px 16px; border-bottom: 1px solid var(--b); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
.notif-head h4 { font-family: var(--display); font-size: .9rem; letter-spacing: 3px; }
.notif-head-actions { display: flex; gap: 6px; }
.notif-act-btn { padding: 4px 9px; background: none; border: 1px solid var(--b); color: var(--text-3); font-size: .58rem; letter-spacing: 1px; cursor: pointer; transition: .15s; font-family: var(--body); text-transform: uppercase; }
.notif-act-btn:hover { border-color: var(--red); color: var(--red-2); }
.notif-list { flex: 1; overflow-y: auto; padding: 6px; }
.notif-list::-webkit-scrollbar { width: 2px; }
.notif-list::-webkit-scrollbar-thumb { background: var(--b-2); }
.notif-empty { text-align: center; padding: 36px; color: var(--text-4); font-size: .7rem; letter-spacing: 2px; text-transform: uppercase; }
.notif-item {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 11px 10px;
  cursor: pointer; transition: .15s;
  border-left: 2px solid transparent;
  margin-bottom: 2px;
}
.notif-item:hover { background: rgba(255,255,255,.02); }
.notif-item.unread { background: var(--red-dim); border-left-color: var(--red); }
.notif-icon { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
.notif-body { flex: 1; min-width: 0; }
.notif-title { font-size: .76rem; font-weight: 700; margin-bottom: 2px; }
.notif-msg { font-size: .68rem; color: var(--text-2); line-height: 1.45; }
.notif-time { font-size: .58rem; color: var(--text-4); margin-top: 3px; }
.notif-rm { opacity: 0; background: none; border: none; color: var(--text-4); font-size: .8rem; cursor: pointer; transition: .15s; padding: 2px; align-self: center; }
.notif-item:hover .notif-rm { opacity: 1; }
.notif-rm:hover { color: var(--red-2); }
.notif-footer { padding: 10px 12px; border-top: 1px solid var(--b); flex-shrink: 0; }
.notif-footer-btn { width: 100%; padding: 9px; background: var(--surface-2); border: 1px solid var(--b); color: var(--text-3); font-size: .62rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: .2s; font-family: var(--body); }
.notif-footer-btn:hover { background: var(--red); border-color: var(--red); color: white; }

/* ═══════════════════════════════════════════════════════════════════
   TOAST SYSTEM
═══════════════════════════════════════════════════════════════════ */
.toast-stack {
  position: fixed; bottom: 22px; right: 16px;
  z-index: 2000;
  display: flex; flex-direction: column-reverse; gap: 8px;
  max-width: 360px; pointer-events: none;
}
.toast {
  background: rgba(14,9,21,.95);
  border: 1px solid var(--b-2);
  border-left: 3px solid var(--tc,var(--red));
  backdrop-filter: blur(16px);
  padding: 12px 14px;
  display: flex; align-items: flex-start; gap: 10px;
  pointer-events: all; cursor: pointer;
  transform: translateX(110%); opacity: 0;
  transition: all .32s var(--spring);
  box-shadow: 0 8px 28px rgba(0,0,0,.5);
  position: relative; overflow: hidden;
}
.toast.show { transform: translateX(0); opacity: 1; }
.toast.exit { transform: translateX(115%); opacity: 0; }
.toast-bar { position: absolute; bottom: 0; left: 0; height: 2px; background: var(--tc,var(--red)); opacity: .5; transition: width linear; }
.toast-icon { font-size: 1.2rem; flex-shrink: 0; margin-top: 1px; }
.toast-body { flex: 1; min-width: 0; }
.toast-ttl { font-size: .76rem; font-weight: 700; letter-spacing: .5px; margin-bottom: 2px; }
.toast-txt { font-size: .68rem; color: var(--text-2); line-height: 1.4; }
.toast-close { background: none; border: none; color: var(--text-4); font-size: .75rem; cursor: pointer; transition: .15s; flex-shrink: 0; }
.toast-close:hover { color: var(--text); }

/* ═══════════════════════════════════════════════════════════════════
   PRODUCT DETAIL MODAL
═══════════════════════════════════════════════════════════════════ */
.modal-backdrop {
  position: fixed; inset: 0;
  background: rgba(3,2,5,.92);
  z-index: 1500;
  display: none; align-items: center; justify-content: center;
  padding: 20px;
  backdrop-filter: blur(8px);
}
.modal-backdrop.open { display: flex; }

.product-modal {
  background: var(--ink-2);
  border: 1px solid var(--b-2);
  max-width: 940px; width: 100%; max-height: 88vh;
  overflow-y: auto;
  display: grid; grid-template-columns: 1fr 1fr;
  position: relative;
}
.product-modal::-webkit-scrollbar { width: 2px; }
.modal-close { position: absolute; top: 14px; right: 14px; z-index: 10; width: 34px; height: 34px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); color: white; font-size: .9rem; cursor: pointer; transition: .15s; display: flex; align-items: center; justify-content: center; }
.modal-close:hover { background: var(--red); border-color: var(--red); }

.modal-gallery { position: relative; overflow: hidden; }
.modal-main-img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
.modal-info { padding: 32px 34px; display: flex; flex-direction: column; gap: 0; overflow-y: auto; }
.modal-info::-webkit-scrollbar { width: 2px; }
.modal-coll { font-size: .58rem; letter-spacing: 4px; color: var(--red); text-transform: uppercase; margin-bottom: 5px; }
.modal-name { font-family: var(--display); font-size: 2rem; letter-spacing: 3px; line-height: 1; margin-bottom: 8px; }
.modal-desc { font-size: .78rem; color: var(--text-2); line-height: 1.7; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--b); }
.modal-price-row { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; }
.modal-price { font-family: var(--display); font-size: 2.2rem; }
.modal-price-orig { font-size: .95rem; color: var(--text-4); text-decoration: line-through; }
.modal-add { padding: 15px; background: var(--red); border: none; color: white; font-family: var(--body); font-size: .72rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: .22s; width: 100%; margin-top: 10px; }
.modal-add:hover { background: var(--red-2); }
.modal-add:disabled { background: var(--surface-2); color: var(--text-4); cursor: not-allowed; }
.qty-ctrl { display: flex; align-items: center; border: 1px solid var(--b-2); }
.qty-b { width: 36px; height: 40px; background: var(--surface-2); border: none; color: white; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: .15s; }
.qty-b:hover { background: var(--red); }
.qty-n { width: 44px; height: 40px; background: var(--surface); border: none; border-left: 1px solid var(--b); border-right: 1px solid var(--b); color: var(--text); font-family: var(--display); font-size: .95rem; text-align: center; }
.selector-lbl { font-size: .6rem; letter-spacing: 3px; text-transform: uppercase; color: var(--text-3); margin-bottom: 8px; display: flex; justify-content: space-between; }
.selector-lbl span { color: var(--text-2); font-weight: 700; }
.color-palette { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 20px; }
.palette-swatch { width: 32px; height: 32px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; transition: .18s; position: relative; }
.palette-swatch:hover { transform: scale(1.15); }
.palette-swatch.sel { border-color: white; box-shadow: 0 0 0 1px var(--red); }
.palette-tip { position: absolute; bottom: calc(100% + 5px); left: 50%; transform: translateX(-50%); background: var(--ink); border: 1px solid var(--b); padding: 2px 7px; font-size: .56rem; letter-spacing: 1px; white-space: nowrap; opacity: 0; pointer-events: none; transition: .15s; }
.palette-swatch:hover .palette-tip { opacity: 1; }

/* Accordion */
.accord { border-top: 1px solid var(--b); margin-top: 16px; }
.accord-item { border-bottom: 1px solid var(--b); }
.accord-trigger { width: 100%; background: none; border: none; color: var(--text-2); padding: 12px 0; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-family: var(--body); font-size: .68rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; transition: .15s; }
.accord-trigger:hover { color: var(--text); }
.accord-arrow { transition: .22s; font-size: .65rem; }
.accord-trigger.open .accord-arrow { transform: rotate(180deg); }
.accord-body { max-height: 0; overflow: hidden; transition: max-height .3s var(--ease); }
.accord-body.open { max-height: 200px; }
.accord-content { padding: 0 0 14px; font-size: .74rem; color: var(--text-3); line-height: 1.7; }

/* ═══════════════════════════════════════════════════════════════════
   LOOKBOOK
═══════════════════════════════════════════════════════════════════ */
.lookbook-masonry { columns: 4; gap: 10px; }
.lookbook-item { break-inside: avoid; margin-bottom: 10px; overflow: hidden; position: relative; cursor: pointer; }
.lookbook-item img { width: 100%; display: block; transition: transform .55s var(--ease); }
.lookbook-item:hover img { transform: scale(1.05); }
.lookbook-item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 50%, rgba(200,0,26,.2)); opacity: 0; transition: .3s; pointer-events: none; }
.lookbook-item:hover::after { opacity: 1; }

