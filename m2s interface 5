function saveCharToDB() {
  const name = document.getElementById('charName').value.trim(); if (!name) { toast('⚠️','No Name','Enter a character name first','stock_warning'); return; }
  universeEntries.unshift({ id:uid(), type:'character', name, meta:'Auto-generated via AI Lab', tags:['ai-generated'], color:'#c8001a', faction: document.getElementById('charFaction').value || 'Unknown', lore: document.getElementById('charLore').value || '' });
  toast('📚','Saved to Universe','Character saved to Universe Database','announcement');
}

/* ═══════════════════════════════════
   ADMIN PANEL
═══════════════════════════════════ */
const ADMIN_TABS = ['inventory','products','drops','analytics','upload'];
let adminTab = 'inventory';

function renderAdmin() {
  const navItems = [
    { id:'inventory',  icon:'📊', label:'Inventory' },
    { id:'products',   icon:'👕', label:'Products'  },
    { id:'drops',      icon:'🔥', label:'Drops'     },
    { id:'analytics',  icon:'📈', label:'Analytics' },
    { id:'upload',     icon:'⬆',  label:'Upload'    },
  ];
  document.getElementById('adminNav').innerHTML = navItems.map(n =>
    `<div class="admin-nav-item ${adminTab===n.id?'active':''}" onclick="switchAdminTab('${n.id}')">${n.icon} &nbsp;${n.label}</div>`
  ).join('');
  renderAdminContent();
}

function switchAdminTab(tab) { adminTab = tab; renderAdmin(); }

function renderAdminContent() {
  const el = document.getElementById('adminContent');
  if (adminTab === 'inventory') {
    const total = products.length;
    const stock = products.reduce((s, p) => s + getTotalStock(p), 0);
    const low   = products.filter(p => getTotalStock(p) > 0 && getTotalStock(p) <= 10).length;
    const sold  = products.filter(p => getTotalStock(p) === 0).length;
    const value = products.reduce((s, p) => s + p.price * getTotalStock(p), 0);
    const colls = [...new Set(products.map(p => p.collection))].length;
    el.innerHTML = `
      <div class="stat-grid">
        <div class="stat-card"><div class="stat-label">Products</div><div class="stat-value">${total}</div></div>
        <div class="stat-card" style="--c:var(--gold);"><div class="stat-label">Total Stock</div><div class="stat-value gold">${stock}</div></div>
        <div class="stat-card" style="--c:var(--warn);"><div class="stat-label">Low Stock</div><div class="stat-value">${low}</div></div>
        <div class="stat-card" style="--c:var(--red-2);"><div class="stat-label">Sold Out</div><div class="stat-value red">${sold}</div></div>
        <div class="stat-card" style="--c:#44e88a;"><div class="stat-label">Inventory Value</div><div class="stat-value green">$${value.toLocaleString()}</div></div>
        <div class="stat-card"><div class="stat-label">Collections</div><div class="stat-value">${colls}</div></div>
      </div>
      <table class="data-table">
        <thead><tr><th>IMG</th><th>NAME</th><th>COLLECTION</th><th>PRICE</th><th>STOCK</th><th>STATUS</th><th>ACTIONS</th></tr></thead>
        <tbody>${products.map(p => {
          const ss = getStockStatus(p); const s = getTotalStock(p);
          return `<tr>
            <td>${p.images?.[0]?`<img src="${p.images[0]}" style="width:36px;height:44px;object-fit:cover;border:1px solid var(--b);">`:'<div style="width:36px;height:44px;background:var(--surface);border:1px solid var(--b);"></div>'}</td>
            <td><strong>${esc(p.name)}</strong><br><span style="font-size:.6rem;color:var(--text-3);">${esc(p.category||'')}</span></td>
            <td style="color:var(--red);font-size:.7rem;">${esc(p.collection)}</td>
            <td><strong>$${p.price}</strong></td>
            <td>${s}</td>
            <td><span class="product-stock ${ss.cls}">${ss.label}</span></td>
            <td><div style="display:flex;gap:5px;"><button class="btn btn-ghost btn-xs" onclick="openProductModal('${p.id}')">VIEW</button><button class="btn btn-ghost btn-xs" style="color:var(--red-2);border-color:rgba(200,0,26,.3);" onclick="deleteProduct('${p.id}')">DELETE</button></div></td>
          </tr>`;
        }).join('')}</tbody>
      </table>`;
  }
  else if (adminTab === 'products') {
    el.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <h3 style="font-family:var(--display);letter-spacing:3px;font-size:1.1rem;">ALL PRODUCTS</h3>
        <button class="btn btn-primary btn-sm" onclick="openAddProductForm()">+ ADD PRODUCT</button>
      </div>
      <div id="productFormWrap"></div>
      <div class="grid-auto">${products.map(p => buildProductCard(p)).join('')}</div>`;
  }
  else if (adminTab === 'drops') {
    el.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <h3 style="font-family:var(--display);letter-spacing:3px;font-size:1.1rem;">DROP MANAGEMENT</h3>
        <button class="btn btn-primary btn-sm" onclick="openScheduleModal()">+ SCHEDULE DROP</button>
      </div>
      <div class="drops-list">${drops.map(d => {
        const past = new Date(d.date) <= new Date();
        return `<div class="drop-item"><div><div class="drop-item-name">${esc(d.name)}</div><div class="drop-item-date">${new Date(d.date).toLocaleString()}</div></div><span class="drop-status ${past?'drop-live':'drop-upcoming'}">${past?'LIVE':'UPCOMING'}</span><button onclick="removeDrop('${d.id}')" class="btn btn-ghost btn-xs">REMOVE</button></div>`;
      }).join('')}</div>`;
  }
  else if (adminTab === 'analytics') {
    const totalSales = Math.floor(Math.random() * 400 + 100);
    const revenue = products.reduce((s,p) => s + p.price * Math.floor(Math.random()*8), 0);
    el.innerHTML = `
      <div class="stat-grid">
        <div class="stat-card" style="--c:#44e88a;"><div class="stat-label">Total Orders</div><div class="stat-value green">${totalSales}</div></div>
        <div class="stat-card" style="--c:var(--gold);"><div class="stat-label">Revenue</div><div class="stat-value gold">$${revenue.toLocaleString()}</div></div>
        <div class="stat-card"><div class="stat-label">Cart Items</div><div class="stat-value">${cart.reduce((s,i)=>s+i.qty,0)}</div></div>
        <div class="stat-card" style="--c:var(--red-2);"><div class="stat-label">Active Drops</div><div class="stat-value red">${drops.filter(d=>new Date(d.date)>new Date()).length}</div></div>
      </div>
      <div style="background:var(--surface);border:1px solid var(--b);padding:22px;margin-top:16px;">
        <div style="font-size:.6rem;letter-spacing:3px;color:var(--text-3);text-transform:uppercase;margin-bottom:14px;">COLLECTION PERFORMANCE</div>
        ${[...new Set(products.map(p=>p.collection))].map(c => {
          const ps = products.filter(p=>p.collection===c);
          const pct = Math.floor(Math.random()*80+20);
          return `<div style="margin-bottom:12px;"><div style="display:flex;justify-content:space-between;font-size:.7rem;margin-bottom:5px;"><span>${esc(c)}</span><span style="color:var(--gold);">${pct}%</span></div><div style="height:4px;background:var(--surface-2);"><div style="height:100%;background:var(--red);width:${pct}%;transition:.6s;"></div></div></div>`;
        }).join('')}
      </div>`;
  }
  else if (adminTab === 'upload') {
    el.innerHTML = `
      <h3 style="font-family:var(--display);letter-spacing:3px;font-size:1.1rem;margin-bottom:20px;">QUICK PRODUCT UPLOAD</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
        <div class="form-group"><label class="form-label">Product Name *</label><input class="form-input" id="up-name" placeholder="e.g. Chaos Denim Jacket"></div>
        <div class="form-group"><label class="form-label">Collection *</label><input class="form-input" id="up-coll" placeholder="e.g. ORIGINS VOL.1"></div>
        <div class="form-group"><label class="form-label">Price ($) *</label><input class="form-input" type="number" id="up-price" placeholder="120"></div>
        <div class="form-group"><label class="form-label">Category</label><select class="form-select" id="up-cat"><option>Tops</option><option>Bottoms</option><option>Outerwear</option><option>Hoodies</option><option>Accessories</option></select></div>
      </div>
      <div class="form-group" style="margin-bottom:16px;"><label class="form-label">Description *</label><textarea class="form-textarea" id="up-desc" placeholder="Product description..."></textarea></div>
      <div class="upload-zone" id="adminUploadZone" onclick="document.getElementById('up-img').click()" style="margin-bottom:16px;">
        <span class="upload-zone-icon">📸</span>
        <div class="upload-zone-title">UPLOAD PRODUCT IMAGES</div>
        <div class="upload-zone-sub">Click or drag images · First image = cover · Multiple supported</div>
      </div>
      <input type="file" id="up-img" multiple accept="image/*" style="display:none" onchange="handleUploadImgs(this)">
      <div id="up-img-previews" class="img-preview-grid"></div>
      <button class="btn btn-primary" style="margin-top:16px;" onclick="quickUploadProduct()">⬆ PUBLISH PRODUCT</button>`;
  }
}

let uploadImgs = [];
function handleUploadImgs(input) {
  Array.from(input.files).forEach(f => { const url = URL.createObjectURL(f); uploadImgs.push(url); });
  document.getElementById('up-img-previews').innerHTML = uploadImgs.map(url => `<img class="img-preview" src="${url}">`).join('');
  input.value = '';
}

function quickUploadProduct() {
  const name  = document.getElementById('up-name')?.value?.trim();
  const coll  = document.getElementById('up-coll')?.value?.trim();
  const price = parseFloat(document.getElementById('up-price')?.value);
  const desc  = document.getElementById('up-desc')?.value?.trim();
  const cat   = document.getElementById('up-cat')?.value || 'Tops';
  if (!name || !coll || !price || !desc) { toast('⚠️','Missing Fields','Fill in all required fields','stock_warning'); return; }
  const newProduct = { id:uid(), name, collection:coll, price, originalPrice:null, description:desc, materials:'', category:cat, sizes:['XS','S','M','L','XL','2X'], colors:[{name:'Black',hex:'#111111'}], stock:{XS:10,S:15,M:20,L:15,XL:10,'2X':5}, badge:'new', images:uploadImgs.length?[...uploadImgs]:[], createdAt:Date.now() };
  products.unshift(newProduct);
  uploadImgs = [];
  switchAdminTab('inventory');
  toast('✅','Product Published',`${name} is now live in the store`,'payment');
  pushNotif('🔥 NEW PRODUCT: ' + name, `"${name}" just added to ${coll}`, 'drop');
}

function deleteProduct(id) {
  if (!confirm('Delete this product?')) return;
  products = products.filter(p => p.id !== id);
  renderAdmin();
  toast('🗑️','Deleted','Product removed from catalog','announcement');
}

function openAddProductForm() {
  uploadImgs = [];
  switchAdminTab('upload');
}

/* ═══════════════════════════════════
   INTERSECTION OBSERVER (re-apply for dynamically added elements)
═══════════════════════════════════ */
function observeFadeUps() {
  document.querySelectorAll('.fade-up:not(.in)').forEach(el => fadeObserver.observe(el));
}

