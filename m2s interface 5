  ).join('') + `<button class="btn btn-ghost btn-sm" onclick="addEpisode()">+</button>`;
}

function loadEpisode(idx) { currentEp = idx; currentPage = 0; renderEpisodeTabs(); renderComicReader(); }
function addEpisode() {
  const name = `Episode ${episodes.length + 1}: New Arc`;
  episodes.push({ id: uid(), name, pages: [] });
  currentEp = episodes.length - 1;
  renderEpisodeTabs(); renderComicReader();
}

function renderComicReader() {
  const ep = episodes[currentEp];
  if (!ep) return;
  const total = Math.max(TOTAL_PAGES, ep.pages.length);
  const pg = ep.pages[currentPage];

  document.getElementById('readerTitle').textContent = ep.name;
  document.getElementById('readerPageInfo').textContent = `${currentPage+1} / ${total}`;
  document.getElementById('readerPageCounter').textContent = `${currentPage+1} / ${total}`;
  document.getElementById('readerPageNum').textContent = currentPage + 1;

  const img = document.getElementById('readerImg');
  const placeholder = document.getElementById('readerPlaceholder');
  if (pg) { img.src = pg; img.style.display = 'block'; placeholder.style.display = 'none'; }
  else { img.style.display = 'none'; placeholder.style.display = 'flex'; }

  // Sidebar
  document.getElementById('chapterList').innerHTML = Array.from({ length: Math.min(total, 30) }, (_, i) => `
    <div class="chapter-item ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">
      ${ep.pages[i] ? '📄' : '⬜'} ${i === 0 ? 'COVER' : `PAGE ${i}`}
      ${ep.pages[i] ? `<button onclick="event.stopPropagation();removePage(${i})" style="background:none;border:none;color:var(--text-4);cursor:pointer;float:right;font-size:.75rem;" onmouseover="this.style.color='var(--red-2)'" onmouseout="this.style.color='var(--text-4)'">✕</button>` : ''}
    </div>`).join('');

  // Thumbs
  document.getElementById('pageThumbs').innerHTML = Array.from({ length: Math.min(total, 40) }, (_, i) =>
    `<div class="page-thumb ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${ep.pages[i] ? `<img src="${ep.pages[i]}">` : i+1}</div>`).join('');
}

function goToPage(n) { const total = Math.max(TOTAL_PAGES, episodes[currentEp]?.pages.length || 0); currentPage = Math.max(0, Math.min(n, total-1)); renderComicReader(); }
function comicPrev() { goToPage(currentPage - 1); }
function comicNext() { goToPage(currentPage + 1); }
function jumpPage(n) { goToPage(parseInt(n) - 1 || 0); }

function importPages(input) {
  const ep = episodes[currentEp]; if (!ep) return;
  Array.from(input.files).forEach(f => { const url = URL.createObjectURL(f); ep.pages.push(url); });
  input.value = '';
  renderComicReader();
  toast('📖','Pages Imported', `${input.files.length} page(s) added to ${ep.name}`, 'announcement');
}

function removePage(idx) { episodes[currentEp]?.pages.splice(idx, 1); renderComicReader(); }

