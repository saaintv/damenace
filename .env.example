# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES - COPY TO .env
# DO NOT COMMIT .env TO GITHUB
# ═══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT
# ══════════════════════════════════════════════════════════════

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Stripe Public Key (Publishable)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:5000
# For production:
# REACT_APP_BACKEND_URL=https://menace-backend.herokuapp.com

# ══════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT
# ══════════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# For production:
# FRONTEND_URL=https://damenace.vercel.app

# Firebase Admin SDK
FIREBASE_ADMIN_KEY={"type":"service_account","project_id":"..."}
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# Stripe Secret Key
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# Admin Credentials
ADMIN_EMAIL=admin@menace2society.com
ADMIN_PASSWORD=your_secure_password

# AI APIs
GEMINI_API_KEY=your_gemini_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ══════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════

# Firebase Firestore is used (no additional config needed)
# Collections auto-created: users, products, orders, comics, notifications

# ══════════════════════════════════════════════════════════════
# DEPLOYMENT
# ══════════════════════════════════════════════════════════════

# Vercel (Frontend)
VERCEL_URL=https://damenace.vercel.app

# Render (Backend)
RENDER_EXTERNAL_URL=https://menace-backend.onrender.com

# ══════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ══════════════════════════════════════════════════════════════

# 1. Create Firebase Project at https://firebase.google.com
# 2. Get Firebase credentials from Settings → Service Accounts
# 3. Create Stripe account at https://stripe.com
# 4. Get Stripe API keys from https://dashboard.stripe.com/apikeys
# 5. Fill in all values above
# 6. Copy this file to .env (git-ignored)
# 7. Never commit .env to GitHub
