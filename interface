<!-- 5. CART SYSTEM                                -->
<!-- ============================================== -->

<section class="cart glass">

    <h1>CART</h1>

    <div id="cartItems"></div>

    <h2 id="total">
        Total: $0
    </h2>

</section>

<script>

let cart = [];

function addToCart(name,price){

    cart.push({name,price});

    renderCart();
}

function renderCart(){

    const cartItems =
    document.getElementById("cartItems");

    cartItems.innerHTML = "";

    let total = 0;

    cart.forEach(item=>{

        total += item.price;

        cartItems.innerHTML += `

            <div class="cart-item">

                <p>${item.name}</p>

                <span>$${item.price}</span>

            </div>
        `;
    });

    document.getElementById("total")
    .innerText =
    `Total: $${total}`;
}

</script>

