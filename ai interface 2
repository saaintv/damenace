<!-- ================================================= -->
<!-- MENACE WORLD — AI COMIC & CREATOR EXPANSION       -->
<!-- ================================================= -->

<!-- ============================================== -->
<!-- MENACE CREATOR DASHBOARD                       -->
<!-- ============================================== -->

<section class="creator-dashboard glass fade-up">

    <h1>MENACE CREATOR HUB</h1>

    <div class="dashboard-grid">

        <!-- SAVED PROJECTS -->

        <div class="dashboard-card">

            <h2>Saved AI Projects</h2>

            <div id="savedProjects">

                <div class="project-item">
                    DaMenace Origins
                </div>

                <div class="project-item">
                    Valentina Chaos Arc
                </div>

            </div>

        </div>

        <!-- HISTORY -->

        <div class="dashboard-card">

            <h2>Generation History</h2>

            <div id="generationHistory">

                <div class="history-item">
                    Horror Manga Character
                </div>

                <div class="history-item">
                    Cyberpunk Comic Scene
                </div>

            </div>

        </div>

        <!-- PRESETS -->

        <div class="dashboard-card">

            <h2>AI Presets</h2>

            <div class="preset-grid">

                <button onclick="applyPreset('Grunge Chaos')">
                    GRUNGE CHAOS
                </button>

                <button onclick="applyPreset('Horror Manga')">
                    HORROR MANGA
                </button>

                <button onclick="applyPreset('Mirror Reality')">
                    MIRROR REALITY
                </button>

                <button onclick="applyPreset('Luxury Noir')">
                    LUXURY NOIR
                </button>

            </div>

        </div>

    </div>

</section>

<!-- ============================================== -->
<!-- USER GALLERY                                  -->
<!-- ============================================== -->

<section class="gallery-system glass fade-up">

    <h1>COMMUNITY GALLERY</h1>

    <div class="gallery-grid-system" id="userGallery">

        <div class="gallery-card">

            <img src="comic1.jpg">

            <div class="gallery-overlay">

                <h3>DaMenace</h3>

                <button onclick="remixProject()">
                    REMIX
                </button>

            </div>

        </div>

        <div class="gallery-card">

            <img src="comic2.jpg">

            <div class="gallery-overlay">

                <h3>Valentina</h3>

                <button onclick="remixProject()">
                    REMIX
                </button>

            </div>

        </div>

    </div>

</section>

<!-- ============================================== -->
<!-- FLIPBOOK COMIC READER                         -->
<!-- ============================================== -->

<section class="flipbook-section glass fade-up">

    <h1>MENACE COMIC READER</h1>

    <!-- EPISODES -->

    <div class="episode-bar">

        <button onclick="loadEpisode(1)">
            EP 1
        </button>

        <button onclick="loadEpisode(2)">
            EP 2
        </button>

        <button onclick="loadEpisode(3)">
            EP 3
        </button>

    </div>

    <!-- FLIPBOOK -->

    <div class="flipbook-container">

        <button onclick="prevPage()">
            ◀
        </button>

        <div class="comic-page" id="comicPage">

            <img
            id="comicImage"
            src="page1.jpg">

            <!-- SPEECH BUBBLE -->

            <div
            class="speech-bubble"
            contenteditable="true">

                ENTER DIALOGUE

            </div>

        </div>

        <button onclick="nextPage()">
            ▶
        </button>

    </div>

</section>

<!-- ============================================== -->
<!-- MOTION COMIC MODE                             -->
<!-- ============================================== -->

<section class="motion-comic glass fade-up">

    <h1>MOTION COMIC MODE</h1>

    <div class="motion-player">

        <video
        id="motionVideo"
        controls>

            <source
            src="motioncomic.mp4"
            type="video/mp4">

        </video>

    </div>

    <!-- SOUND FX -->

    <div class="sound-panel">

        <button onclick="playSound('rain')">
            RAIN
        </button>

        <button onclick="playSound('heartbeat')">
            HEARTBEAT
        </button>

        <button onclick="playSound('glitch')">
            GLITCH
        </button>

    </div>

</section>

<!-- ============================================== -->
<!-- STYLES                                        -->
<!-- ============================================== -->

<style>

/* GLOBAL */

.dashboard-grid{

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:30px;

    margin-top:40px;
}

.dashboard-card{

    background:#101010;

    border:1px solid #222;

    padding:25px;

    border-radius:20px;
}

.dashboard-card h2{

    margin-bottom:20px;
}

/* PROJECTS */

.project-item,
.history-item{

    background:#151515;

    padding:15px;

    margin-bottom:15px;

    border-radius:12px;
}

/* PRESETS */

.preset-grid{

    display:grid;

    gap:15px;
}

/* GALLERY */

.gallery-grid-system{

    display:grid;

    grid-template-columns:
    repeat(2,1fr);

    gap:30px;

    margin-top:40px;
}

.gallery-card{

    position:relative;

    overflow:hidden;

    border-radius:20px;
}

.gallery-card img{

    width:100%;

    height:450px;

    object-fit:cover;

    transition:0.5s;
}

.gallery-card:hover img{

    transform:scale(1.05);
}

.gallery-overlay{

    position:absolute;

    inset:0;

    background:
    linear-gradient(
    transparent,
    rgba(0,0,0,0.8));

    display:flex;

    flex-direction:column;

    justify-content:flex-end;

    padding:25px;
}

/* FLIPBOOK */

.flipbook-container{

    display:flex;

    align-items:center;

    justify-content:center;

    gap:30px;

    margin-top:40px;
}

.comic-page{

    position:relative;

    width:700px;

    height:900px;

    overflow:hidden;

    border-radius:20px;

    border:2px solid #222;
}

.comic-page img{

    width:100%;

    height:100%;

    object-fit:cover;
}

/* SPEECH BUBBLE */

.speech-bubble{

    position:absolute;

    top:80px;

    left:60px;

    background:white;

    color:black;

    padding:20px;

    border-radius:20px;

    min-width:200px;

    font-weight:bold;

    cursor:text;
}

/* EPISODES */

.episode-bar{

    display:flex;

    justify-content:center;

    gap:20px;

    margin-top:30px;
}

/* MOTION COMIC */

.motion-player video{

    width:100%;

    border-radius:20px;

    margin-top:30px;
}

.sound-panel{

    display:flex;

    gap:20px;

    margin-top:30px;
}

/* MOBILE */

@media(max-width:1000px){

    .dashboard-grid{

        grid-template-columns:1fr;
    }

    .gallery-grid-system{

        grid-template-columns:1fr;
    }

    .comic-page{

        width:100%;

        height:auto;
    }

    .flipbook-container{

        flex-direction:column;
    }
}

</style>

<!-- ============================================== -->
<!-- JAVASCRIPT                                    -->
<!-- ============================================== -->

<script>

/* ============================================== */
/* SAVE PROJECTS                                  */
/* ============================================== */

let savedProjects = [];

function saveProject(name){

    savedProjects.push(name);

    renderProjects();
}

function renderProjects(){

    const container =
    document.getElementById("savedProjects");

    container.innerHTML = "";

    savedProjects.forEach(project=>{

        container.innerHTML += `
            <div class="project-item">
                ${project}
            </div>
        `;
    });
}

/* ============================================== */
/* AI HISTORY                                     */
/* ============================================== */

let generationHistory = [];

function addHistory(item){

    generationHistory.push(item);
}

/* ============================================== */
/* PRESETS                                        */
/* ============================================== */

function applyPreset(preset){

    const prompt =
    document.getElementById("prompt");

    prompt.value =
    `Generate in ${preset} style`;
}

/* ============================================== */
/* REMIX FEATURE                                  */
/* ============================================== */

function remixProject(){

    alert(
    "Remix mode activated."
    );
}

/* ============================================== */
/* FLIPBOOK SYSTEM                                */
/* ============================================== */

let currentPage = 1;

function nextPage(){

    currentPage++;

    document
    .getElementById("comicImage")
    .src =
    `page${currentPage}.jpg`;
}

function prevPage(){

    if(currentPage > 1){

        currentPage--;

        document
        .getElementById("comicImage")
        .src =
        `page${currentPage}.jpg`;
    }
}

/* ============================================== */
/* EPISODES                                       */
/* ============================================== */

function loadEpisode(ep){

    currentPage = 1;

    document
    .getElementById("comicImage")
    .src =
    `episode${ep}/page1.jpg`;
}

/* ============================================== */
/* SOUND EFFECTS                                  */
/* ============================================== */

function playSound(type){

    let audio =
    new Audio(`${type}.mp3`);

    audio.play();
}

</script>