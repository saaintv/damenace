<script>
/* ================================================================ */
/* NOTIFICATION DATA & STATE                                         */
/* ================================================================ */
let notifications = [];
let unreadCount = 0;
let soundEnabled = true;
let ncFilter = 'all';
let socket = null;
let connected = false;
let sessionTotal = 0;
let reconnectCount = 0;
let adminTab = 'send';
let onlineUsers = [];
let scheduledJobs = [];
let analyticsData = {};
let typingTimeout = null;
let orderStep = 0;

const typeConfig = {
  drop:         { icon:'🔥', color:'#d4001a', label:'New Drop'     },
  order:        { icon:'📦', color:'#c8922a', label:'Order Update' },
  payment:      { icon:'✅', color:'#1db954', label:'Payment'      },
  restock:      { icon:'♻️', color:'#4a8af0', label:'Restock'      },
  shipping:     { icon:'🚚', color:'#8a4af0', label:'Shipping'     },
  stock_warning:{ icon:'⚠️', color:'#f0b93a', label:'Low Stock'    },
  announcement: { icon:'📣', color:'#d44af0', label:'Announcement' },
};

const ORDER_STEPS = [
  { label:'Payment',    icon:'✅' },
  { label:'Processing', icon:'⚙' },
  { label:'Packed',     icon:'📦' },
  { label:'Shipped',    icon:'🚚' },
  { label:'Delivered',  icon:'🎉' },
];

/* ================================================================ */
/* SOCKET CONNECTION                                                 */
/* ================================================================ */
function initSocket() {
  // Try to connect to server; fall back to demo mode if server not available
  const serverUrl = window.location.hostname === 'localhost' || window.location.port
    ? window.location.origin
    : window.location.origin;

  try {
    socket = io(serverUrl, {
      reconnection: true, reconnectionDelay: 2000, reconnectionDelayMax: 10000,
      reconnectionAttempts: 10, timeout: 5000,
      transports: ['websocket', 'polling']
    });

    socket.on('connect', () => {
      connected = true;
      updateConnectionUI(true);
      console.log('[M2S] Socket connected:', socket.id);
    });

    socket.on('disconnect', (reason) => {
      connected = false;
      updateConnectionUI(false);
      console.log('[M2S] Disconnected:', reason);
    });

    socket.on('connect_error', (err) => {
      reconnectCount++;
      document.getElementById('statusReconnects').textContent = reconnectCount;
      // Switch to demo mode after failures
      if (reconnectCount >= 2) enableDemoMode();
    });

    socket.on('notification:history', (notifs) => {
      notifications = notifs || [];
      renderNotifications();
      renderAllNotifications();
    });

    socket.on('notification:new', handleNewNotification);
    socket.on('notification:updated', (data) => {
      const n = notifications.find(x => x.id === data.id);
      if (n) { n.read = data.read; }
      recountUnread(); renderNotifications(); renderAllNotifications();
    });
    socket.on('notification:deleted', (id) => {
      notifications = notifications.filter(n => n.id !== id);
      recountUnread(); renderNotifications(); renderAllNotifications();
    });
    socket.on('notification:cleared', () => {
      notifications = []; recountUnread(); renderNotifications(); renderAllNotifications();
      showToastMsg('🗑️','Cleared','All notifications cleared','announcement');
    });
    socket.on('notification:all_read', () => {
      notifications.forEach(n => n.read = true);
      recountUnread(); renderNotifications(); renderAllNotifications();
    });
    socket.on('presence:update', ({ count, users }) => {
      onlineUsers = users || [];
      updatePresence(count);
    });
    socket.on('order:progress', updateOrderProgress);
    socket.on('banner:announcement', ({ text, color }) => showBanner(text, color));
    socket.on('activity:typing', showTypingIndicator);
    socket.on('admin:analytics', (data) => { analyticsData = data; if (adminTab === 'analytics') renderAdminTab(); });
    socket.on('admin:users', (users) => { onlineUsers = users; if (adminTab === 'users') renderAdminTab(); });
    socket.on('admin:scheduled_jobs', (jobs) => { scheduledJobs = jobs; renderAdminTab(); });
    socket.on('admin:job_scheduled', ({ jobId, runAt }) => showToastMsg('⏰','Scheduled',`Job scheduled for ${new Date(runAt).toLocaleTimeString()}`,'announcement'));
    socket.on('admin:job_cancelled', () => showToastMsg('🗑️','Cancelled','Scheduled job cancelled','announcement'));
    socket.on('error', ({ message }) => showToastMsg('❌','Error',message,'stock_warning'));

  } catch (e) {
    enableDemoMode();
  }
}

function enableDemoMode() {
  if (connected) return;
  connected = true;
  updateConnectionUI(true, true);

  // Seed demo notifications
  const demoNotifs = [
    { id: uuid(), userId:'demo', title:'🔥 ORIGINS VOL.1 IS LIVE', message:'The new collection just dropped. Limited pieces available now.', type:'drop', image:'🔥', actionUrl:'/shop', timestamp:new Date(Date.now()-600000).toISOString(), read:false },
    { id: uuid(), userId:'demo', title:'PAYMENT CONFIRMED', message:'Order #M2S-4821 confirmed. We\'re preparing your chaos.', type:'payment', image:'✅', actionUrl:'/orders/4821', timestamp:new Date(Date.now()-1200000).toISOString(), read:false },
    { id: uuid(), userId:'demo', title:'⚠️ LOW STOCK: Chaos Denim', message:'Only 2 left in size M. Secure yours now.', type:'stock_warning', image:'⚠️', actionUrl:'/product/chaos-denim', timestamp:new Date(Date.now()-1800000).toISOString(), read:false },
    { id: uuid(), userId:'demo', title:'ORDER #M2S-4820 SHIPPED', message:'Tracking: M2S-TRK-7734. Estimated delivery: 3-5 days.', type:'shipping', image:'🚚', actionUrl:'/track/7734', timestamp:new Date(Date.now()-3600000).toISOString(), read:true },
    { id: uuid(), userId:'demo', title:'FEAR ME HOODIE RESTOCKED', message:'Back in stock — all sizes. Don\'t sleep on it.', type:'restock', image:'♻️', actionUrl:'/product/fear-me-hoodie', timestamp:new Date(Date.now()-7200000).toISOString(), read:true },
    { id: uuid(), userId:'demo', title:'ADMIN ANNOUNCEMENT', message:'Friday midnight drop confirmed. Members get 20-min early access.', type:'announcement', image:'📣', actionUrl:'/drops', timestamp:new Date(Date.now()-14400000).toISOString(), read:true },
  ];
  notifications = demoNotifs;
  renderNotifications();
  renderAllNotifications();
  recountUnread();

  // Simulate live presence
  document.getElementById('presenceCount').textContent = '7 users online';
  document.getElementById('onlineCount').textContent = '7 online';
  document.getElementById('scOnline').textContent = '7';

  // Simulate incoming notifications every 18s
  setInterval(() => {
    if (Math.random() < .5) {
      const types = Object.keys(typeConfig);
      const type = types[Math.floor(Math.random() * types.length)];
      const demos = {
        drop: { title:'🔥 NEW DROP ALERT', message:'Limited edition piece just went live. Shop before it\'s gone.' },
        payment: { title:'PAYMENT RECEIVED', message:`Order #M2S-${4800+Math.floor(Math.random()*200)} confirmed.` },
        order: { title:'ORDER UPDATE', message:'Your order has moved to the next stage.' },
        shipping: { title:'PACKAGE IN TRANSIT', message:`Your order is ${Math.floor(Math.random()*5)+1} stops away.` },
        restock: { title:'ITEM RESTOCKED', message:'Something you wanted is back in stock.' },
        stock_warning: { title:'LAST FEW REMAINING', message:`Only ${Math.floor(Math.random()*4)+1} units left.` },
        announcement: { title:'MENACE TEAM UPDATE', message:'Something big is coming. Stay locked in.' },
      };
      const d = demos[type];
      handleNewNotification({ id:uuid(), userId:'demo', title:d.title, message:d.message, type, image:typeConfig[type].icon, actionUrl:'/shop', timestamp:new Date().toISOString(), read:false });
    }
  }, 18000);
}

/* ================================================================ */
/* CONNECTION UI                                                     */
/* ================================================================ */
function updateConnectionUI(isConnected, demoMode = false) {
  const dot = document.getElementById('connDot');
  const scConn = document.getElementById('scConnection');
  const scSocket = document.getElementById('scSocketId');
  const statusWS = document.getElementById('statusWS');
  const socketStatus = document.getElementById('socketStatus');

  if (isConnected) {
    dot.className = 'conn-dot connected';
    dot.title = demoMode ? 'Demo Mode' : 'Connected';
    scConn.textContent = demoMode ? 'DEMO MODE' : 'CONNECTED';
    scConn.style.color = 'var(--success)';
    scSocket.textContent = demoMode ? 'No server — simulated' : (socket?.id || '—');
    statusWS.textContent = demoMode ? 'DEMO' : '✅ CONNECTED';
    statusWS.style.color = isConnected ? 'var(--success)' : 'var(--warn)';
    socketStatus.textContent = demoMode ? 'DEMO MODE' : 'LIVE';
    socketStatus.style.color = 'var(--success)';
  } else {
    dot.className = 'conn-dot connecting';
    scConn.textContent = 'RECONNECTING';
    scConn.style.color = 'var(--warn)';
    statusWS.textContent = '⚠️ RECONNECTING';
    socketStatus.textContent = 'OFFLINE';
    socketStatus.style.color = 'var(--warn)';
  }
  document.getElementById('statusSW').textContent = 'serviceWorker' in navigator ? '✅ SUPPORTED' : '❌ NO SUPPORT';
  document.getElementById('statusSW').style.color = 'serviceWorker' in navigator ? 'var(--success)' : 'var(--red)';
  document.getElementById('statusNotif').textContent = 'Notification' in window ? (Notification.permission === 'granted' ? '✅ GRANTED' : '⚠️ '+Notification.permission) : '❌ NO SUPPORT';
  document.getElementById('statusNotif').style.color = Notification?.permission === 'granted' ? 'var(--success)' : 'var(--warn)';
}

function updatePresence(count) {
  document.getElementById('presenceCount').textContent = count + ' user' + (count !== 1 ? 's' : '') + ' online';
  document.getElementById('onlineCount').textContent = count + ' online';
  document.getElementById('scOnline').textContent = count;
}

/* ================================================================ */
/* HANDLE NEW NOTIFICATION                                           */
/* ================================================================ */
function handleNewNotification(notif) {
  // Prepend to list
  notifications.unshift(notif);
  if (notifications.length > 100) notifications.pop();
  sessionTotal++;
  document.getElementById('scTotal').textContent = sessionTotal;

  // Update unread
  if (!notif.read) {
    unreadCount++;
    updateBadge();
    ringBell();
  }

  // Toast popup
  showToastMsg(typeConfig[notif.type]?.icon || '🔔', notif.title, notif.message, notif.type, notif.actionUrl);

  // Sound
  if (soundEnabled) playSound(notif.type);

  // Browser notification if tab hidden
  if (document.hidden && Notification.permission === 'granted') {
    new Notification(notif.title, { body: notif.message, icon: '/icon-192.png', badge: '/badge-72.png', tag: notif.id });
  }

  renderNotifications();
  renderAllNotifications();
