async function requestPushPermission() {
  if (!('Notification' in window)) {
    showToastMsg('❌','Not Supported','Push notifications not supported in this browser','stock_warning');
    return;
  }
  const permission = await Notification.requestPermission();
  if (permission === 'granted') {
    showToastMsg('✅','Push Enabled','You\'ll receive alerts even when the tab is closed','payment');
    document.getElementById('statusNotif').textContent = '✅ GRANTED';
    document.getElementById('statusNotif').style.color = 'var(--success)';
    await registerServiceWorker();
  } else {
    showToastMsg('⚠️','Permission Denied','Enable notifications in browser settings','stock_warning');
  }
}

async function registerServiceWorker() {
  if (!('serviceWorker' in navigator)) return;
  try {
    const reg = await navigator.serviceWorker.register('/sw.js');
    console.log('[SW] Registered:', reg.scope);
    document.getElementById('statusSW').textContent = '✅ ACTIVE';
    document.getElementById('statusSW').style.color = 'var(--success)';
  } catch (e) {
    console.warn('[SW] Registration failed:', e);
  }
}

// Register SW on load
if ('serviceWorker' in navigator) {
  window.addEventListener('load', registerServiceWorker);
  // Handle SW messages (notification click)
  navigator.serviceWorker.addEventListener('message', ({ data }) => {
    if (data?.type === 'NOTIFICATION_CLICK' && data.notifId) markOneRead(data.notifId);
  });
}

