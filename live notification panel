/* ================================================================ */
/* SOUND SYSTEM                                                      */
/* ================================================================ */
let audioCtx = null;
function getAudioCtx() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return audioCtx;
}

const soundProfiles = {
  drop:         [[880,.1],[1100,.08],[1320,.12],[1760,.2]],
  payment:      [[523,.1],[659,.08],[784,.1],[1047,.3]],
  order:        [[440,.08],[550,.1],[660,.15]],
  shipping:     [[330,.1],[440,.12],[550,.1]],
  restock:      [[440,.1],[554,.1],[660,.15]],
  stock_warning:[[300,.15],[200,.2]],
  announcement: [[880,.1],[880,.05],[1100,.2]],
  chime:        [[523,.08],[659,.08],[784,.15]],
};

function playSound(type) {
  if (!soundEnabled) return;
  try {
    const ctx = getAudioCtx();
    const profile = soundProfiles[type] || soundProfiles.chime;
    let time = ctx.currentTime;
    profile.forEach(([freq, dur]) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = type === 'drop' ? 'sawtooth' : 'sine';
      osc.frequency.setValueAtTime(freq, time);
      gain.gain.setValueAtTime(.12, time);
      gain.gain.exponentialRampToValueAtTime(.001, time + dur);
      osc.start(time); osc.stop(time + dur);
      time += dur;
    });
  } catch {}
}

function toggleSound() {
  soundEnabled = !soundEnabled;
  const btn = document.getElementById('soundToggle');
  btn.textContent = soundEnabled ? '🔊' : '🔇';
  btn.classList.toggle('muted', !soundEnabled);
  document.getElementById('statusSound').textContent = soundEnabled ? '🔊 ON' : '🔇 OFF';
  showToastMsg(soundEnabled?'🔊':'🔇', 'Sound', soundEnabled ? 'Sound enabled' : 'Sound muted', 'announcement');
}

