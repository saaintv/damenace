let toastId = 0;
function showToastMsg(icon, title, message, type = 'announcement', actionUrl = '') {
  const id = 'toast-' + (++toastId);
  const color = typeConfig[type]?.color || 'var(--red)';
  const duration = 5000;

  const el = document.createElement('div');
  el.className = 'toast';
  el.id = id;
  el.style.setProperty('--type-color', color);
  el.innerHTML = `
    <span class="toast-icon">${icon}</span>
    <div class="toast-body">
      <div class="toast-title">${esc(title)}</div>
      <div class="toast-msg">${esc(message)}</div>
      <div class="toast-time">${formatTime(new Date())}</div>
    </div>
    <button class="toast-close" onclick="dismissToast('${id}')">✕</button>
    <div class="toast-progress" id="${id}-prog" style="width:100%;"></div>`;

  el.onclick = (e) => {
    if (e.target.classList.contains('toast-close')) return;
    if (actionUrl) { /* navigate */ }
    dismissToast(id);
  };

  document.getElementById('toastContainer').appendChild(el);
  requestAnimationFrame(() => {
    requestAnimationFrame(() => { el.classList.add('show'); });
  });

  // Progress bar
  const prog = document.getElementById(id + '-prog');
  let startTime = Date.now();
  const tick = () => {
    const elapsed = Date.now() - startTime;
    const pct = Math.max(0, 100 - (elapsed / duration) * 100);
    if (prog) prog.style.width = pct + '%';
    if (pct > 0) requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);

  setTimeout(() => dismissToast(id), duration);

  // Keep max 5 toasts
  const toasts = document.querySelectorAll('.toast');
  if (toasts.length > 5) dismissToast(toasts[0].id);
}

function dismissToast(id) {
  const el = document.getElementById(id);
  if (!el) return;
  el.classList.add('exit');
  setTimeout(() => el.remove(), 400);
}

