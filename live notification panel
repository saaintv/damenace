<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<meta name="theme-color" content="#05030a"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<title>MENACE 2 SOCIETY — Live Notifications</title>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
<!-- Socket.IO client — served by server, or via CDN -->
<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
<style>
/* ================================================================ */
/* TOKENS                                                            */
/* ================================================================ */
:root{
  --bg:#05030a;--bg2:#0a060f;--bg3:#110a18;--bg4:#18102000;
  --surface:#1a0e22;--surface2:#231529;--surface3:#2c1a34;
  --glass:rgba(26,14,34,.82);--glass2:rgba(10,6,15,.9);
  --red:#d4001a;--red2:#f01428;--red3:#ff2438;
  --gold:#c8922a;--gold2:#e0a83a;
  --silver:#a0a8b4;--silver2:#c8d0dc;
  --text:#f2eaf5;--text2:#c4b0cc;--text3:#8a728e;--text4:#4a3650;
  --border:rgba(212,0,26,.14);--border2:rgba(212,0,26,.28);--border3:rgba(212,0,26,.5);
  --success:#1db954;--warn:#f0b93a;--info:#4a8af0;
  --toast-w:380px;
  --notif-drop:  #d4001a;
  --notif-order: #c8922a;
  --notif-payment:#1db954;
  --notif-restock:#4a8af0;
  --notif-shipping:#8a4af0;
  --notif-warning:#f0b93a;
  --notif-announcement:#d44af0;
}

*{margin:0;padding:0;box-sizing:border-box;}
html{font-size:15px;scroll-behavior:smooth;}
body{
  background:var(--bg);color:var(--text);font-family:'Montserrat',sans-serif;
  overflow-x:hidden;min-height:100vh;
  background-image:
    radial-gradient(ellipse 60% 40% at 80% 10%,rgba(212,0,26,.07),transparent),
    radial-gradient(ellipse 50% 60% at 10% 80%,rgba(200,146,42,.04),transparent);
}

/* GRAIN */
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:.45;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='.04'/%3E%3C/svg%3E");}

::-webkit-scrollbar{width:3px;}::-webkit-scrollbar-track{background:var(--bg2);}::-webkit-scrollbar-thumb{background:var(--red);border-radius:2px;}

/* ================================================================ */
/* NAVBAR                                                            */
/* ================================================================ */
.navbar{
  position:fixed;top:0;left:0;right:0;height:62px;z-index:500;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 5%;
  background:var(--glass2);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
}
.nav-logo{font-family:'Anton',sans-serif;font-size:1.5rem;letter-spacing:5px;}
.nav-logo span{color:var(--red2);}
.nav-links{display:flex;gap:0;}
.nav-link{padding:0 16px;height:62px;display:flex;align-items:center;font-size:.68rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);cursor:pointer;transition:.2s;border-bottom:2px solid transparent;}
.nav-link:hover{color:var(--text);border-bottom-color:rgba(212,0,26,.4);}
.nav-link.active{color:var(--text);border-bottom-color:var(--red);}
.nav-right{display:flex;align-items:center;gap:8px;}
.conn-dot{width:8px;height:8px;border-radius:50%;background:#333;transition:.4s;flex-shrink:0;}
.conn-dot.connected{background:var(--success);box-shadow:0 0 8px var(--success);}
.conn-dot.connecting{background:var(--warn);animation:connPulse 1s infinite;}
@keyframes connPulse{0%,100%{opacity:1;}50%{opacity:.3;}}
.online-count{font-size:.6rem;letter-spacing:2px;color:var(--text3);}

/* ── BELL ────────────────────────────────────────────────────── */
.bell-wrap{position:relative;cursor:pointer;}
.bell-btn{
  width:42px;height:42px;background:var(--surface);border:1px solid var(--border);
  border-radius:2px;display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;transition:.2s;position:relative;cursor:pointer;
}
.bell-btn:hover{background:var(--surface2);border-color:var(--border2);}
.bell-btn.ringing{animation:bellRing .5s ease 0s 2;}
@keyframes bellRing{0%{transform:rotate(0);}25%{transform:rotate(16deg);}50%{transform:rotate(-14deg);}75%{transform:rotate(8deg);}100%{transform:rotate(0);}}

.badge{
  position:absolute;top:-5px;right:-5px;
  background:var(--red);color:white;
  min-width:18px;height:18px;border-radius:9px;
  font-size:.6rem;font-weight:900;letter-spacing:.5px;
  display:flex;align-items:center;justify-content:center;padding:0 4px;
  border:2px solid var(--bg);
  animation:badgePop .3s cubic-bezier(.34,1.56,.64,1) both;
  display:none;
}
.badge.visible{display:flex;}
@keyframes badgePop{from{transform:scale(0);}to{transform:scale(1);}}

/* ── NOTIFICATION CENTER ────────────────────────────────────── */
.notif-center{
  position:fixed;top:70px;right:18px;width:400px;max-height:80vh;
  background:var(--glass);border:1px solid var(--border2);
  backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);
  z-index:600;display:flex;flex-direction:column;
  transform:translateY(-16px) scale(.97);opacity:0;pointer-events:none;
  transition:all .28s cubic-bezier(.25,.46,.45,.94);
  box-shadow:0 24px 60px rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.04);
}
.notif-center.open{transform:translateY(0) scale(1);opacity:1;pointer-events:all;}

.nc-header{
  padding:16px 18px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;flex-shrink:0;
}
.nc-title{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:3px;}
.nc-meta{font-size:.6rem;letter-spacing:2px;color:var(--text3);}
.nc-actions{display:flex;gap:6px;}
.nc-action-btn{
  padding:5px 10px;background:none;border:1px solid var(--border);
  color:var(--text3);font-size:.6rem;letter-spacing:1px;cursor:pointer;
  transition:.15s;font-family:'Montserrat',sans-serif;text-transform:uppercase;
}
.nc-action-btn:hover{border-color:var(--red);color:var(--red2);}
.sound-toggle{padding:5px 8px;background:none;border:1px solid var(--border);color:var(--text3);cursor:pointer;font-size:.85rem;transition:.15s;}
.sound-toggle:hover{border-color:var(--gold);color:var(--gold);}
.sound-toggle.muted{color:var(--text4);}

.nc-filters{
  display:flex;gap:0;border-bottom:1px solid var(--border);padding:0 14px;overflow-x:auto;
  -ms-overflow-style:none;scrollbar-width:none;flex-shrink:0;
}
.nc-filters::-webkit-scrollbar{display:none;}
.nc-filter{
  padding:8px 12px;font-size:.6rem;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--text3);cursor:pointer;border-bottom:2px solid transparent;transition:.15s;white-space:nowrap;
}
.nc-filter:hover{color:var(--text2);}
.nc-filter.active{color:var(--red2);border-bottom-color:var(--red);}

.nc-list{flex:1;overflow-y:auto;padding:8px;}
.nc-list::-webkit-scrollbar{width:2px;}
.nc-list::-webkit-scrollbar-thumb{background:var(--border2);}

.nc-empty{text-align:center;padding:40px 20px;color:var(--text4);}
.nc-empty-icon{font-size:2.2rem;display:block;margin-bottom:10px;opacity:.3;}
.nc-empty-text{font-size:.7rem;letter-spacing:2px;text-transform:uppercase;}

/* ── NOTIFICATION ITEM ────────────────────────────────────── */
.notif-item{
  display:flex;align-items:flex-start;gap:12px;padding:12px 10px;
  border-radius:2px;cursor:pointer;transition:.18s;position:relative;
  border-left:2px solid transparent;margin-bottom:2px;
}
.notif-item:hover{background:rgba(255,255,255,.03);}
.notif-item.unread{background:rgba(212,0,26,.04);border-left-color:var(--red);}
.notif-item.unread::after{content:'';position:absolute;right:10px;top:50%;transform:translateY(-50%);width:6px;height:6px;background:var(--red2);border-radius:50%;}

.notif-icon-wrap{
  width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;flex-shrink:0;position:relative;
}
.notif-body{flex:1;min-width:0;}
.notif-title{font-size:.8rem;font-weight:700;letter-spacing:.5px;margin-bottom:3px;line-height:1.3;}
.notif-message{font-size:.72rem;color:var(--text2);line-height:1.5;margin-bottom:4px;}
.notif-time{font-size:.6rem;color:var(--text4);letter-spacing:1px;}
.notif-delete{
  opacity:0;background:none;border:none;color:var(--text4);font-size:.85rem;
  cursor:pointer;transition:.15s;flex-shrink:0;padding:4px;
  align-self:center;
}
.notif-item:hover .notif-delete{opacity:1;}
.notif-delete:hover{color:var(--red2);}

/* Type colors */
.type-drop       .notif-icon-wrap{background:rgba(212,0,26,.15);border:1px solid rgba(212,0,26,.2);}
.type-order      .notif-icon-wrap{background:rgba(200,146,42,.15);border:1px solid rgba(200,146,42,.2);}
.type-payment    .notif-icon-wrap{background:rgba(29,185,84,.15);border:1px solid rgba(29,185,84,.2);}
.type-restock    .notif-icon-wrap{background:rgba(74,138,240,.15);border:1px solid rgba(74,138,240,.2);}
.type-shipping   .notif-icon-wrap{background:rgba(138,74,240,.15);border:1px solid rgba(138,74,240,.2);}
.type-stock_warning .notif-icon-wrap{background:rgba(240,185,58,.15);border:1px solid rgba(240,185,58,.2);}
.type-announcement .notif-icon-wrap{background:rgba(212,74,240,.15);border:1px solid rgba(212,74,240,.2);}

.nc-footer{padding:12px 14px;border-top:1px solid var(--border);flex-shrink:0;}
.nc-see-all{width:100%;padding:9px;background:var(--surface2);border:1px solid var(--border);color:var(--text3);font-size:.65rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:.2s;font-family:'Montserrat',sans-serif;}
.nc-see-all:hover{background:var(--red);border-color:var(--red);color:white;}

/* ================================================================ */
/* TOAST SYSTEM                                                      */
/* ================================================================ */
.toast-container{
  position:fixed;bottom:24px;right:18px;z-index:2000;
  display:flex;flex-direction:column-reverse;gap:10px;
  max-width:var(--toast-w);pointer-events:none;
}

.toast{
  background:var(--glass);border:1px solid var(--border2);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  padding:14px 16px;display:flex;align-items:flex-start;gap:12px;
  pointer-events:all;cursor:pointer;position:relative;overflow:hidden;
  transform:translateX(120%);opacity:0;transition:all .38s cubic-bezier(.25,.46,.45,.94);
  box-shadow:0 8px 32px rgba(0,0,0,.5);min-width:280px;max-width:var(--toast-w);
}
.toast.show{transform:translateX(0);opacity:1;}
.toast.exit{transform:translateX(110%);opacity:0;}
.toast::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--type-color,var(--red));}
.toast-progress{position:absolute;bottom:0;left:0;height:2px;background:var(--type-color,var(--red));transition:width linear;opacity:.5;}
.toast-icon{font-size:1.3rem;flex-shrink:0;margin-top:1px;}
.toast-body{flex:1;min-width:0;}
.toast-title{font-size:.8rem;font-weight:700;letter-spacing:.5px;margin-bottom:3px;}
.toast-msg{font-size:.72rem;color:var(--text2);line-height:1.4;}
.toast-time{font-size:.58rem;color:var(--text4);margin-top:3px;letter-spacing:1px;}
.toast-close{background:none;border:none;color:var(--text4);font-size:.85rem;cursor:pointer;padding:2px;flex-shrink:0;transition:.15s;}
.toast-close:hover{color:var(--text);}

/* ================================================================ */
/* LIVE ANNOUNCEMENT BANNER                                          */
/* ================================================================ */
.announcement-banner{
  position:fixed;top:62px;left:0;right:0;z-index:450;
  transform:translateY(-100%);transition:.35s cubic-bezier(.25,.46,.45,.94);
}
.announcement-banner.show{transform:translateY(0);}
.banner-inner{
  display:flex;align-items:center;justify-content:center;gap:14px;
  padding:10px 5%;font-size:.75rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  position:relative;
}
.banner-close{position:absolute;right:18px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(255,255,255,.6);font-size:1rem;cursor:pointer;}
.banner-text{animation:bannerScroll 20s linear infinite;}
@keyframes bannerScroll{0%{transform:translateX(0);}50%{transform:translateX(-2%);}100%{transform:translateX(0);}}

/* ================================================================ */
/* PRESENCE / ONLINE BAR                                            */
/* ================================================================ */
.presence-bar{
  position:fixed;bottom:0;left:0;right:0;height:28px;z-index:400;
  background:rgba(5,3,10,.9);border-top:1px solid var(--border);
  display:flex;align-items:center;padding:0 5%;gap:16px;
  backdrop-filter:blur(12px);font-size:.6rem;letter-spacing:2px;color:var(--text4);
}
.presence-dot{width:6px;height:6px;background:var(--success);border-radius:50%;animation:connPulse 2s infinite;}
.typing-users{flex:1;color:var(--text3);font-style:italic;}

/* ================================================================ */
/* ORDER PROGRESS BAR                                                */
/* ================================================================ */
.order-progress-modal{
  position:fixed;bottom:50px;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--glass);border:1px solid var(--border2);backdrop-filter:blur(20px);
  padding:20px 24px;min-width:340px;max-width:90vw;z-index:700;
  opacity:0;pointer-events:none;transition:.3s;
}
.order-progress-modal.show{opacity:1;pointer-events:all;transform:translateX(-50%) translateY(0);}
.op-title{font-family:'Anton',sans-serif;letter-spacing:3px;font-size:.95rem;margin-bottom:14px;color:var(--gold);}
.op-steps{display:flex;align-items:center;gap:0;margin-bottom:10px;}
.op-step{display:flex;flex-direction:column;align-items:center;flex:1;position:relative;}
.op-step:not(:last-child)::after{content:'';position:absolute;top:14px;left:50%;right:-50%;height:2px;background:var(--border);z-index:0;transition:.5s;}
.op-step.done:not(:last-child)::after{background:var(--success);}
.op-step-dot{width:28px;height:28px;border-radius:50%;border:2px solid var(--border);background:var(--bg2);display:flex;align-items:center;justify-content:center;font-size:.7rem;z-index:1;transition:.4s;}
.op-step.done .op-step-dot{background:var(--success);border-color:var(--success);color:white;}
.op-step.active .op-step-dot{border-color:var(--gold);animation:connPulse 1.5s infinite;}
.op-step-label{font-size:.55rem;letter-spacing:1px;text-transform:uppercase;color:var(--text4);margin-top:5px;text-align:center;}
.op-step.done .op-step-label{color:var(--success);}
.op-step.active .op-step-label{color:var(--gold);}
.op-close{position:absolute;top:10px;right:12px;background:none;border:none;color:var(--text4);cursor:pointer;font-size:.85rem;}

/* ================================================================ */
/* ADMIN DASHBOARD                                                   */
/* ================================================================ */
.admin-panel{
  position:fixed;left:0;top:0;bottom:0;width:380px;
  background:var(--glass2);border-right:1px solid var(--border2);
  backdrop-filter:blur(24px);
  transform:translateX(-100%);transition:.38s cubic-bezier(.25,.46,.45,.94);
  z-index:800;display:flex;flex-direction:column;overflow:hidden;
}
.admin-panel.open{transform:translateX(0);}
.admin-panel-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:799;display:none;}
.admin-panel-overlay.open{display:block;}

.ap-header{padding:20px 22px 14px;border-bottom:1px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:space-between;}
.ap-header h2{font-family:'Anton',sans-serif;font-size:1.1rem;letter-spacing:4px;color:var(--red2);}
.ap-close{background:none;border:none;color:var(--text3);font-size:1.2rem;cursor:pointer;}

.ap-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;}
.ap-tab{flex:1;padding:10px;font-size:.6rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text3);cursor:pointer;text-align:center;border-bottom:2px solid transparent;transition:.15s;}
.ap-tab:hover{color:var(--text2);}
.ap-tab.active{color:var(--red2);border-bottom-color:var(--red);}

.ap-body{flex:1;overflow-y:auto;padding:18px;}
.ap-body::-webkit-scrollbar{width:2px;}
.ap-body::-webkit-scrollbar-thumb{background:var(--border2);}
.ap-section{margin-bottom:22px;}
.ap-label{font-size:.6rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:8px;display:block;}
.ap-input{width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:10px 13px;font-family:'Montserrat',sans-serif;font-size:.8rem;margin-bottom:8px;transition:.2s;}
.ap-input:focus{outline:none;border-color:var(--border3);}
.ap-input::placeholder{color:var(--text4);}
.ap-textarea{width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:10px 13px;font-family:'Montserrat',sans-serif;font-size:.8rem;resize:none;min-height:70px;line-height:1.5;margin-bottom:8px;}
.ap-textarea:focus{outline:none;border-color:var(--border3);}
.ap-select{width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:10px 13px;font-family:'Montserrat',sans-serif;font-size:.8rem;cursor:pointer;margin-bottom:8px;}
.ap-btn{width:100%;padding:12px;background:var(--red);border:none;color:white;font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:.2s;margin-bottom:8px;}
.ap-btn:hover{background:var(--red2);}
.ap-btn.secondary{background:var(--surface2);border:1px solid var(--border);}
.ap-btn.secondary:hover{border-color:var(--red);background:rgba(212,0,26,.08);}
.ap-btn.gold{background:var(--gold);color:var(--bg);}
.ap-btn.gold:hover{background:var(--gold2);}

/* Analytics */
.analytics-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
.analytics-card{background:var(--surface);border:1px solid var(--border);padding:12px 14px;}
.analytics-num{font-family:'Anton',sans-serif;font-size:1.6rem;letter-spacing:2px;line-height:1;}
.analytics-label{font-size:.58rem;letter-spacing:2px;color:var(--text3);text-transform:uppercase;margin-top:3px;}
.analytics-num.red{color:var(--red2);}
.analytics-num.gold{color:var(--gold2);}
.analytics-num.green{color:var(--success);}
.type-breakdown{display:flex;flex-direction:column;gap:5px;}
.type-bar-row{display:flex;align-items:center;gap:8px;font-size:.65rem;}
.type-bar-label{width:90px;color:var(--text3);flex-shrink:0;letter-spacing:1px;}
.type-bar-track{flex:1;height:4px;background:var(--surface);border-radius:2px;}
.type-bar-fill{height:100%;background:var(--red);border-radius:2px;transition:.6s;}
.type-bar-count{width:25px;text-align:right;color:var(--text3);}

/* Users list */
.users-list{display:flex;flex-direction:column;gap:6px;}
.user-row{display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--surface);border:1px solid var(--border);}
.user-dot{width:8px;height:8px;background:var(--success);border-radius:50%;flex-shrink:0;}
.user-name{font-size:.78rem;font-weight:600;flex:1;}
.user-role{font-size:.58rem;letter-spacing:1px;padding:2px 6px;}
.role-admin{background:rgba(212,0,26,.15);color:var(--red2);border:1px solid var(--border);}
.role-user{background:rgba(200,146,42,.1);color:var(--gold);border:1px solid rgba(200,146,42,.2);}
.role-guest{background:rgba(255,255,255,.04);color:var(--text3);border:1px solid var(--border);}

/* Scheduled jobs */
.job-row{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--surface);border:1px solid var(--border);margin-bottom:5px;font-size:.72rem;}
.job-title{flex:1;font-weight:600;}
.job-time{color:var(--text3);font-size:.62rem;}
.job-cancel{background:none;border:1px solid rgba(212,0,26,.2);color:var(--red);font-size:.58rem;padding:2px 7px;cursor:pointer;letter-spacing:1px;font-family:'Montserrat',sans-serif;transition:.15s;}
.job-cancel:hover{background:var(--red);color:white;}

/* ================================================================ */
/* MAIN CONTENT                                                      */
/* ================================================================ */
.main-content{padding:100px 5% 60px;}
.page-section{display:none;}
.page-section.active{display:block;}

.hero-area{text-align:center;padding:60px 0 80px;}
.hero-eyebrow{font-size:.62rem;letter-spacing:7px;color:var(--red);text-transform:uppercase;display:block;margin-bottom:18px;}
.hero-h1{font-family:'Anton',sans-serif;font-size:clamp(3rem,8vw,7rem);line-height:.9;letter-spacing:3px;text-transform:uppercase;margin-bottom:18px;}
.hero-h1 .r{color:var(--red2);}
.hero-sub{font-size:.78rem;letter-spacing:3px;color:var(--text3);text-transform:uppercase;margin-bottom:40px;}
.hero-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;}

/* STATUS CARDS */
.status-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-bottom:40px;}
.status-card{background:var(--surface);border:1px solid var(--border);padding:18px 20px;position:relative;overflow:hidden;}
.status-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--card-color,var(--red));}
.sc-label{font-size:.58rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:6px;}
.sc-value{font-family:'Anton',sans-serif;font-size:2rem;letter-spacing:2px;line-height:1;color:var(--text);}
.sc-sub{font-size:.62rem;color:var(--text4);margin-top:4px;letter-spacing:1px;}

/* DEMO BUTTONS */
.demo-section{background:var(--surface);border:1px solid var(--border);padding:28px;margin-bottom:28px;}
.demo-section h3{font-family:'Anton',sans-serif;letter-spacing:3px;font-size:1rem;margin-bottom:18px;color:var(--red2);}
.demo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px;}
.demo-btn{
  padding:12px 14px;background:var(--surface2);border:1px solid var(--border);
  color:var(--text2);font-family:'Montserrat',sans-serif;font-size:.68rem;font-weight:600;
  letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:.2s;
  display:flex;align-items:center;gap:8px;
}
.demo-btn:hover{border-color:var(--border3);background:rgba(212,0,26,.08);color:var(--text);}
.demo-btn .demo-icon{font-size:1rem;flex-shrink:0;}

/* ================================================================ */
/* MOBILE                                                            */
/* ================================================================ */
@media(max-width:640px){
  .nav-links{display:none;}
  .notif-center{right:0;left:0;width:auto;top:62px;border-left:none;border-right:none;max-height:70vh;}
  .toast-container{left:12px;right:12px;max-width:none;}
  .admin-panel{width:100%;}
  :root{--toast-w:calc(100vw - 24px);}
}
@media(max-width:480px){
  .hero-h1{font-size:2.8rem;}
  .status-grid{grid-template-columns:1fr 1fr;}
  .demo-grid{grid-template-columns:1fr 1fr;}
}

/* ================================================================ */
/* ANIMATIONS                                                        */
/* ================================================================ */
@keyframes slideInLeft{from{transform:translateX(-30px);opacity:0;}to{transform:translateX(0);opacity:1;}}
@keyframes slideInRight{from{transform:translateX(30px);opacity:0;}to{transform:translateX(0);opacity:1;}}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.anim-in{animation:fadeIn .35s ease both;}
</style>
</head>
