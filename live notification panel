    socket.emit('admin:send_user', { userId, title, message, type, image: typeConfig[type]?.icon, actionUrl: '/orders' });
  } else {
    handleNewNotification({ id: uuid(), userId, title, message, type, image: typeConfig[type]?.icon||'🔔', actionUrl: '/orders', timestamp: new Date().toISOString(), read: false });
  }
  showToastMsg('➤','Sent',`Notification sent to ${userId}`,'announcement');
}

function adminSchedule() {
  const title = document.getElementById('ap-sched-title')?.value?.trim();
  const message = document.getElementById('ap-sched-msg')?.value?.trim();
  const scheduledAt = document.getElementById('ap-sched-time')?.value;
  if (!title || !message || !scheduledAt) { showToastMsg('⚠️','Missing','Fill all schedule fields','stock_warning'); return; }
  if (socket?.connected) {
    socket.emit('admin:schedule', { title, message, type: 'announcement', scheduledAt, image: '📣', actionUrl: '/drops' });
  } else {
    const delay = new Date(scheduledAt).getTime() - Date.now();
    if (delay > 0) {
      setTimeout(() => handleNewNotification({ id: uuid(), userId: 'demo', title, message, type: 'announcement', image: '📣', actionUrl: '/drops', timestamp: new Date().toISOString(), read: false }), delay);
      showToastMsg('⏰','Scheduled',`"${title}" scheduled for ${new Date(scheduledAt).toLocaleTimeString()}`,'announcement');
    } else showToastMsg('⚠️','Invalid','Scheduled time must be in the future','stock_warning');
  }
}

function adminCancelJob(jobId) {
  scheduledJobs = scheduledJobs.filter(j => j.id !== jobId);
  if (socket?.connected) socket.emit('admin:cancel_job', jobId);
  renderAdminTab();
  showToastMsg('🗑️','Cancelled','Scheduled job cancelled','announcement');
}

function fireDropEvent() {
  const name = 'ORIGINS VOL.1';
  if (socket?.connected) {
    socket.emit('event:new_drop', { name, description: 'Limited edition collection. Every piece is unique.', url: '/shop' });
  } else {
    handleNewNotification({ id: uuid(), userId: 'demo', title: `🔥 ${name} IS LIVE`, message: 'New collection just dropped. Shop now before it sells out.', type: 'drop', image: '🔥', actionUrl: '/shop', timestamp: new Date().toISOString(), read: false });
    showBanner(`🔥 ${name} IS LIVE — SHOP NOW`, '#d4001a');
  }
}

/* ================================================================ */
/* SECTION NAVIGATION                                                */
/* ================================================================ */
function showSection(id) {
  document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
  document.getElementById('section-' + id)?.classList.add('active');
  document.querySelectorAll('.nav-link').forEach((l, i) => {
    const ids = ['home', 'notifications', 'orders'];
    l.classList.toggle('active', ids[i] === id);
  });
  if (id === 'notifications') renderAllNotifications();
}

/* ================================================================ */
/* UTILITIES                                                         */
/* ================================================================ */
let _uidCtr = 0;
function uuid() { return 'n-' + Date.now() + '-' + (++_uidCtr); }

function esc(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function formatTime(date) {
  const now = new Date();
  const diff = (now - date) / 1000;
  if (diff < 60) return 'Just now';
  if (diff < 3600) return Math.floor(diff/60) + 'm ago';
  if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
  return date.toLocaleDateString();
}

