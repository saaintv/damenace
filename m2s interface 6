      background: var(--ink-3);
      border: 1px solid var(--b);
      color: var(--text);
      padding: 11px 14px;
      font-family: var(--body);
      font-size: 0.82rem;
      width: 100%;
      transition: border-color 0.2s;
      border-radius: var(--r);
    }

    .form-input:focus,
    .form-textarea:focus,
    .form-select:focus {
      outline: none;
      border-color: var(--b-2);
    }

