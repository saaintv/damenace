// ── In-memory "DB" (replace with MongoDB/Firebase in production) ─
const db = {
  notifications: [], // { id, userId, title, message, type, timestamp, read, image, actionUrl }
  users: new Map(),  // socketId → { id, username, role }
  subscriptions: new Map(), // userId → pushSubscription
  scheduledJobs: new Map(), // jobId → nodeScheduleJob
  analytics: {
    totalSent: 0, totalRead: 0, byType: {}, hourly: []
  }
};

// Seed demo notifications
