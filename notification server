  const demos = [
    { title: 'ORIGINS VOL.1 IS LIVE', message: 'The new collection just dropped. Limited pieces available now.', type: 'drop', image: '🔥', actionUrl: '/shop' },
    { title: 'ORDER CONFIRMED', message: 'Order #M2S-4821 has been confirmed. We\'re preparing your chaos.', type: 'payment', image: '✅', actionUrl: '/orders/4821' },
    { title: 'LOW STOCK ALERT', message: 'Chaos Denim Jacket in size M — only 2 left. Secure yours now.', type: 'stock_warning', image: '⚠️', actionUrl: '/product/chaos-denim' },
    { title: 'SHIPPED', message: 'Your order is on its way. Tracking: M2S-TRK-7734', type: 'shipping', image: '📦', actionUrl: '/track/7734' },
    { title: 'FEAR ME HOODIE RESTOCKED', message: 'The sold-out Fear Me Hoodie is back — all sizes available.', type: 'restock', image: '♻️', actionUrl: '/product/fear-me-hoodie' },
