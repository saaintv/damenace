// ── Express Setup ───────────────────────────────────────────────
const app = express();
const httpServer = http.createServer(app);

app.use(helmet({ contentSecurityPolicy: false }));
app.use(cors({ origin: '*', methods: ['GET', 'POST', 'PUT', 'DELETE'] }));
app.use(express.json());
app.use(express.static(path.join(__dirname, '../public')));

const limiter = rateLimit({ windowMs: 60000, max: 100, message: { error: 'Rate limit exceeded' } });
app.use('/api/', limiter);

// ── Socket.IO ───────────────────────────────────────────────────
const io = new Server(httpServer, {
  cors: { origin: '*', methods: ['GET', 'POST'] },
  pingTimeout: 60000,
  pingInterval: 25000
});

// JWT Auth Middleware for Socket
io.use((socket, next) => {
  const token = socket.handshake.auth?.token || socket.handshake.query?.token;
  if (!token) {
    // Allow guest connections with limited access
    socket.data.user = { id: 'guest_' + uuidv4().slice(0, 8), username: 'Guest', role: 'guest' };
    return next();
  }
  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    socket.data.user = decoded;
    next();
  } catch (err) {
    socket.data.user = { id: 'guest_' + uuidv4().slice(0, 8), username: 'Guest', role: 'guest' };
    next();
  }
});

// ── Socket Event Handlers ───────────────────────────────────────
io.on('connection', (socket) => {
  const user = socket.data.user;
  db.users.set(socket.id, { ...user, connectedAt: new Date().toISOString(), socketId: socket.id });

  console.log(`[CONNECTED] ${user.username} (${socket.id})`);

  // Join user-specific room
  socket.join(`user:${user.id}`);
  if (user.role === 'admin') socket.join('admins');

  // Broadcast updated online count
  broadcastPresence();

  // Send pending notifications on connect
  const userNotifs = db.notifications
    .filter(n => n.userId === user.id || n.userId === 'all')
    .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))
    .slice(0, 50);
  socket.emit('notification:history', userNotifs);

  // ── Incoming Events ──────────────────────────────────────────

  // Admin: broadcast to all
  socket.on('admin:broadcast', (data) => {
    if (user.role !== 'admin') return socket.emit('error', { message: 'Unauthorized' });
    const notif = createNotification('all', sanitize(data));
    io.emit('notification:new', notif);
    trackAnalytics(notif.type);
  });

  // Admin: send to specific user
  socket.on('admin:send_user', (data) => {
    if (user.role !== 'admin') return socket.emit('error', { message: 'Unauthorized' });
    const notif = createNotification(data.userId, sanitize(data));
    io.to(`user:${data.userId}`).emit('notification:new', notif);
    trackAnalytics(notif.type);
  });

  // Admin: schedule notification
  socket.on('admin:schedule', (data) => {
    if (user.role !== 'admin') return socket.emit('error', { message: 'Unauthorized' });
    const jobId = uuidv4();
    const runAt = new Date(data.scheduledAt);
    const job = schedule.scheduleJob(runAt, () => {
      const notif = createNotification(data.userId || 'all', sanitize(data));
      if (data.userId === 'all') io.emit('notification:new', notif);
      else io.to(`user:${data.userId}`).emit('notification:new', notif);
      db.scheduledJobs.delete(jobId);
      socket.emit('admin:job_complete', { jobId, notif });
    });
    db.scheduledJobs.set(jobId, { job, data, runAt: runAt.toISOString() });
    socket.emit('admin:job_scheduled', { jobId, runAt: runAt.toISOString() });
  });

  // Admin: trigger drop event
  socket.on('event:new_drop', (data) => {
    if (user.role !== 'admin') return;
    const notif = createNotification('all', {
      title: `🔥 ${sanitizeStr(data.name)} IS LIVE`,
      message: `${sanitizeStr(data.description || 'New collection just dropped.')} Shop now before it sells out.`,
      type: 'drop', image: '🔥', actionUrl: data.url || '/shop'
    });
    io.emit('notification:new', notif);
    io.emit('banner:announcement', { text: `🔥 ${data.name} IS LIVE — SHOP NOW`, color: '#d4001a', urgent: true });
    trackAnalytics('drop');
  });

  // Admin: order update
  socket.on('event:order_update', (data) => {
    const notif = createNotification(data.userId, {
      title: `ORDER #${data.orderId} UPDATE`,
      message: sanitizeStr(data.message),
      type: 'order', image: '📦', actionUrl: `/orders/${data.orderId}`
    });
    io.to(`user:${data.userId}`).emit('notification:new', notif);
  });

  // Admin: payment success
  socket.on('event:payment_success', (data) => {
    const notif = createNotification(data.userId, {
      title: 'PAYMENT CONFIRMED', message: `Order #${data.orderId} — $${data.amount} charged successfully.`,
      type: 'payment', image: '✅', actionUrl: `/orders/${data.orderId}`
    });
    io.to(`user:${data.userId}`).emit('notification:new', notif);
    io.to(`user:${data.userId}`).emit('order:progress', { orderId: data.orderId, step: 1, label: 'Payment Confirmed' });
  });

  // Admin: restock alert
  socket.on('event:restock_alert', (data) => {
    const notif = createNotification('all', {
      title: `♻️ ${sanitizeStr(data.productName)} RESTOCKED`,
      message: `Back in stock — all sizes available. Don't sleep on it.`,
      type: 'restock', image: '♻️', actionUrl: data.productUrl || '/shop'
    });
    io.emit('notification:new', notif);
    trackAnalytics('restock');
  });

  // Admin: stock warning
  socket.on('event:stock_warning', (data) => {
    const notif = createNotification('all', {
      title: `⚠️ LOW STOCK: ${sanitizeStr(data.productName)}`,
      message: `Only ${data.remaining} left in ${data.size}. Move fast.`,
      type: 'stock_warning', image: '⚠️', actionUrl: data.productUrl || '/shop'
    });
    io.emit('notification:new', notif);
  });

  // Admin: shipping update
  socket.on('event:shipping_update', (data) => {
    const notif = createNotification(data.userId, {
      title: '📦 SHIPPING UPDATE',
      message: sanitizeStr(data.message),
      type: 'shipping', image: '📦', actionUrl: `/track/${data.trackingId}`
    });
    io.to(`user:${data.userId}`).emit('notification:new', notif);
    io.to(`user:${data.userId}`).emit('order:progress', {
      orderId: data.orderId, step: data.step, label: data.stepLabel, tracking: data.trackingId
    });
  });

  // User: mark read
  socket.on('notification:read', (notifId) => {
    const notif = db.notifications.find(n => n.id === notifId);
    if (notif && (notif.userId === user.id || notif.userId === 'all')) {
      notif.read = true;
      db.analytics.totalRead++;
      socket.emit('notification:updated', { id: notifId, read: true });
    }
  });

  // User: mark all read
  socket.on('notification:read_all', () => {
    db.notifications.filter(n => n.userId === user.id || n.userId === 'all')
      .forEach(n => { n.read = true; });
    socket.emit('notification:all_read');
  });

  // User: delete notification
  socket.on('notification:delete', (notifId) => {
    const idx = db.notifications.findIndex(n => n.id === notifId && (n.userId === user.id || n.userId === 'all'));
    if (idx !== -1) {
      db.notifications.splice(idx, 1);
      socket.emit('notification:deleted', notifId);
    }
  });

  // User: clear all
  socket.on('notification:clear_all', () => {
    db.notifications = db.notifications.filter(n => n.userId !== user.id && n.userId !== 'all');
    socket.emit('notification:cleared');
  });

  // Web Push subscription
  socket.on('push:subscribe', (subscription) => {
    db.subscriptions.set(user.id, subscription);
    socket.emit('push:subscribed', { success: true });
  });

  // Typing indicator
  socket.on('activity:typing', (data) => {
    socket.broadcast.emit('activity:typing', { userId: user.id, username: user.username, ...data });
  });

  // Get analytics (admin)
  socket.on('admin:get_analytics', () => {
    if (user.role !== 'admin') return;
    socket.emit('admin:analytics', getAnalytics());
  });

  // Get connected users (admin)
  socket.on('admin:get_users', () => {
    if (user.role !== 'admin') return;
    socket.emit('admin:users', getConnectedUsers());
  });

  // Get scheduled jobs (admin)
  socket.on('admin:get_scheduled', () => {
    if (user.role !== 'admin') return;
    const jobs = Array.from(db.scheduledJobs.entries()).map(([id, j]) => ({
      id, runAt: j.runAt, title: j.data.title
    }));
    socket.emit('admin:scheduled_jobs', jobs);
  });

  // Cancel scheduled job
  socket.on('admin:cancel_job', (jobId) => {
    if (user.role !== 'admin') return;
    const entry = db.scheduledJobs.get(jobId);
    if (entry) { entry.job.cancel(); db.scheduledJobs.delete(jobId); }
    socket.emit('admin:job_cancelled', jobId);
  });

  // Disconnect
  socket.on('disconnect', () => {
    console.log(`[DISCONNECTED] ${user.username} (${socket.id})`);
    db.users.delete(socket.id);
    broadcastPresence();
  });
});

// ── Helper Functions ────────────────────────────────────────────
function createNotification(userId, data) {
  const notif = {
    id: uuidv4(), userId,
    title: data.title || 'Notification',
    message: data.message || '',
    type: data.type || 'announcement',
    timestamp: new Date().toISOString(),
    read: false,
    image: data.image || '🔔',
    actionUrl: data.actionUrl || '/'
  };
  db.notifications.push(notif);
  db.analytics.totalSent++;
  return notif;
}

function sanitize(data) {
  return {
    ...data,
    title: sanitizeStr(data.title),
    message: sanitizeStr(data.message)
  };
}

function sanitizeStr(str) {
  if (!str) return '';
  // Simple sanitization without sanitize-html dependency
  return String(str).replace(/<[^>]*>/g, '').replace(/[<>&"']/g, c =>
    ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;', "'": '&#39;' }[c])
  ).substring(0, 500);
}

function broadcastPresence() {
  const count = db.users.size;
  io.emit('presence:update', { count, users: getConnectedUsers() });
}

function getConnectedUsers() {
  return Array.from(db.users.values()).map(u => ({
    id: u.id, username: u.username, role: u.role, connectedAt: u.connectedAt
  }));
}

function trackAnalytics(type) {
  if (!db.analytics.byType[type]) db.analytics.byType[type] = 0;
  db.analytics.byType[type]++;
  const hour = new Date().toISOString().slice(0, 13);
  const existing = db.analytics.hourly.find(h => h.hour === hour);
  if (existing) existing.count++; else db.analytics.hourly.push({ hour, count: 1 });
  if (db.analytics.hourly.length > 48) db.analytics.hourly.shift();
}

function getAnalytics() {
  return {
    totalSent: db.analytics.totalSent,
    totalRead: db.analytics.totalRead,
    byType: db.analytics.byType,
    hourly: db.analytics.hourly,
    connectedUsers: db.users.size,
    totalNotifications: db.notifications.length
  };
}

