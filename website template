<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Menace 2 Society</title>

<link href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#050505;
    color:white;
    font-family:'Montserrat',sans-serif;
    overflow-x:hidden;
}

/* NAVBAR */

nav{
    width:100%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 8%;
    position:fixed;
    top:0;
    z-index:999;
    background:rgba(0,0,0,0.6);
    backdrop-filter:blur(10px);
}

.logo{
    font-family:'Anton',sans-serif;
    font-size:2rem;
    letter-spacing:3px;
    text-transform:uppercase;
}

.nav-links{
    display:flex;
    gap:30px;
}

.nav-links a{
    color:white;
    text-decoration:none;
    font-size:0.95rem;
    transition:0.3s;
}

.nav-links a:hover{
    color:#ff2e2e;
}

/* HERO */

.hero{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    position:relative;
    overflow:hidden;
    background:
    linear-gradient(rgba(0,0,0,.7),rgba(0,0,0,.8)),
    url('https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1600&auto=format&fit=crop') center/cover;
}

.hero::before{
    content:'';
    position:absolute;
    width:500px;
    height:500px;
    background:#ff000040;
    border-radius:50%;
    filter:blur(120px);
    animation: pulse 5s infinite;
}

@keyframes pulse{
    0%{transform:scale(1);}
    50%{transform:scale(1.3);}
    100%{transform:scale(1);}
}

.hero-content{
    position:relative;
    z-index:2;
    padding:20px;
}

.hero h1{
    font-size:6rem;
    font-family:'Anton',sans-serif;
    text-transform:uppercase;
    line-height:0.95;
    letter-spacing:5px;
}

.hero p{
    margin-top:20px;
    font-size:1.1rem;
    color:#cfcfcf;
    letter-spacing:2px;
}

.hero-btns{
    margin-top:40px;
    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
}

.hero-btns a{
    padding:14px 30px;
    border:1px solid white;
    color:white;
    text-decoration:none;
    transition:0.3s;
    text-transform:uppercase;
    letter-spacing:2px;
}

.hero-btns a:hover{
    background:#ff2e2e;
    border-color:#ff2e2e;
}

/* MOST WANTED SECTION */

.triple-section{
    padding:100px 8%;
    background:#0a0a0a;
}

.section-title{
    text-align:center;
    font-size:3rem;
    font-family:'Anton',sans-serif;
    margin-bottom:60px;
    letter-spacing:3px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

.card{
    background:#111;
    border:1px solid #222;
    padding:40px;
    min-height:350px;
    position:relative;
    overflow:hidden;
    transition:0.4s;
}

.card:hover{
    transform:translateY(-10px);
    border-color:#ff2e2e;
}

.card h2{
    font-family:'Anton',sans-serif;
    font-size:2.5rem;
    margin-bottom:20px;
    text-transform:uppercase;
}

.card p{
    color:#bbb;
    line-height:1.7;
}

.card::after{
    content:'';
    position:absolute;
    bottom:-80px;
    right:-80px;
    width:200px;
    height:200px;
    background:#ff000020;
    border-radius:50%;
}

/* SHOP */

.shop{
    padding:100px 8%;
}

.products{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

.product{
    background:#111;
    padding:20px;
    border:1px solid #222;
    transition:0.3s;
}

.product:hover{
    border-color:#ff2e2e;
}

.product img{
    width:100%;
    height:350px;
    object-fit:cover;
}

.product h3{
    margin-top:20px;
    font-size:1.2rem;
}

.product p{
    margin-top:10px;
    color:#ff2e2e;
    font-weight:bold;
}

/* LOOKBOOK */

.gallery{
    padding:100px 8%;
    background:#0b0b0b;
}

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.gallery-grid img{
    width:100%;
    height:300px;
    object-fit:cover;
    transition:0.3s;
}

.gallery-grid img:hover{
    transform:scale(1.03);
}

/* FOOTER */

footer{
    padding:50px 8%;
    text-align:center;
    border-top:1px solid #222;
}

footer h2{
    font-family:'Anton',sans-serif;
    margin-bottom:20px;
    letter-spacing:3px;
}

footer p{
    color:#888;
}

/* MOBILE */

@media(max-width:1000px){

    .cards,
    .products{
        grid-template-columns:1fr;
    }

    .gallery-grid{
        grid-template-columns:1fr 1fr;
    }

    .hero h1{
        font-size:4rem;
    }
}

@media(max-width:600px){

    nav{
        flex-direction:column;
        gap:15px;
    }

    .nav-links{
        gap:15px;
        flex-wrap:wrap;
        justify-content:center;
    }

    .hero h1{
        font-size:3rem;
    }

    .gallery-grid{
        grid-template-columns:1fr;
    }
}

</style>
</head>
<body>

<!-- NAVBAR -->

<nav>
    <div class="logo">Menace 2 Society</div>

    <div class="nav-links">
        <a href="#">Home</a>
        <a href="#">Shop</a>
        <a href="#">Gallery</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
    </div>
</nav>

<!-- HERO -->

<section class="hero">

    <div class="hero-content">
        <h1>
            MOST WANTED<br>
            MOST HATED<br>
            MOST FEARED
        </h1>

        <p>
            STREETWEAR FOR THE MISUNDERSTOOD
        </p>

        <div class="hero-btns">
            <a href="#">Shop Now</a>
            <a href="#">View Lookbook</a>
        </div>
    </div>

</section>

<!-- THEMES -->

<section class="triple-section">

    <h1 class="section-title">THE MINDSET</h1>

    <div class="cards">

        <div class="card">
            <h2>Most Wanted</h2>
            <p>
                Chased by attention. Desired by the culture.
                Every drop becomes a statement piece.
            </p>
        </div>

        <div class="card">
            <h2>Most Hated</h2>
            <p>
                Built for outsiders. Made for rebellion.
                Designed to disrupt every room you walk into.
            </p>
        </div>

        <div class="card">
            <h2>Most Feared</h2>
            <p>
                Fearless expression through fashion.
                Darkness, chaos, energy, and ambition combined.
            </p>
        </div>

    </div>

</section>

<!-- SHOP -->

<section class="shop">

    <h1 class="section-title">LATEST DROPS</h1>

    <div class="products">

        <div class="product">
            <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=1200&auto=format&fit=crop">
            <h3>Distressed Graphic Tee</h3>
            <p>$55</p>
        </div>

        <div class="product">
            <img src="https://images.unsplash.com/photo-1503341504253-dff4815485f1?q=80&w=1200&auto=format&fit=crop">
            <h3>Chaos Denim</h3>
            <p>$120</p>
        </div>

        <div class="product">
            <img src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?q=80&w=1200&auto=format&fit=crop">
            <h3>Fear Me Hoodie</h3>
            <p>$95</p>
        </div>

    </div>

</section>

<!-- LOOKBOOK -->

<section class="gallery">

    <h1 class="section-title">LOOKBOOK</h1>

    <div class="gallery-grid">

        <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1200&auto=format&fit=crop">

        <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=1200&auto=format&fit=crop">

        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1200&auto=format&fit=crop">

        <img src="https://images.unsplash.com/photo-1504593811423-6dd665756598?q=80&w=1200&auto=format&fit=crop">

    </div>

</section>

<!-- FOOTER -->

<footer>

    <h2>MENACE 2 SOCIETY</h2>

    <p>
        © 2026 All Rights Reserved.
    </p>

</footer>

</body>
</html>
